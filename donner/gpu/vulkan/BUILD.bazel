load("//build_defs:rules.bzl", "donner_cc_library")
load("//build_defs:visibility.bzl", "donner_internal_visibility")
load("//build_defs:package.bzl", "donner_package")

# donner::gpu::vulkan - the Vulkan backend of the Donner GPU runtime.
#
# Scope: host-visible buffers, device-local textures with staged uploads,
# SPIR-V shader modules, render pipelines, render pass replay, compute
# pipelines and compute passes, and texture-to-buffer readback. Compiles on
# every platform against the hermetic Vulkan-Headers module and links
# everywhere: the Vulkan loader is opened at runtime rather than linked, so a
# build needs no Vulkan library present and a machine without one reports it
# at device creation. Execution is gated to Linux in tests/BUILD.bazel.

donner_cc_library(
    name = "vulkan_device",
    srcs = [
        "VulkanDevice.cc",
        "VulkanLoader.cc",
    ],
    hdrs = [
        "VulkanDevice.h",
        "VulkanLoader.h",
    ],
    # The loader library is opened with dlopen at runtime; libdl provides that on the platforms
    # this backend executes on. There is no Vulkan library on the link line by design.
    linkopts = select({
        "@platforms//os:linux": ["-ldl"],
        "//conditions:default": [],
    }),
    visibility = donner_internal_visibility(),
    deps = [
        "//donner/base",
        "//donner/gpu",
        "@vulkan_headers",
    ],
)

donner_package()
