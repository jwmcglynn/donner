# The Vulkan presentation slice: a headless surface and its swapchain driven through the runtime's
# surface hooks. Headless because presentation is the part of the runtime a machine with no display
# cannot otherwise exercise, and the part whose synchronization is easiest to get wrong; a loader
# without VK_EXT_headless_surface skips, naming it.
donner_cc_test(
    name = "vulkan_surface_tests",
    srcs = ["VulkanSurface_tests.cc"],
    env = {
        "DONNER_REQUIRE_VULKAN": "1",
