# The Vulkan solid-fill vertical slice renders the shared baseline scene
# through donner::gpu + the emitted SPIR-V and compares it against an
# in-process render of the identical scene through the production wgpu path
# (the frozen-baseline pattern executed per-device, valid on software Vulkan
# and physical GPUs alike). Opaque texels must match exactly; partially
# covered ones may differ by one least-significant bit, which is the two
# pipelines quantizing float results to 8-bit unorm independently.
#
# Linux-only: this is the one platform where both halves execute (the Vulkan
# loader on the RHI side, wgpu-native's Vulkan backend on the production
# side). The wgpu half needs the geode configuration, so the test is wrapped
# in the same donner_multi_transitioned_test mechanism as the geode-lane
# renderer suites - reachable from plain `bazel test //...` without
# --config=geode. On macOS the impl target is incompatible and the wrapper is
# skipped.
# The resource-state model is pure state machinery over Vulkan enums: it opens no device and
# calls no entry point, so unlike every other test here it runs on every platform rather than
# only where a Vulkan loader exists.
donner_cc_test(
    name = "vulkan_resource_state_tests",
    srcs = ["VulkanResourceState_tests.cc"],
    deps = [
        "//donner/gpu/vulkan:vulkan_resource_state",
        "@com_google_gtest//:gtest_main",
    ],
)

# Device-level regressions for the resource-state wiring: what the backend emits and what it
# leaves in the tracker when work fails. Needs a real device, so Linux only.
donner_cc_test(
    name = "vulkan_resource_state_device_tests",
    srcs = ["VulkanResourceStateDevice_tests.cc"],
    env = {
        "DONNER_REQUIRE_VULKAN": "1",
        "XDG_RUNTIME_DIR": "/tmp",
    },
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        "//donner/gpu",
        "//donner/gpu/vulkan:vulkan_device",
        "//donner/gpu/vulkan:vulkan_resource_state",
        "@com_google_gtest//:gtest_main",
    ],
)

donner_cc_test(
    name = "vulkan_solid_fill_tests_impl",
    srcs = ["VulkanSolidFill_tests.cc"],
    # A missing Vulkan driver must be a red test in CI, never a silent skip:
    # the target is linux-only and the CI lanes install a software Vulkan
    # implementation, so VulkanDevice::Create() must succeed there. The
    # transition wrapper forwards this env (RunEnvironmentInfo).
    #
    # Pin the software Vulkan implementation for both halves of the comparison.
    # Nothing in the lane configuration selects a driver, so on a host with a
    # discrete GPU each half would otherwise pick up that hardware driver, whose
    # rasterisation differs from the software one in far more partially covered
    # texels. Pinning here makes the test hermetic against whatever driver the
    # execution host happens to expose, on any lane and locally alike.
    env = {
        "DONNER_REQUIRE_VULKAN": "1",
        "VK_ICD_FILENAMES": "/usr/share/vulkan/icd.d/lvp_icd.json",
        "XDG_RUNTIME_DIR": "/tmp",
    },
    target_compatible_with = ["@platforms//os:linux"] + select({
        "//donner/svg/renderer/geode:geode_enabled": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//donner/base",
        "//donner/base:gtest_timeout_main",
        "//donner/editor/tests:bitmap_golden_compare",
        "//donner/gpu",
        "//donner/gpu:baseline_scene",
        "//donner/gpu:checkerboard_pixel_tests",
        "//donner/gpu:submission_order_scene",
        "//donner/gpu:vertex_input_slice",
        "//donner/gpu/shader",
        "//donner/gpu/shader:checkerboard_test_artifact",
        "//donner/gpu/shader:module_interface",
        "//donner/gpu/shader:programs",
        "//donner/gpu/shader:spirv_emitter",
        "//donner/gpu/vulkan:vulkan_device",
        "//donner/svg/renderer:renderer_image_io",
        "//donner/svg/renderer/geode:geo_encoder",
        "//donner/svg/renderer/geode:geode_device",
        "//donner/svg/renderer/geode:geode_path_encoder",
        "//donner/svg/renderer/geode:geode_test_contexts",
        "//donner/svg/renderer/geode:geode_wgpu_util",
        "//third_party/webgpu-cpp:webgpu_cpp",
    ],
)

# Transition wrapper: flips renderer_backend=geode + enable_geode=true so this
# target is reachable from `bazel test //...` without --config=geode.
#
# Deliberately carries no executor-routing properties. The impl target pins the
# software Vulkan implementation, so this test renders the same result on
# whatever executor a lane provides and gains nothing from being steered to a
# particular one. A scheduling property naming a worker class the execution pool
# does not offer is also not an error: the action is queued until such a worker
# appears, which never happens. A lane then finishes every other test and sits
# on this single one until the job's own timeout hours later, with no failing
# action to point at.
donner_multi_transitioned_test(
    name = "vulkan_solid_fill_tests",
    # Software Vulkan (lavapipe) rendering is slow in fastbuild; cap explicitly
    # at 900 s so a driver hang gets killed in 15 min instead of rolling up to
    # the default 3600 s.
    size = "large",
    timeout = "long",
    testonly = 1,
    dep = ":vulkan_solid_fill_tests_impl",
    renderer_backend = "geode",
)

# The Vulkan compute vertical slice: dispatches the color-matrix kernel
# emitted from the shader IR and compares the destination texels against the
# host result. Unlike the solid-fill slice this half needs no wgpu comparison,
# so it is a plain Linux-gated test with no geode transition. A missing driver
# is a red test wherever DONNER_REQUIRE_VULKAN=1 is set.
#
# No driver is pinned here, deliberately. The solid-fill slice pins the
# software implementation because it compares two GPU pipelines against each
# other and needs both halves on one rasterizer. This slice compares against a
# result computed on the host, and its scene is chosen so every value is exact
# in 8-bit unorm, so there is no cross-driver quantization freedom to control
# for - running on whatever driver the host exposes covers the real hardware
# path a pinned software driver never would.
donner_cc_test(
    name = "vulkan_color_matrix_tests",
    # 174 cases across three suites, 65 s of test time measured on a software-rasterizer
    # lane, so the implicit "small" this used to take is wrong by construction: that
    # budget is 60 s. Nothing here is individually slow - the slowest case is 2.4 s and
    # the median is 0.2 s - the suite is simply large, so the declaration is what changes
    # rather than the tests. Medium's 300 s is better than four times the measured time
    # while still killing a driver hang in five minutes.
    size = "medium",
    srcs = ["VulkanColorMatrix_tests.cc"],
    env = {
        "DONNER_REQUIRE_VULKAN": "1",
        "XDG_RUNTIME_DIR": "/tmp",
