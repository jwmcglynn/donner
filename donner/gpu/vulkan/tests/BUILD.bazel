# Holds the device queue busy from the test side. Submissions retire in microseconds on a
# software rasterizer, so a test that needs a resource to still be in flight cannot get there by
# submitting work and racing it; this waits on a timeline semaphore the test owns.
donner_cc_library(
    name = "native_queue_gate",
    testonly = 1,
    hdrs = ["NativeQueueGate.h"],
    target_compatible_with = ["@platforms//os:linux"],
    visibility = donner_internal_visibility(),
    deps = [
        "//donner/gpu/vulkan:vulkan_device",
        "@com_google_gtest//:gtest",
    ],
)

