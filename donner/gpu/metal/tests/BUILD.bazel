load("//build_defs:rules.bzl", "donner_cc_binary", "donner_cc_test", "donner_multi_transitioned_binary")
load("//build_defs:package.bzl", "donner_package")

# Tests and tooling for the Metal vertical slices: the shared frozen-baseline
# scene, the geode-gated black-box capture tool that produced the committed
# baseline PNG, the Metal solid-fill pixel-comparison test, and the Metal
# color-matrix compute test.

# Black-box baseline capture: renders the shared scene through the current
# production renderer and writes the PNG committed under testdata/. The
# rendering itself comes from the frozen-baseline capture library, so this tool
# and the frozen corpus cannot drift apart. Geode-gated because it links the
# wgpu backend; it works on any platform with a WebGPU-capable device, not just
# macOS. See testdata/README.md for the capture command.
donner_cc_binary(
    name = "baseline_capture_tool_impl",
    testonly = 1,
    srcs = ["BaselineCaptureTool.cc"],
    target_compatible_with = select({
        "//donner/svg/renderer/geode:geode_enabled": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = ["//visibility:private"],
    deps = [
        "//donner/gpu/baseline:wgpu_baseline_capture",
        "//donner/svg/renderer:renderer_image_io",
    ],
)

# Transition wrapper so the capture command needs no --config=geode.
donner_multi_transitioned_binary(
    name = "baseline_capture_tool",
    testonly = 1,
    dep = ":baseline_capture_tool_impl",
    renderer_backend = "geode",
)

# The Metal solid-fill vertical slice: donner::gpu + emitted MSL only (no
# wgpu-based dependencies, not geode-gated). Metal API validation is enabled
# so validation issues abort loudly.
donner_cc_test(
    name = "metal_solid_fill_tests",
    srcs = ["MetalSolidFill_tests.cc"],
    data = ["testdata/solid_fill_baseline.png"],
    env = {
        "MTL_DEBUG_LAYER": "1",
        "MTL_SHADER_VALIDATION": "1",
    },
    # Bazel scrubs the test environment, so the automated-lane markers have to be named here or
    # the no-device rule can never see one and this slice keeps skipping into a green report.
    env_inherit = [
        "DONNER_BASELINE_REQUIRE_FROZEN_ADAPTER",
        "GITHUB_ACTIONS",
    ],
    target_compatible_with = ["@platforms//os:macos"],
    deps = [
        "//donner/editor/tests:bitmap_golden_compare",
        "//donner/gpu",
        "//donner/gpu:baseline_scene",
        "//donner/gpu/baseline:frozen_baseline_policy",
        "//donner/gpu/metal:metal_device",
        "//donner/gpu/shader",
        "//donner/gpu/shader:module_interface",
        "//donner/gpu/shader:programs",
        "//donner/svg/renderer/geode:geode_path_encoder",
        "@com_google_gtest//:gtest_main",
    ],
)

# The Metal compute vertical slice: the color-matrix kernel emitted from the
# shader IR, dispatched through donner::gpu and compared against the host
# result. Metal API validation is enabled so validation issues abort loudly.
donner_cc_test(
    name = "metal_color_matrix_tests",
    srcs = ["MetalColorMatrix_tests.cc"],
    env = {
        "MTL_DEBUG_LAYER": "1",
        "MTL_SHADER_VALIDATION": "1",
    },
    target_compatible_with = ["@platforms//os:macos"],
    deps = [
        "//donner/gpu",
        "//donner/gpu:color_matrix_slice",
        "//donner/gpu/metal:metal_device",
        "//donner/gpu/shader",
        "//donner/gpu/shader:module_interface",
        "//donner/gpu/shader:programs",
        "@com_google_gtest//:gtest_main",
    ],
)

# The Metal texture-to-texture copy slice: a sub-rectangle copy between two
# origins, executed and compared against the shared expected image. Metal API
# validation is enabled so validation issues abort loudly.
donner_cc_test(
    name = "metal_sub_rectangle_copy_tests",
    srcs = ["MetalSubRectangleCopy_tests.cc"],
    env = {
        "MTL_DEBUG_LAYER": "1",
        "MTL_SHADER_VALIDATION": "1",
    },
    target_compatible_with = ["@platforms//os:macos"],
    deps = [
        "//donner/gpu",
        "//donner/gpu:sub_rectangle_copy_scene",
        "//donner/gpu/metal:metal_device",
        "@com_google_gtest//:gtest_main",
    ],
)

donner_package()
