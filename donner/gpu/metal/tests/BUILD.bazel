objc_library(
    name = "metal_native_compute_validation_impl",
    testonly = True,
    srcs = ["MetalNativeComputeValidation_tests.mm"],
    sdk_frameworks = [
        "Foundation",
        "Metal",
    ],
    alwayslink = True,
    target_compatible_with = ["@platforms//os:macos"],
    deps = ["@com_google_gtest//:gtest"],
)

# Each native control runs in its own process so a validation abort preserves the others.
cc_test(
    name = "metal_native_compute_validation_tests",
    size = "small",
    env = {
        "DONNER_METAL_CONTROL_EXPECT_SHADER_VALIDATION": "1",
        "DONNER_METAL_CONTROL_EXPECT_TEXTURE_USAGE": "1",
        "MTL_DEBUG_LAYER": "1",
        "MTL_SHADER_VALIDATION": "1",
        "MTL_SHADER_VALIDATION_ABORT_ON_FAULT": "1",
        "MTL_SHADER_VALIDATION_ENABLE_ERROR_REPORTING": "1",
        "MTL_SHADER_VALIDATION_GLOBAL_MEMORY": "1",
        "MTL_SHADER_VALIDATION_REPORT_TO_STDERR": "1",
        "MTL_SHADER_VALIDATION_TEXTURE_USAGE": "1",
        "MTL_SHADER_VALIDATION_THREADGROUP_MEMORY": "1",
    },
    shard_count = 9,
    target_compatible_with = ["@platforms//os:macos"],
    deps = [
        ":metal_native_compute_validation_impl",
        "@com_google_gtest//:gtest_main",
    ],
)

# Paired native compute control with API validation and uninstrumented shader execution.
cc_test(
    name = "metal_native_compute_api_only_tests",
    size = "small",
    args = ["--gtest_filter=StorageAndFactories/MetalNativeComputeValidationTest.ConstantColorWriteAtTextureSlotOne/Shared_Function"],
    env = {
        "DONNER_METAL_CONTROL_EXPECT_SHADER_VALIDATION": "0",
        "DONNER_METAL_CONTROL_EXPECT_TEXTURE_USAGE": "1",
        "MTL_DEBUG_LAYER": "1",
        "MTL_SHADER_VALIDATION": "0",
        "MTL_SHADER_VALIDATION_ABORT_ON_FAULT": "1",
        "MTL_SHADER_VALIDATION_ENABLE_ERROR_REPORTING": "1",
        "MTL_SHADER_VALIDATION_GLOBAL_MEMORY": "1",
