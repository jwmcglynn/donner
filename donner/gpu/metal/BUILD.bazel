load("//build_defs:visibility.bzl", "donner_internal_visibility")

# donner::gpu::metal - the Metal backend of the Donner GPU runtime (design doc
# 0053, change sequence packet 6).
#
# Minimal vertical slice: shared-storage resources, MSL shader modules, the
# solid-fill render pipeline family, render pass replay, and texture-to-buffer
# readback. macOS-only; Objective-C++ compiled with ARC (objc_library `srcs`
# default). The header is pure C++ behind a pimpl so C++ tests can include it.

objc_library(
    name = "metal_device",
    srcs = ["MetalDevice.mm"],
    hdrs = ["MetalDevice.h"],
    sdk_frameworks = [
        "Foundation",
        "Metal",
    ],
    target_compatible_with = select({
        "@platforms//os:macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = donner_internal_visibility(),
    deps = [
        "//donner/base",
        "//donner/gpu",
        "//donner/gpu/shader",
    ],
)

# Source inputs for the GPU inventory ratchet (//tools/gpu_inventory). The
# manifests are derived from a lexical scan of these files, so they must be
# declared as real Bazel inputs for the check to be a cacheable test with
# correct change detection. See tools/gpu_inventory/README.md.
filegroup(
    name = "gpu_inventory_srcs",
    srcs = glob(
        [
            "**/*.h",
            "**/*.cc",
            "**/*.mm",
            "**/*.wgsl",
            "**/*.patch",
            "**/*.bzl",
            "BUILD.bazel",
        ],
        allow_empty = True,
    ),
    visibility = ["//tools/gpu_inventory:__pkg__"],
)
