# donner::gpu - the Donner-owned GPU runtime.
#
# What the runtime guarantees: typed immutable descriptors, explicit Result/Status errors,
# move-only RAII generation-checked handles, deferred destruction by submission serial,
# submit-time re-validation of recorded commands, fail-closed validation shared by every
# backend, and a deterministic recording backend. Production rendering stays on the existing
# Geode path until each family is migrated.

donner_cc_library(
    name = "descriptors",
    srcs = ["Descriptors.cc"],
    hdrs = [
        "Descriptors.h",
        "Handles.h",
    ],
    visibility = donner_internal_visibility(),
    deps = ["//donner/base"],
)

# The validation limits alone, without the device or its descriptors, so the compile-time shader
# compiler can reject a module this runtime would refuse without pulling the runtime into the
# translation unit of every shader artifact.
donner_cc_library(
    name = "gpu_limits",
    hdrs = ["GpuLimits.h"],
    visibility = donner_internal_visibility(),
)

# The sticky device-loss condition of one backend root, without the device, its descriptors or
# its handles: atomics and chrono only. A bounded wait loop publishes a loss through this, and
# the header says so, which is only true while this is a target of its own.
donner_cc_library(
    name = "device_lost",
    srcs = ["DeviceLost.cc"],
    hdrs = ["DeviceLost.h"],
    visibility = donner_internal_visibility(),
)

donner_cc_library(
    name = "gpu",
    srcs = [
        "BufferMappingTable.cc",
        "CommandEncoder.cc",
        "Device.cc",
        "GpuError.cc",
    ],
    hdrs = [
        "BufferMappingTable.h",
        "CheckedArithmetic.h",
        "CommandEncoder.h",
        "Commands.h",
        "Device.h",
        "GpuError.h",
        "GpuResult.h",
    ],
    visibility = donner_internal_visibility(),
    deps = [
        ":descriptors",
        ":device_lost",
        ":gpu_limits",
        "//donner/base",
    ],
)

