# Out-of-process MSL validation: compiles every emitted MSL program with the
# platform Metal compiler. The compiler is invoked at test time rather than
# depended on, so the emitter is held to a real Metal front end without putting
# one in the build graph. macOS-only. A developer machine without the offline
# compiler skips; an automated lane without it fails, so a lane that never had
# the toolchain cannot report the same green as one that compiled every module.
# `requires_metal_toolchain` is how a lane that knowingly lacks it opts out in
# the open, rather than by collecting silent skips.
donner_cc_test(
    name = "msl_xcrun_validation_tests",
    srcs = [
        "tests/MathPrimitiveCoverageModule.h",
        "tests/MslXcrunValidation_tests.cc",
        "tests/ReductionCoverageModule.h",
        "tests/ShaderTestUtils.h",
    ],
    # Bazel scrubs the test environment, so the automated-lane markers have to be named here or
    # the fail-closed rule can never see one and the gate quietly keeps skipping.
    env_inherit = [
        "DONNER_BASELINE_REQUIRE_FROZEN_ADAPTER",
        "GITHUB_ACTIONS",
    ],
    tags = ["requires_metal_toolchain"],
    target_compatible_with = ["@platforms//os:macos"],
    deps = [
        ":convolve_matrix_test_artifact",
        ":external_tool_gate",
        ":float_storage_test_module",
        ":gaussian_blur_test_artifact",
        ":msl_emitter",
        ":programs",
        ":shader",
        ":slug_mask_test_artifact",
        ":stage_io_test_modules",
        "//donner/gpu/shader/wgsl:graphics_test_artifact",
        "@com_google_gtest//:gtest_main",
    ],
)

# Out-of-process SPIR-V validation: every emitted module must pass
# `spirv-val --target-env vulkan1.1`, so the emitter is held to the
# specification's own rules by the reference validator rather than by a parser
# in this repository. Bazel builds that validator from source and hands it over
# in runfiles, so every lane runs the same one and none can be missing it.
donner_cc_test(
    name = "spirv_val_validation_tests",
    srcs = [
        "tests/MathPrimitiveCoverageModule.h",
        "tests/ReductionCoverageModule.h",
        "tests/ShaderTestUtils.h",
        "tests/SpirvValValidation_tests.cc",
    ],
    data = ["@spirv_tools//:spirv-val"],
    deps = [
        ":convolve_matrix_test_artifact",
        ":float_storage_test_module",
        ":gaussian_blur_test_artifact",
        ":programs",
        ":shader",
        ":slug_mask_test_artifact",
        ":spirv_emitter",
        ":stage_io_test_modules",
        "//donner/base:base_test_utils",
        "//donner/gpu/shader/wgsl:graphics_test_artifact",
        "@com_google_gtest//:gtest_main",
    ],
)

# Black-box validation fixture: creates a real pipeline from each emitted WGSL
# program through the renderer's own WebGPU device, so acceptance comes from the
# shader front end that ships rather than from a parser in this repository. Runs
# in the geode variant lane; incompatible otherwise.
donner_cc_test(
    name = "wgsl_emitter_geode_validation_tests_impl",
    srcs = [
        "tests/MathPrimitiveCoverageModule.h",
        "tests/ShaderTestUtils.h",
        "tests/WgslEmitterGeodeValidation_tests.cc",
    ],
    target_compatible_with = select({
        "//donner/svg/renderer/geode:geode_enabled": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":float_storage_test_module",
        ":gaussian_blur_api",
        ":gaussian_blur_artifact",
        ":programs",
        ":shader",
        ":wgsl_emitter",
        "//donner/base:gtest_timeout_main",
        "//donner/editor/tests:bitmap_golden_compare",
        "//donner/svg/renderer/geode:geode_device",
        "//donner/svg/renderer/geode:geode_gpu_wait",
        "//donner/svg/renderer/geode:geode_wgpu_util",
        "//third_party/webgpu-cpp:webgpu_cpp",
        "@tiny-skia-cpp//src/tiny_skia/filter",
    ],
)

donner_multi_transitioned_test(
    name = "wgsl_emitter_geode_validation_tests",
    timeout = "short",
    testonly = 1,
    dep = ":wgsl_emitter_geode_validation_tests_impl",
    opens_gpu_device = True,
    renderer_backend = "geode",
)

