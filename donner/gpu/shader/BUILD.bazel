# Out-of-process MSL validation: compiles every emitted MSL program with the
# platform Metal compiler. The compiler is invoked at test time rather than
# depended on, so the emitter is held to a real Metal front end without putting
# one in the build graph. macOS-only. A developer machine without the offline
# compiler skips; an automated lane without it fails, so a lane that never had
# the toolchain cannot report the same green as one that compiled every module.
# `requires_metal_toolchain` is how a lane that knowingly lacks it opts out in
# the open, rather than by collecting silent skips.
donner_cc_test(
    name = "msl_xcrun_validation_tests",
    srcs = [
        "tests/MathPrimitiveCoverageModule.h",
        "tests/MslXcrunValidation_tests.cc",
        "tests/ReductionCoverageModule.h",
        "tests/ShaderTestUtils.h",
    ],
    # Bazel scrubs the test environment, so the automated-lane markers have to be named here or
    # the fail-closed rule can never see one and the gate quietly keeps skipping.
    env_inherit = [
        "DONNER_BASELINE_REQUIRE_FROZEN_ADAPTER",
        "GITHUB_ACTIONS",
    ],
    tags = ["requires_metal_toolchain"],
    target_compatible_with = ["@platforms//os:macos"],
    deps = [
        ":checkerboard_test_artifact",
        ":color_space_convert_test_artifact",
        ":component_transfer_test_artifact",
        ":composite_test_artifact",
        ":convolve_matrix_test_artifact",
        ":diffuse_lighting_test_artifact",
        ":displacement_map_test_artifact",
        ":drop_shadow_test_artifact",
        ":external_tool_gate",
        ":filter_blend_test_artifact",
        ":filter_color_matrix_test_artifact",
        ":filter_image_test_artifact",
        ":filter_resolve_test_artifact",
        ":float_storage_test_module",
        ":flood_test_artifact",
        ":gaussian_blur_test_artifact",
        ":image_blit_test_artifact",
        ":merge_test_artifact",
        ":morphology_test_artifact",
        ":msl_emitter",
        ":offset_test_artifact",
        ":programs",
        ":shader",
        ":slug_fill_test_artifact",
        ":slug_gradient_test_artifact",
        ":slug_mask_test_artifact",
        ":snapshot_unpremultiply_test_artifact",
        ":specular_lighting_test_artifact",
        ":stage_io_test_modules",
