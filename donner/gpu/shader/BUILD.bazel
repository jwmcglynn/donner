load("//build_defs:rules.bzl", "donner_cc_library", "donner_cc_test", "donner_multi_transitioned_test")
load("//build_defs:visibility.bzl", "donner_internal_visibility")
load("//build_defs:package.bzl", "donner_package")

# The typed shader IR and each emitter have independent compilation dependencies.
#
# A typed immutable IR with a validating builder, host-shareable layout
# computation per the WGSL specification's memory layout rules, deterministic
# text serialization, and three emitters that consume the same binding and
# layout metadata.

donner_cc_library(
    name = "shader",
    srcs = [
        "IrExpr.cc",
        "IrLayout.cc",
        "IrModule.cc",
        "IrSerialization.cc",
        "IrType.cc",
    ],
    hdrs = [
        "IrExpr.h",
        "IrLayout.h",
        "IrModule.h",
        "IrStatement.h",
        "IrType.h",
        "ShaderError.h",
        "ShaderResult.h",
    ],
    visibility = donner_internal_visibility(),
    deps = [
        "//donner/base",
    ],
)

# Backend binding constants do not require the shader IR or any emitter.
donner_cc_library(
    name = "msl_binding_map",
    hdrs = ["MslBindingMap.h"],
    visibility = donner_internal_visibility(),
)

donner_cc_library(
    name = "msl_emitter",
    srcs = ["MslEmitter.cc"],
    hdrs = ["MslEmitter.h"],
    visibility = donner_internal_visibility(),
    deps = [
        ":msl_binding_map",
        ":shader",
        "//donner/base",
    ],
)

donner_cc_library(
    name = "spirv_emitter",
    srcs = ["SpirvEmitter.cc"],
    hdrs = ["SpirvEmitter.h"],
    visibility = donner_internal_visibility(),
    deps = [
        ":shader",
        "//donner/base",
    ],
)

donner_cc_library(
    name = "wgsl_emitter",
    srcs = ["WgslEmitter.cc"],
    hdrs = ["WgslEmitter.h"],
    visibility = donner_internal_visibility(),
    deps = [
        ":shader",
        "//donner/base",
    ],
)

# Bridges a built IR module to the descriptors the GPU runtime consumes, so a host never
# transcribes a compute entry point's workgroup size by hand. Split from :shader so the IR core
# stays free of the runtime's descriptor types.
donner_cc_library(
    name = "module_interface",
    srcs = ["ModuleInterface.cc"],
    hdrs = ["ModuleInterface.h"],
    visibility = donner_internal_visibility(),
    deps = [
        ":shader",
        "//donner/gpu",
    ],
)

# Complete shader programs expressed in the IR: the solid-fill render family
# (whose frozen pixel baseline is rendered by the Donner-owned slug_fill.wgsl
# it re-expresses) and the color-matrix compute program.
# Stage IO shapes the emitters must handle but no shipped program has. A library rather than a
# plain header in each test's srcs, because the Metal slice in another package is held to the same
# shapes through its device's runtime compiler.
donner_cc_library(
    name = "stage_io_test_modules",
    testonly = 1,
    hdrs = ["tests/StageIoTestModules.h"],
    visibility = donner_internal_visibility(),
    deps = [":shader"],
)

# The bind group indices alone, with no dependency on the IR: a host creating a pipeline from
# build-time emitted WGSL needs them and must not link the emitters to get them.
donner_cc_library(
    name = "program_bindings",
    hdrs = [
        "programs/FilterColorMatrixBindings.h",
        "programs/FloodBindings.h",
        "programs/SnapshotUnpremultiplyBindings.h",
        "programs/SubregionClipBindings.h",
    ],
    visibility = ["//visibility:public"],
)

donner_cc_library(
    name = "programs",
    srcs = [
        "programs/ColorMatrix.cc",
        "programs/FilterColorMatrix.cc",
        "programs/Flood.cc",
        "programs/RoundHalfAwayFromZero.cc",
        "programs/SnapshotUnpremultiply.cc",
        "programs/SolidFill.cc",
        "programs/SubregionClip.cc",
    ],
    hdrs = [
        "programs/ColorMatrix.h",
        "programs/ErrorLatch.h",
        "programs/FilterColorMatrix.h",
        "programs/Flood.h",
        "programs/RoundHalfAwayFromZero.h",
        "programs/SnapshotUnpremultiply.h",
        "programs/SolidFill.h",
        "programs/SubregionClip.h",
    ],
    visibility = donner_internal_visibility(),
    deps = [
        ":program_bindings",
        ":shader",
        "//donner/base",
    ],
)

