# The typed shader IR and each emitter have independent compilation dependencies.
#
# A typed immutable IR with a validating builder, host-shareable layout
# computation per the WGSL specification's memory layout rules, deterministic
# text serialization, and three emitters that consume the same binding and
# layout metadata.
#
# The IR, its three emitters, its descriptor bridge and the programs still
# expressed in it are all test fixtures; every shipped shader is compiled from
# WGSL source instead. `testonly = 1` holds that by construction rather than by
# review, so a production target cannot pick the IR back up silently.

donner_cc_library(
    name = "shader",
    testonly = 1,
    srcs = [
        "IrExpr.cc",
        "IrLayout.cc",
        "IrModule.cc",
        "IrSerialization.cc",
        "IrType.cc",
    ],
    hdrs = [
        "IrExpr.h",
        "IrLayout.h",
        "IrModule.h",
        "IrStatement.h",
        "IrType.h",
        "ShaderError.h",
        "ShaderResult.h",
    ],
    visibility = donner_internal_visibility(),
    deps = [
        "//donner/base",
        "//donner/gpu:gpu_limits",
    ],
)

