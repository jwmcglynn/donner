load("//build_defs:rules.bzl", "donner_cc_library", "donner_cc_test", "donner_multi_transitioned_test")
load("//build_defs:visibility.bzl", "donner_internal_visibility")
load("//build_defs:package.bzl", "donner_package")

# donner::gpu::shader - the typed shader IR core, its WGSL-rule layout engine,
# and the WGSL/MSL/SPIR-V emitters.
#
# A typed immutable IR with a validating builder, host-shareable layout
# computation per the WGSL specification's memory layout rules, deterministic
# text serialization, and three emitters that consume the same binding and
# layout metadata.

donner_cc_library(
    name = "shader",
    srcs = [
        "IrExpr.cc",
        "IrLayout.cc",
        "IrModule.cc",
        "IrSerialization.cc",
        "IrType.cc",
        "MslEmitter.cc",
        "SpirvEmitter.cc",
        "WgslEmitter.cc",
    ],
    hdrs = [
        "IrExpr.h",
        "IrLayout.h",
        "IrModule.h",
        "IrStatement.h",
        "IrType.h",
        "MslBindingMap.h",
        "MslEmitter.h",
        "ShaderError.h",
        "ShaderResult.h",
        "SpirvEmitter.h",
        "WgslEmitter.h",
    ],
    visibility = donner_internal_visibility(),
    deps = [
        "//donner/base",
    ],
)

# Bridges a built IR module to the descriptors the GPU runtime consumes, so a host never
# transcribes a compute entry point's workgroup size by hand. Split from :shader so the IR core
# stays free of the runtime's descriptor types.
donner_cc_library(
    name = "module_interface",
    srcs = ["ModuleInterface.cc"],
    hdrs = ["ModuleInterface.h"],
    visibility = donner_internal_visibility(),
    deps = [
        ":shader",
        "//donner/gpu",
    ],
)

# Complete shader programs expressed in the IR: the solid-fill render family
# (whose frozen pixel baseline is rendered by the Donner-owned slug_fill.wgsl
# it re-expresses) and the color-matrix compute program.
# Stage IO shapes the emitters must handle but no shipped program has. A library rather than a
# plain header in each test's srcs, because the Metal slice in another package is held to the same
# shapes through its device's runtime compiler.
donner_cc_library(
    name = "stage_io_test_modules",
    testonly = 1,
    hdrs = ["tests/StageIoTestModules.h"],
    visibility = donner_internal_visibility(),
    deps = [":shader"],
)

# The bind group indices alone, with no dependency on the IR: a host creating a pipeline from
# build-time emitted WGSL needs them and must not link the emitters to get them.
donner_cc_library(
    name = "program_bindings",
    hdrs = [
        "programs/FilterColorMatrixBindings.h",
        "programs/FloodBindings.h",
        "programs/SnapshotUnpremultiplyBindings.h",
        "programs/SubregionClipBindings.h",
    ],
    visibility = ["//visibility:public"],
)

donner_cc_library(
    name = "programs",
    srcs = [
        "programs/ColorMatrix.cc",
        "programs/FilterColorMatrix.cc",
        "programs/Flood.cc",
        "programs/SnapshotUnpremultiply.cc",
        "programs/SolidFill.cc",
        "programs/SubregionClip.cc",
    ],
    hdrs = [
        "programs/ColorMatrix.h",
        "programs/ErrorLatch.h",
        "programs/FilterColorMatrix.h",
        "programs/Flood.h",
        "programs/SnapshotUnpremultiply.h",
        "programs/SolidFill.h",
        "programs/SubregionClip.h",
    ],
    visibility = donner_internal_visibility(),
    deps = [
        ":program_bindings",
        ":shader",
        "//donner/base",
    ],
)

donner_cc_test(
    name = "shader_tests",
    srcs = [
        "tests/ColorMatrixProgram_tests.cc",
        "tests/FilterColorMatrixProgram_tests.cc",
        "tests/FloodProgram_tests.cc",
        "tests/IrBuilder_tests.cc",
        "tests/IrLayout_tests.cc",
        "tests/IrSerialization_tests.cc",
        "tests/MslEmitter_tests.cc",
        "tests/ReductionCoverageModule.h",
        "tests/ShaderGoldenUtils.h",
        "tests/ShaderTestUtils.h",
        "tests/SnapshotUnpremultiplyProgram_tests.cc",
        "tests/SolidFillProgram_tests.cc",
        "tests/SpirvEmitter_tests.cc",
        "tests/SubregionClipProgram_tests.cc",
        "tests/WgslEmitter_tests.cc",
    ],
    data = [
        "tests/testdata/color_matrix.msl",
        "tests/testdata/color_matrix.spv",
        "tests/testdata/color_matrix.wgsl",
        "tests/testdata/filter_color_matrix.msl",
        "tests/testdata/filter_color_matrix.spv",
        "tests/testdata/filter_color_matrix.wgsl",
        "tests/testdata/flood.msl",
        "tests/testdata/flood.spv",
        "tests/testdata/flood.wgsl",
        "tests/testdata/snapshot_unpremultiply.msl",
        "tests/testdata/snapshot_unpremultiply.spv",
        "tests/testdata/snapshot_unpremultiply.wgsl",
        "tests/testdata/solid_fill.msl",
        "tests/testdata/solid_fill.spv",
        "tests/testdata/solid_fill.wgsl",
        "tests/testdata/subregion_clip.msl",
        "tests/testdata/subregion_clip.spv",
        "tests/testdata/subregion_clip.wgsl",
    ],
    deps = [
        ":programs",
        ":shader",
        ":stage_io_test_modules",
        "//donner/base:base_test_utils",
        "@com_google_gtest//:gtest_main",
        "@rules_cc//cc/runfiles",
    ],
)

# Out-of-process MSL validation: compiles every emitted MSL program with the
# platform Metal compiler. The compiler is invoked at test time rather than
# depended on, so the emitter is held to a real Metal front end without putting
# one in the build graph. macOS-only; skips cleanly when xcrun or the Metal
# toolchain is unavailable.
donner_cc_test(
    name = "msl_xcrun_validation_tests",
    srcs = [
        "tests/MslXcrunValidation_tests.cc",
        "tests/ReductionCoverageModule.h",
        "tests/ShaderTestUtils.h",
    ],
    target_compatible_with = ["@platforms//os:macos"],
    deps = [
        ":programs",
        ":shader",
        ":stage_io_test_modules",
        "@com_google_gtest//:gtest_main",
    ],
)

# Out-of-process SPIR-V validation: every emitted module must pass
# `spirv-val --target-env vulkan1.1`. The validator is invoked at test time
# rather than depended on, so the emitter is held to the specification's own
# rules without putting a validator in the build graph. Skips cleanly when
# spirv-val is not installed.
donner_cc_test(
    name = "spirv_val_validation_tests",
    srcs = [
        "tests/ReductionCoverageModule.h",
        "tests/ShaderTestUtils.h",
        "tests/SpirvValValidation_tests.cc",
    ],
    deps = [
        ":programs",
        ":shader",
        ":stage_io_test_modules",
        "@com_google_gtest//:gtest_main",
    ],
)

# Black-box validation fixture: creates a real pipeline from each emitted WGSL
# program through the renderer's own WebGPU device, so acceptance comes from the
# shader front end that ships rather than from a parser in this repository. Runs
# in the geode variant lane; incompatible otherwise.
donner_cc_test(
    name = "wgsl_emitter_geode_validation_tests_impl",
    srcs = [
        "tests/ShaderTestUtils.h",
        "tests/WgslEmitterGeodeValidation_tests.cc",
    ],
    target_compatible_with = select({
        "//donner/svg/renderer/geode:geode_enabled": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":programs",
        ":shader",
        "//donner/base:gtest_timeout_main",
        "//donner/svg/renderer/geode:geode_device",
        "//donner/svg/renderer/geode:geode_wgpu_util",
        "//third_party/webgpu-cpp:webgpu_cpp",
    ],
)

donner_multi_transitioned_test(
    name = "wgsl_emitter_geode_validation_tests",
    timeout = "short",
    testonly = 1,
    dep = ":wgsl_emitter_geode_validation_tests_impl",
    opens_gpu_device = True,
    renderer_backend = "geode",
)

# The committed goldens, exposed so a consumer of a generated artifact can assert the two are the
# same bytes rather than asserting it in prose.
filegroup(
    name = "program_goldens",
    srcs = [
        "tests/testdata/filter_color_matrix.wgsl",
        "tests/testdata/flood.wgsl",
        "tests/testdata/snapshot_unpremultiply.wgsl",
        "tests/testdata/subregion_clip.wgsl",
    ],
    visibility = ["//donner/svg/renderer:__subpackages__"],
)

donner_package()
