          "$(location generated/CheckerboardShader.h) --descriptor-header",
    tools = ["//donner/gpu/shader/tools:emit_program_wgsl"],
)

donner_cc_library(
    name = "checkerboard_artifact",
    hdrs = ["generated/CheckerboardShader.h"],
    visibility = donner_internal_visibility(),
    deps = ["//donner/gpu:descriptors"],
)

