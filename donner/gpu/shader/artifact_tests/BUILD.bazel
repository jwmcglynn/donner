load("@rules_python//python:defs.bzl", "py_test")
load("//build_defs:package.bzl", "donner_package")
load("//build_defs:rules.bzl", "donner_cc_binary")

_NATIVE = select({
    "@platforms//os:macos": [],
    "@platforms//os:linux": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

_FORMAT = select({
    "@platforms//os:macos": ["--format=macho"],
    "//conditions:default": ["--format=elf"],
})

_NATIVE_FLAGS = select({
    "@platforms//os:macos": ["--msl"],
    "//conditions:default": ["--spirv"],
})

donner_cc_binary(
    name = "gaussian_wgsl_probe",
    testonly = 1,
    srcs = ["GaussianBlurWgslProbe.cc"],
    target_compatible_with = _NATIVE,
    deps = [
        "//donner/gpu/shader:gaussian_blur_api",
        "//donner/gpu/shader:gaussian_blur_artifact",
    ],
)

py_test(
    name = "gaussian_wgsl_isolation_tests",
    srcs = ["inspect_projection_binary.py"],
    args = [
        "--family=gaussian",
        "--binary=$(rootpath :gaussian_wgsl_probe)",
    ] + _FORMAT + ["--wgsl"],
    data = [":gaussian_wgsl_probe"],
    main = "inspect_projection_binary.py",
    target_compatible_with = _NATIVE,
)

