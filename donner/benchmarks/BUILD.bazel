"""Donner-level benchmarks comparing performance across backends."""

load("@rules_shell//shell:sh_test.bzl", "sh_test")
load(
    "//build_defs:rules.bzl",
    "donner_cc_binary",
    "donner_cc_library",
    "donner_cc_test",
    "donner_perf_cc_test",
)

package(default_visibility = ["//visibility:public"])

donner_cc_binary(
    name = "tinyskia_render_perf_bench",
    srcs = ["TinySkiaRenderPerfBench.cpp"],
    deps = [
        "@google_benchmark//:benchmark_main",
        "@tiny-skia-cpp//src:tiny_skia_lib",
    ],
)

donner_cc_binary(
    name = "css_parse_perf_bench",
    srcs = ["CssParsePerfBench.cpp"],
    deps = [
        ":css_parser_bench_inputs",
        "//donner/base",
        "//donner/css",
        "@google_benchmark//:benchmark_main",
    ],
)

donner_cc_binary(
    name = "css_parse_allocation_bench",
    srcs = [
        "CssParseAllocationBench.cpp",
        "//donner/svg/renderer/benchmarks:AllocationTracker.h",
    ],
    deps = [
        ":css_parser_bench_inputs",
        "//donner/base",
        "//donner/css",
        "@google_benchmark//:benchmark_main",
    ],
)

donner_cc_library(
    name = "css_parser_bench_inputs",
    hdrs = ["CssParserBenchInputs.h"],
    deps = ["//donner/css/parser"],
)

donner_cc_library(
    name = "css_cascade_scenes",
    srcs = ["CssCascadeScenes.cc"],
    hdrs = ["CssCascadeScenes.h"],
    # Its compile closure reaches the SheenBidi headers only in the text tiers.
    variant_neutral = False,
    deps = [
        "//donner/base",
        "//donner/base/xml",
        "//donner/svg",
        "//donner/svg/internal:rendering_diagnostics",
        "//donner/svg/parser",
        "//donner/svg/renderer",
        "//donner/svg/renderer:renderer_driver",
    ],
)

donner_cc_binary(
    name = "css_cascade_perf_bench",
    srcs = ["CssCascadePerfBench.cpp"],
    data = [
        "//:donner_splash.svg",
        "//donner/svg/renderer/testdata",
        "//third_party/bootstrap-icons:bootstrap-icons.svg",
    ],
    deps = [":css_cascade_scenes"],
)

# Style cascade work: the correctness half pins the exact counters of fixed documents and edits on
# the PR gate; the wall-clock half records style time in the manual perf lane.
donner_perf_cc_test(
    name = "css_cascade_perf_tests",
    # Each case cascades up to about a million rule tests; under ASan two such cases together can
    # exceed the `size = "small"` limit, so each runs in its own shard.
    correctness_shard_count = 33,
    correctness_srcs = ["CssCascadePerfCorrectness_tests.cc"],
    data = [
        "//:donner_splash.svg",
        "//donner/svg/renderer/testdata",
        "//third_party/bootstrap-icons:bootstrap-icons.svg",
    ],
    wallclock_srcs = ["CssCascadePerfWallclock_tests.cc"],
    deps = [
        ":css_cascade_scenes",
        "//donner/base:base_test_utils",
        "@com_google_gtest//:gtest_main",
    ],
)

donner_cc_binary(
    name = "svg_parse_perf_bench",
    srcs = ["SvgParsePerfBench.cpp"],
    data = ["//:donner_splash.svg"],
    deps = [
        "//donner/base",
        "//donner/svg",
        "//donner/svg/parser",
    ],
)

donner_cc_test(
    name = "svg_parse_allocation_tests",
    srcs = [
        "SvgParseAllocationTracker.h",
        "SvgParseAllocation_tests.cc",
    ],
    data = ["//:donner_splash.svg"],
    deps = [
        "//donner/base",
        "//donner/base:base_test_utils",
        "//donner/svg",
        "//donner/svg/parser",
        "//donner/svg/renderer:renderer_tiny_skia",
        "@com_google_gtest//:gtest_main",
    ],
)

donner_cc_binary(
    name = "structured_editing_perf_bench",
    srcs = ["StructuredEditingPerfBench.cpp"],
    deps = [
        "//donner/base",
        "//donner/base/xml",
        "//donner/svg",
        "//donner/svg/parser",
        "@google_benchmark//:benchmark_main",
    ],
)

donner_cc_binary(
    name = "svg_element_handle_bench",
    srcs = ["SVGElementHandleBench.cpp"],
    deps = [
        "//donner/base",
        "//donner/svg",
        "@google_benchmark//:benchmark_main",
    ],
)

donner_cc_binary(
    name = "detached_subtree_collection_bench",
    srcs = ["DetachedSubtreeCollectionBench.cpp"],
    deps = [
        "//donner/svg",
        "@google_benchmark//:benchmark_main",
    ],
)

donner_cc_binary(
    name = "render_snapshot_bench",
    srcs = ["RenderSnapshotBench.cpp"],
    deps = [
        "//donner/base",
        "//donner/svg",
        "//donner/svg/parser",
        "//donner/svg/renderer",
        "//donner/svg/renderer:renderer_driver",
        "@google_benchmark//:benchmark_main",
    ],
)

sh_test(
    name = "dom_lifetime_perf_capture",
    size = "large",
    srcs = ["run_dom_lifetime_perf_bench.sh"],
    args = [
        "--bazel-test",
        "$(COMPILATION_MODE)",
        "$(location :svg_element_handle_bench)",
        "$(location :detached_subtree_collection_bench)",
        "$(location :render_snapshot_bench)",
    ],
    data = [
        "budgets/dom_lifetime_default_eligibility_budget.json",
        "budgets/dom_lifetime_perf_smoke_budget.json",
        ":detached_subtree_collection_bench",
        ":render_snapshot_bench",
        ":svg_element_handle_bench",
    ],
    tags = [
        "exclusive",
        "manual",
        "perf_benchmark",
    ],
)
