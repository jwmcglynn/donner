load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("@emsdk//emscripten_toolchain:wasm_rules.bzl", "wasm_cc_binary")
load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_python//python:defs.bzl", "py_test")
load("//tools/http:serve_http.bzl", "serve_http")
load(
    ":editor_wasm_transition.bzl",
    "editor_wasm_config_probe",
    "editor_wasm_geode_transitioned_target",
    "editor_wasm_runtime_options_probe",
)
load(":web_package.bzl", "web_package")

package(default_visibility = ["//visibility:public"])

bool_flag(
    name = "enable_wasm",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

config_setting(
    name = "wasm_enabled",
    flag_values = {
        ":enable_wasm": "True",
    },
)

_EDITOR_WASM_BINARY_DEPS = [
    "//donner/editor:editor_shell",
    "//donner/editor:editor_splash",
    "//donner/editor/gui:editor_window",
]

# emdawnwebgpu JS library files required by the Geode (WebGPU) backend.
# These implement the wgpu* C API via the browser's native WebGPU bindings.
_EMDAWNWEBGPU_JS_LIBS = [
    "//third_party/emdawnwebgpu:webgpu/src/webgpu-externs.js",
    "//third_party/emdawnwebgpu:webgpu/src/library_webgpu_enum_tables.js",
    "//third_party/emdawnwebgpu:webgpu/src/library_webgpu_generated_struct_info.js",
    "//third_party/emdawnwebgpu:webgpu/src/library_webgpu_generated_sig_info.js",
    "//third_party/emdawnwebgpu:webgpu/src/library_webgpu.js",
]

_EMDAWNWEBGPU_LINKOPTS = [
    "--closure-args=--externs=$(execpath //third_party/emdawnwebgpu:webgpu/src/webgpu-externs.js)",
    "--js-library=$(execpath //third_party/emdawnwebgpu:webgpu/src/library_webgpu_enum_tables.js)",
    "--js-library=$(execpath //third_party/emdawnwebgpu:webgpu/src/library_webgpu_generated_struct_info.js)",
    "--js-library=$(execpath //third_party/emdawnwebgpu:webgpu/src/library_webgpu_generated_sig_info.js)",
    "--js-library=$(execpath //third_party/emdawnwebgpu:webgpu/src/library_webgpu.js)",
    "-sASYNCIFY",
    # WebGPU readback can suspend from the full EditorShell frame stack. The
    # Emscripten's 4 KiB default overflows before waitAny rewinds. The
    # readback smoke test passes at 8 KiB; use 16 KiB for 2x headroom.
    "-sASYNCIFY_STACK_SIZE=16384",
]

# Linker flags shared by both renderer backends.
_COMMON_LINKOPTS = [
    "--closure=1",
    # SIMPLE keeps DOM, Emscripten, and WebGPU property names intact while
    # still compressing local glue. ADVANCED rewrites cross-language contracts
    # such as the input bridge and can leave the editor unresponsive.
    "--closure-args=--compilation_level=SIMPLE_OPTIMIZATIONS",
    "-pthread",
    "-sALLOW_MEMORY_GROWTH=1",
    "-sMAXIMUM_MEMORY=512MB",
    "-sEXIT_RUNTIME=0",
    # AsyncRenderer owns one persistent worker. Keep another worker available
    # for Emscripten's proxied browser work; consuming the whole pool with the
    # renderer can stall presentation and input after the first frame.
    "-sPTHREAD_POOL_SIZE=2",
    "-sSTACK_SIZE=1048576",
    "-sUSE_PTHREADS=1",
    "-sENVIRONMENT=web,worker",
]

_EDITOR_LINKOPTS = _COMMON_LINKOPTS

_GEODE_LINKOPTS = [
    # Geode's synchronous WebGPU bridge yields while creating devices and
    # waiting for mapped buffers. TinySkia has no asynchronous C++ call path.
    "-sASYNCIFY",
    # Safari can leave a pooled pthread with stale Wasm heap views when shared memory grows after
    # the pool starts. Geode's UI device, renderer device, fonts, and asynchronous SVG thumbnails
    # peak near 58 MiB during the browser regression, so start above that boundary. Keep this out
    # of the common options so TinySkia does not pay the additional initial-memory commitment.
    "-sINITIAL_MEMORY=64MB",
    "-sOFFSCREENCANVAS_SUPPORT=1",
] + _EMDAWNWEBGPU_LINKOPTS

cc_library(
    name = "notice_inputs",
    target_compatible_with = select({
        ":wasm_enabled": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//donner/editor:editor_shell",
        "//donner/editor:editor_splash",
    ],
)

cc_binary(
    name = "_editor_wasm_binary",
    srcs = ["//donner/editor:main.cc"],
    additional_linker_inputs = select({
        "//donner/svg/renderer:renderer_backend_geode": _EMDAWNWEBGPU_JS_LIBS,
        "//conditions:default": [],
    }),
    copts = [
        "-pthread",
    ],
    linkopts = _EDITOR_LINKOPTS + select({
        "//donner/svg/renderer:renderer_backend_geode": _GEODE_LINKOPTS,
        "//conditions:default": [],
    }),
    tags = [
        "manual",
        "wasm",
    ],
    target_compatible_with = select({
        ":wasm_enabled": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = _EDITOR_WASM_BINARY_DEPS + ["//donner/editor:notice"],
)

wasm_cc_binary(
    name = "wasm",
    cc_target = ":_editor_wasm_binary",
    outputs = [
        "editor.js",
        "editor.wasm",
    ],
    tags = [
        "manual",
        "wasm",
    ],
    target_compatible_with = select({
        ":wasm_enabled": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

web_package(
    name = "wasm_web_package",
    srcs = [
        "editor.css",
        "editor-bootstrap.js",
        "enable-threads.js",
        "index.html",
        "single/backend-selector.js",
        "worker-surface-selector.js",
        "//:donner_icon.svg",
    ],
    tags = [
        "manual",
        "wasm",
    ],
    target_compatible_with = select({
        ":wasm_enabled": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    wasm_deps = [":wasm"],
)

editor_wasm_geode_transitioned_target(
    name = "_wasm_web_package_for_serve",
    dep = ":wasm_web_package",
    tags = [
        "manual",
        "wasm",
    ],
    visibility = ["//visibility:private"],
)

serve_http(
    name = "serve_http",
    dir = ":_wasm_web_package_for_serve",
    tags = [
        "manual",
        "wasm",
    ],
)

editor_wasm_config_probe(
    name = "_editor_wasm_geode_transition_probe",
    testonly = True,
    visibility = ["//visibility:private"],
)

editor_wasm_geode_transitioned_target(
    name = "_editor_wasm_geode_transition_test_data",
    testonly = True,
    dep = ":_editor_wasm_geode_transition_probe",
    visibility = ["//visibility:private"],
)

editor_wasm_runtime_options_probe(
    name = "_editor_wasm_runtime_options_probe",
    testonly = True,
    geode_linkopts = _GEODE_LINKOPTS,
    linkopts = _EDITOR_LINKOPTS,
    visibility = ["//visibility:private"],
)

py_test(
    name = "editor_wasm_transition_tests",
    size = "small",
    srcs = ["editor_wasm_transition_tests.py"],
    args = [
        "$(rootpath :_editor_wasm_geode_transition_test_data)",
        "$(rootpath :_editor_wasm_runtime_options_probe)",
    ],
    data = [
        ":_editor_wasm_geode_transition_test_data",
        ":_editor_wasm_runtime_options_probe",
    ],
)

sh_test(
    name = "stage_compatible_package_tests",
    size = "small",
    srcs = ["stage-compatible-package_test.sh"],
    args = ["$(rootpath :stage-compatible-package.sh)"],
    data = [
        "backend-selector.js",
        "stage-compatible-package.sh",
