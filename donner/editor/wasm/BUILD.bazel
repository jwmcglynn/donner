load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("@emsdk//emscripten_toolchain:wasm_rules.bzl", "wasm_cc_binary")
load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_python//python:defs.bzl", "py_test")
load("//tools/http:serve_http.bzl", "serve_http")
load(
    ":editor_wasm_transition.bzl",
    "editor_wasm_config_probe",
    "editor_wasm_geode_only_guard",
    "editor_wasm_geode_transitioned_target",
    "editor_wasm_runtime_options_probe",
)
load(":web_package.bzl", "web_package")

package(default_visibility = ["//visibility:public"])

bool_flag(
    name = "enable_wasm",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

config_setting(
    name = "wasm_enabled",
    flag_values = {
        ":enable_wasm": "True",
    },
)

# Design 0064 phase 1 experiment: boot the whole editor under Emscripten
# PROXY_TO_PTHREAD with the single `#canvas` transferred as an OffscreenCanvas,
# and render documents inline on the app thread through the desktop-shaped
# framebuffer-underlay path. Off by default; the default package and its size
# gates never see this configuration.
bool_flag(
    name = "whole_app_worker",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

config_setting(
    name = "whole_app_worker_enabled",
    flag_values = {
        ":whole_app_worker": "True",
    },
)

_EDITOR_WASM_BINARY_DEPS = [
    "//donner/editor:editor_shell",
    "//donner/editor:editor_splash",
    "//donner/editor:pinch_zoom_policy",
    "//donner/editor/gui:editor_window",
]

# emdawnwebgpu JS library files required by the Geode (WebGPU) backend.
# These implement the wgpu* C API via the browser's native WebGPU bindings.
_EMDAWNWEBGPU_JS_LIBS = [
    "//third_party/emdawnwebgpu:webgpu/src/webgpu-externs.js",
    "//third_party/emdawnwebgpu:webgpu/src/library_webgpu_enum_tables.js",
    "//third_party/emdawnwebgpu:webgpu/src/library_webgpu_generated_struct_info.js",
    "//third_party/emdawnwebgpu:webgpu/src/library_webgpu_generated_sig_info.js",
    "//third_party/emdawnwebgpu:webgpu/src/library_webgpu.js",
]

_EMDAWNWEBGPU_LINKOPTS = [
    "--closure-args=--externs=$(execpath //third_party/emdawnwebgpu:webgpu/src/webgpu-externs.js)",
    "--js-library=$(execpath //third_party/emdawnwebgpu:webgpu/src/library_webgpu_enum_tables.js)",
    "--js-library=$(execpath //third_party/emdawnwebgpu:webgpu/src/library_webgpu_generated_struct_info.js)",
    "--js-library=$(execpath //third_party/emdawnwebgpu:webgpu/src/library_webgpu_generated_sig_info.js)",
    "--js-library=$(execpath //third_party/emdawnwebgpu:webgpu/src/library_webgpu.js)",
    "-sASYNCIFY",
    # WebGPU readback can suspend from the full EditorShell frame stack. The
    # Emscripten's 4 KiB default overflows before waitAny rewinds. The
    # readback smoke test passes at 8 KiB; use 16 KiB for 2x headroom.
    "-sASYNCIFY_STACK_SIZE=16384",
]

# Linker flags for the Geode-only editor WebAssembly binary.
_EDITOR_LINKOPTS = [
    "--closure=1",
    # SIMPLE keeps DOM, Emscripten, and WebGPU property names intact while
    # still compressing local glue. ADVANCED rewrites cross-language contracts
    # such as the input bridge and can leave the editor unresponsive.
    "--closure-args=--compilation_level=SIMPLE_OPTIMIZATIONS",
    # Binaryen's memory-packing pass splits the linker's merged static image at every zero-filled
    # gap. Pthread builds must initialize each resulting passive segment in __wasm_init_memory;
    # Safari's optimizing compiler spends gigabytes compiling that generated function. Preserve
    # the merged image and also cap Binaryen's otherwise-unlimited one-caller inlining threshold.
    #
    # That threshold is measured in Binaryen IR nodes, not bytes, so 1000 nodes was large enough to
    # swallow whole frame stages back into their single caller: the `noinline` stages split out of
    # `EditorShell::runFrame` and `EditorShell::renderRenderPane` were re-merged after the link and
    # both frame bodies stayed over the tier-compiler budget. 400 still inlines single-use wrappers
    # but leaves any real frame stage as its own Wasm function; it costs ~40 KiB of raw module size
    # and takes the largest function body from 46,391 to 28,417 bytes. This is a tightening of the
    # Safari contract; it is never to be relaxed back.
    "-sBINARYEN_EXTRA_PASSES=--skip-pass=memory-packing,--one-caller-inline-max-function-size=400,--inline-max-combined-binary-size=196608",
    "-pthread",
    "-sALLOW_MEMORY_GROWTH=1",
    "-sMAXIMUM_MEMORY=512MB",
    "-sEXIT_RUNTIME=0",
    # AsyncRenderer owns one persistent worker. Keep another worker available
    # for Emscripten's proxied browser work; consuming the whole pool with the
    # renderer can stall presentation and input after the first frame.
    "-sPTHREAD_POOL_SIZE=2",
    "-sSTACK_SIZE=1048576",
    "-sUSE_PTHREADS=1",
    "-sENVIRONMENT=web,worker",
    # Geode's synchronous WebGPU bridge yields while creating devices and
    # waiting for mapped buffers.
    "-sASYNCIFY",
    # Safari traps the pooled pthread with `RuntimeError: Out of bounds memory access` on the first
    # Wasm access it makes after the main thread grows the shared memory. Growth is not a
    # performance question on Safari, it is fatal, so the only defense is to start with a memory
    # large enough that boot and ordinary editing never reach `emscripten_resize_heap`.
    #
    # Measured by instrumenting `_emscripten_resize_heap` in a package built with a deliberately
    # small initial memory and reading the largest requested break: boot demands 40,861,696 bytes
    # (39.0 MiB), and opening the Donner Splash sample, a six-burst zoom storm and a five-step
    # resize churn all fit inside that same peak. 64 MiB is 1.64x the measured demand.
    #
    # This was 192 MiB while `RenderEmbeddedSvgIconBatch` rasterized all fourteen boot icons in one
    # atlas pass. Every document in a pass has to stay alive until its frame is submitted, at about
    # 6 MiB of Wasm heap apiece, so that single pass demanded 101,523,456 bytes on its own; capping
    # a pass at `kIconsPerAtlasPass` icons (donner/editor/EmbeddedSvgIcon.cc) removed 60 MiB of boot
    # peak and made the original 64 MiB correct again.
    #
    # Do not lower this without re-measuring, and do not raise `kIconsPerAtlasPass` without doing
    # the same: a value under boot demand is a boot failure on Safari, not a slow boot.
    "-sINITIAL_MEMORY=64MB",
    "-sOFFSCREENCANVAS_SUPPORT=1",
] + _EMDAWNWEBGPU_LINKOPTS

# Design 0064 phase 1 experiment link settings. Derived from the shipping
# settings so the two cannot drift: the whole app runs on one pthread that owns
# the transferred `#canvas`, so the shipping build's second pool slot (the
# render worker) is not needed and `PROXY_TO_PTHREAD` moves `main()` off the
# browser main thread.
#
# Linear memory is FIXED in this build: `INITIAL_MEMORY == MAXIMUM_MEMORY` with
# `ALLOW_MEMORY_GROWTH=0`. Growth is not a slow path here, it is the crash.
#
# The contract is: measure the peak, size the heap to it with fragmentation
# headroom, and make growth impossible. A build that outgrows this number must
# fail at the allocation that would have grown - a deterministic `Aborted(OOM)`
# naming the frame - rather than trapping an unrelated thread later. Do not
# re-enable growth to "fix" an OOM here; re-measure the peak and either bring it
# down or raise both numbers together.
#
# THIS NUMBER IS NOT YET CORRECT, and this build is not shippable until it is.
# Measured with the Design 0064 phase 2 memory harness
# (`donner/editor/wasm/tests/frame-budget-harness.mjs`), 1600x900 CSS viewport,
# Donner Splash, burst zoom storm, on the reference machine:
#
#   | device pixel ratio | canvas backing | outcome at 384 MiB fixed          |
#   |--------------------|----------------|-----------------------------------|
#   | 1 (Chromium)       | 1600x900       | `Aborted(OOM)` 0.5 to 1.5 s in    |
#   | 2 (Chromium)       | 3200x1800      | `Aborted(OOM)` 0.25 s in          |
#   | 2 (Firefox)        | 3200x1800      | `Aborted(OOM)` 3.5 to 4 s in      |
#
# The earlier claim recorded here - "384 MiB fixed: 10 s storm plus 20 s soak
# clean on Chromium, and Firefox is a separate Gecko demand curve" - was an
# artifact of an unmatched test. Playwright's Chromium forces
# `devicePixelRatio` to the context's `deviceScaleFactor` (default 1) over CDP;
# Playwright's Firefox does not and uses the display's own ratio. So the
# Chromium arm was rasterizing a quarter of the pixels the Firefox arm was, and
# a quarter of what a real user on the same display gets on *either* browser.
# Every canvas-scale allocation here is proportional to DPR squared. This is not
# a Gecko pathology; Chromium at the same ratio fails sooner.
#
# What actually consumes the heap under the storm, from the allocation-tag
# table (see `donner/base/HeapSizeHistogram.h`):
#
#   - Full-canvas raster surfaces allocated inside `CompositorController::
#     renderFrame` and never released: 6.20 MB each at DPR 1, 24.79 MB each at
#     DPR 2 (exactly 4x), accumulating about one per 250 ms until the heap ends.
#     `kMaxCompositorMemoryBytes` is 1 GiB, larger than this entire address
#     space, so the admission check in `maybePromote` can never refuse one.
#   - 72.9 MiB of `ImDrawVert` arrays, identical on both engines and at both
#     ratios, live from the first storm frame onward: one 20,106,204 B ImGui
#     draw-list vector plus three 18,79x,xxx B host staging arrays, one per
#     frame in flight. The first storm frame emits 936,006 ImGui vertices and
#     1,407,681 indices where the splash emits 12,370; neither ImGui's vectors
#     nor the WGPU backend's staging arrays ever shrink, so one frame's worst
#     case is retained for the session. That is 19 percent of this heap spent
#     on chrome geometry.
#
# Raising this constant is not the fix for either of those. Bounding the
# compositor to the address space it lives in, and not emitting a million
# vertices of chrome per frame, are.
_EDITOR_WORKER_APP_FIXED_MEMORY_BYTES = 402653184  # 384 MiB

# Dropped from the shipping list by *setting name*, not by exact string: the
# shipping `INITIAL_MEMORY` is re-tuned whenever boot demand is re-measured (it
# has been 64 MiB and 192 MiB), and an exact-match filter silently stops
# filtering when that happens, leaving two `-sINITIAL_MEMORY` flags on the link
# line whose winner is a last-one-wins accident.
_EDITOR_WORKER_APP_DROPPED_SETTINGS = [
    "-sPTHREAD_POOL_SIZE=",
    "-sALLOW_MEMORY_GROWTH=",
    "-sMAXIMUM_MEMORY=",
    "-sINITIAL_MEMORY=",
]

_EDITOR_WORKER_APP_LINKOPTS = [
    opt
    for opt in _EDITOR_LINKOPTS
    if not [prefix for prefix in _EDITOR_WORKER_APP_DROPPED_SETTINGS if opt.startswith(prefix)]
] + [
    "-sALLOW_MEMORY_GROWTH=0",
    "-sINITIAL_MEMORY={}".format(_EDITOR_WORKER_APP_FIXED_MEMORY_BYTES),
    "-sMAXIMUM_MEMORY={}".format(_EDITOR_WORKER_APP_FIXED_MEMORY_BYTES),
    "-sPROXY_TO_PTHREAD",
    # The app pthread is the only thread; pre-warm exactly one pool worker so
    # boot does not pay a worker spawn on the browser main thread.
    "-sPTHREAD_POOL_SIZE=1",
    # Emscripten's default already lists `#canvas`; state it so the experiment's
    # single-canvas contract is visible at the link line.
    "-sOFFSCREENCANVASES_TO_PTHREAD=#canvas",
]

cc_library(
    name = "notice_inputs",
    target_compatible_with = select({
        ":wasm_enabled": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//donner/editor:editor_shell",
        "//donner/editor:editor_splash",
    ],
)

editor_wasm_geode_only_guard(
    name = "_geode_only_guard",
    visibility = ["//visibility:private"],
)

cc_binary(
    name = "_editor_wasm_binary",
    srcs = ["//donner/editor:main.cc"],
    additional_linker_inputs = _EMDAWNWEBGPU_JS_LIBS + [":_geode_only_guard"],
    copts = [
        "-pthread",
    ],
    linkopts = _EDITOR_LINKOPTS,
    tags = [
        "manual",
        "wasm",
    ],
    target_compatible_with = select({
        ":wasm_enabled": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = _EDITOR_WASM_BINARY_DEPS + ["//donner/editor:notice"],
)

wasm_cc_binary(
    name = "wasm",
    cc_target = ":_editor_wasm_binary",
    outputs = [
        "editor.js",
        "editor.wasm",
    ],
    tags = [
        "manual",
        "wasm",
    ],
    target_compatible_with = select({
        ":wasm_enabled": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

web_package(
    name = "wasm_web_package",
    srcs = [
        "editor.css",
        "editor-bootstrap.js",
        "enable-threads.js",
        "index.html",
        "worker-surface-selector.js",
        "//:donner_icon.svg",
    ],
    tags = [
        "manual",
        "wasm",
    ],
    target_compatible_with = select({
        ":wasm_enabled": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    wasm_deps = [":wasm"],
)

cc_binary(
    name = "_editor_wasm_worker_app_binary",
    srcs = ["//donner/editor:main.cc"],
    additional_linker_inputs = _EMDAWNWEBGPU_JS_LIBS + [":_geode_only_guard"],
    copts = [
        "-pthread",
    ],
    linkopts = _EDITOR_WORKER_APP_LINKOPTS,
    tags = [
        "manual",
        "wasm",
    ],
    target_compatible_with = select({
        ":whole_app_worker_enabled": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = _EDITOR_WASM_BINARY_DEPS + ["//donner/editor:notice"],
)

wasm_cc_binary(
    name = "wasm_worker_app",
    cc_target = ":_editor_wasm_worker_app_binary",
    # Subdirectory-scoped so these do not collide with the default package's
    # `editor.js` / `editor.wasm` outputs; `web_package` copies by basename, so
    # the served file names are unchanged.
    outputs = [
        "worker_app/editor.js",
        "worker_app/editor.wasm",
    ],
    tags = [
        "manual",
        "wasm",
    ],
    target_compatible_with = select({
        ":whole_app_worker_enabled": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

web_package(
    name = "wasm_web_package_worker_app",
    srcs = [
        "editor.css",
        "enable-threads.js",
        "worker-app-bootstrap.js",
        "worker-app-index.html",
        "//:donner_icon.svg",
    ],
    renames = {"worker-app-index.html": "index.html"},
    tags = [
        "manual",
        "wasm",
    ],
    target_compatible_with = select({
        ":whole_app_worker_enabled": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    wasm_deps = [":wasm_worker_app"],
)

editor_wasm_geode_transitioned_target(
    name = "_wasm_web_package_for_serve",
    dep = ":wasm_web_package",
    tags = [
        "manual",
        "wasm",
    ],
    visibility = ["//visibility:private"],
)

serve_http(
    name = "serve_http",
    dir = ":_wasm_web_package_for_serve",
    tags = [
        "manual",
        "wasm",
    ],
)

editor_wasm_config_probe(
    name = "_editor_wasm_geode_transition_probe",
    testonly = True,
    visibility = ["//visibility:private"],
)

editor_wasm_geode_transitioned_target(
    name = "_editor_wasm_geode_transition_test_data",
    testonly = True,
    dep = ":_editor_wasm_geode_transition_probe",
    visibility = ["//visibility:private"],
)

editor_wasm_runtime_options_probe(
    name = "_editor_wasm_runtime_options_probe",
    testonly = True,
    linkopts = _EDITOR_LINKOPTS,
    visibility = ["//visibility:private"],
)

py_test(
    name = "editor_wasm_transition_tests",
    size = "small",
    srcs = ["editor_wasm_transition_tests.py"],
    args = [
        "$(rootpath :_editor_wasm_geode_transition_test_data)",
        "$(rootpath :_editor_wasm_runtime_options_probe)",
    ],
    data = [
        ":_editor_wasm_geode_transition_test_data",
        ":_editor_wasm_runtime_options_probe",
    ],
)

py_test(
    name = "wasm_geode_package_size_tests",
    size = "small",
    srcs = ["wasm_package_size_tests.py"],
    args = [
        "--package-dir",
        "$(rootpath :wasm_web_package)",
        "--max-wasm-raw-bytes",
        "11250000",
        "--max-wasm-gzip-bytes",
        "4600000",
        "--max-wasm-function-body-bytes",
        "46000",
        "--max-wasm-data-segments",
        "64",
        "--max-js-raw-bytes",
        "180000",
        "--max-js-gzip-bytes",
        "49000",
        "--max-total-raw-bytes",
        "11500000",
        "--expected-js-property",
        "__donnerLastScrollEvent",
        "--expected-js-property",
        "__donnerWgpuReadbackStats",
        "--expected-js-property",
        "__donnerRequestWgpuReadback",
        "--expected-js-property",
        "__donnerWgpuReadbackCaptureStarts",
        "--expected-js-property",
        "__donnerWgpuReadbackCaptureCompletions",
        "--expected-js-property",
        "__donnerWgpuReadbackCaptureFailures",
        "--expected-js-property",
        "__donnerMainLoopRenderedFrames",
        "--expected-js-property",
        "__donnerEditorFrameRequested",
        "--expected-js-property",
        "__donnerWorkerRuntimeStats",
        "--expected-js-property",
        "__donnerActiveSampleStats",
        "--expected-js-property",
        "data-active-sample-id",
        "--expected-js-property",
        "zoomModifierHeld",
        "--expected-js-property",
        "__donnerFrameLoopStats",
        "--expected-js-property",
        "uiFrameMsSamples",
        "--expected-js-property",
        "presentationOnlyFrames",
        "--forbidden-js-token",
        "tiny_skia",
        "--forbidden-js-token",
        "TinySkia",
    ],
    data = [":wasm_web_package"],
    main = "wasm_package_size_tests.py",
    tags = [
        "manual",
        "wasm",
    ],
    target_compatible_with = select({
        ":wasm_enabled": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)
