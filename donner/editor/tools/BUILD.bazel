load("@rules_python//python:defs.bzl", "py_test")
load("//build_defs:packaged_resources.bzl", "packaged_resource_bundle")
load("//build_defs:rules.bzl", "donner_cc_library")
load(
    "//donner/editor:editor_product_config.bzl",
    donner_cc_binary = "editor_cc_binary",
)

# Tools for producing release assets through the editor's merged code paths.
#
# `generate_showcase_asset` is the reproducible, headless generator for the v0.8
# Donner showcase. It drives the same `convertTextToOutlines` +
# `ExportViewportAsSvg` code paths as the editor GUI and writes only to the
# caller-selected output path.
#
# Run:
#   bazel run //donner/editor/tools:generate_showcase_asset -- \
#       $PWD/donner_splash.svg /tmp/donner-showcase.svg
donner_cc_library(
    name = "showcase_asset_generator",
    srcs = ["GenerateShowcaseAsset.cc"],
    hdrs = ["GenerateShowcaseAsset.h"],
    visibility = ["//visibility:public"],
    deps = [
        "//donner/base",
        "//donner/editor:overlay_renderer",
        "//donner/editor:text_to_outlines",
        "//donner/editor:viewport_state",
        "//donner/editor:viewport_svg_export",
        "//donner/svg",
        "//donner/svg/parser",
    ],
)

packaged_resource_bundle(
    name = "generate_showcase_asset_resources",
    output_name = "generate_showcase_asset_impl.assets",
    resources = ["//third_party/public-sans:public-sans_resource_files"],
)

donner_cc_binary(
    name = "generate_showcase_asset",
    srcs = ["GenerateShowcaseAssetMain.cc"],
    data = [":generate_showcase_asset_resources"],
    visibility = ["//visibility:public"],
    deps = [
        ":showcase_asset_generator",
        "//donner/base:packaged_resource",
    ],
)

py_test(
    name = "generate_showcase_asset_cli_tests",
    srcs = ["generate_showcase_asset_cli_tests.py"],
    data = [
        ":generate_showcase_asset",
        ":generate_showcase_asset_resources",
        "//:donner_splash.svg",
    ],
)
