"""Shared GLFW + ImGui + OpenGL host for the advanced Donner editor."""

load("//build_defs:dep_audit.bzl", "configured_dependency_audit_test")
load("//build_defs:package.bzl", "donner_package")
load("//build_defs:rules.bzl", "donner_cc_library")

package(default_visibility = ["//visibility:public"])

configured_dependency_audit_test(
    name = "native_editor_no_wgpu_archive_audit_test",
    forbidden = [
        "//donner/svg/renderer/geode:geode_device_wgpu_reference_linux",
        "//donner/svg/renderer:renderer_geode_wgpu_reference_linux",
        "//donner/svg/renderer/tests:image_comparison_test_fixture_wgpu_reference_linux",
        "//donner/svg/renderer/tests:renderer_test_backend_wgpu_reference_linux",
        "//third_party/webgpu-cpp:webgpu_cpp",
        "//third_party/webgpu-cpp:wgpu_native_reference_runtime",
        "@wgpu_native_linux_aarch64//:wgpu_native",
        "@wgpu_native_linux_x86_64//:wgpu_native",
    ],
    target = "//donner/editor",
    target_compatible_with = select({
        "@platforms//os:macos": [],
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

objc_library(
    name = "editor_metal_layer_macos",
    srcs = ["EditorMetalLayer_macos.mm"],
    hdrs = ["EditorMetalLayer.h"],
    sdk_frameworks = [
        "Cocoa",
        "QuartzCore",
    ],
    target_compatible_with = select({
        "@platforms//os:macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "@glfw",
    ],
)

donner_cc_library(
    name = "ui_texture_registry",
    srcs = ["UiTextureRegistry.cc"],
    hdrs = ["UiTextureRegistry.h"],
    deps = [
        "//donner/editor:imgui_headers",
        "//donner/gpu",
        "@imgui",
    ],
)

donner_cc_library(
    name = "editor_window",
    srcs = ["EditorWindow.cc"],
    hdrs = ["EditorWindow.h"],
    defines = select({
        "//donner/editor:wasm_geode_enabled": ["DONNER_EDITOR_WGPU"],
        "//donner/svg/renderer:renderer_backend_geode": ["DONNER_EDITOR_WGPU"],
        "//conditions:default": [],
    }),
    deps = [
        "//donner/base",
        "//donner/base:memory_attribution",
        "//donner/editor:editor_theme",
        "//donner/editor:imgui_headers",
        "//donner/editor:tracy_wrapper",
        "//donner/editor:whole_app_worker_bridge",
        "//donner/svg/renderer:renderer_interface",
        "@imgui",
    ] + select({
        "@platforms//os:macos": [":editor_metal_layer_macos"],
        "//conditions:default": [],
    }) + select({
        "//donner/editor:wasm_geode_enabled": [
            ":imgui_runtime_renderer",
            ":ui_texture_registration",
            ":ui_texture_registry",
            "//donner/gpu",
            "//donner/svg/renderer/geode:geode_device",
            "//donner/svg/renderer/geode:geode_gpu_wait",
            "//third_party/emscripten-glfw",
        ],
        "//donner/svg/renderer:renderer_backend_geode": [
            ":imgui_runtime_renderer",
            ":ui_texture_registration",
            ":ui_texture_registry",
            "//donner/gpu",
            "//donner/gpu/vulkan:vulkan_device",
            "//donner/svg/renderer/geode:geode_device",
            "//donner/svg/renderer/geode:geode_gpu_wait",
            "@glfw",
            "@vulkan_headers",
        ],
        "//conditions:default": [
            "//third_party/glad",
            "@glfw",
        ],
    }),
)

donner_cc_library(
    name = "ui_texture_registration",
    srcs = ["UiTextureRegistration.cc"],
    hdrs = ["UiTextureRegistration.h"],
    deps = [
        ":imgui_runtime_renderer",
        ":ui_texture_registry",
        "//donner/base",
        "//donner/editor:imgui_headers",
        "//donner/gpu",
        "//donner/svg/renderer:renderer_geode",
        "//donner/svg/renderer/geode:geode_device",
        "@imgui",
    ],
)

donner_cc_library(
    name = "imgui_runtime_renderer",
    srcs = ["ImGuiRuntimeRenderer.cc"],
    hdrs = ["ImGuiRuntimeRenderer.h"],
    deps = [
        ":ui_texture_registry",
        "//donner/editor:imgui_headers",
        "//donner/gpu",
        "//donner/gpu/shader:compiled_shader",
        "//donner/gpu/shader:ui_draw_api",
        "//donner/gpu/shader:ui_draw_artifact",
        "@imgui",
    ] + select({
        "@platforms//os:macos": ["//donner/gpu/shader:ui_draw_native_artifact"],
        "@platforms//os:linux": ["//donner/gpu/shader:ui_draw_native_artifact"],
        "//conditions:default": [],
    }),
)

donner_package()
