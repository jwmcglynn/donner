"""Shared GLFW + ImGui + OpenGL host for the advanced Donner editor."""

load("//build_defs:dep_audit.bzl", "configured_dependency_audit_test")
load("//build_defs:rules.bzl", "donner_cc_library")
load(
    "//donner/gpu/shader:shader_families.bzl",
    "PRODUCTION_SHADER_FAMILIES",
    "UI_DRAW_SHADER_FAMILIES",
    "linked_shader_artifacts",
    "shader_apis",
    "shader_artifacts",
)
load("//tools/rust_boundary:dependency_audit.bzl", "no_rust_dependency_audit_test")

package(default_visibility = ["//visibility:public"])

no_rust_dependency_audit_test(
    name = "native_editor_no_wgpu_archive_audit_test",
    required = ["//donner/editor:editor_impl"],
    target = "//donner/editor",
    target_compatible_with = select({
        "@platforms//os:macos": [],
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

# A native editor links only its platform's shader projection: the native artifact of every
# production family, and the authored WGSL of none.
configured_dependency_audit_test(
    name = "native_editor_shader_projection_audit_test",
    forbidden = shader_artifacts(PRODUCTION_SHADER_FAMILIES),
    required = ["//donner/editor:editor_impl"] + [
        "//donner/gpu/shader:%s_native_artifact" % family
        for family in PRODUCTION_SHADER_FAMILIES
    ],
    target = "//donner/editor",
    target_compatible_with = select({
        "@platforms//os:macos": [],
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

objc_library(
    name = "editor_metal_layer_macos",
    srcs = ["EditorMetalLayer_macos.mm"],
    hdrs = ["EditorMetalLayer.h"],
    sdk_frameworks = [
        "Cocoa",
        "QuartzCore",
    ],
    target_compatible_with = select({
        "@platforms//os:macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "@glfw",
    ],
)

donner_cc_library(
    name = "ui_texture_registry",
    srcs = ["UiTextureRegistry.cc"],
    hdrs = ["UiTextureRegistry.h"],
    deps = [
        "//donner/editor:imgui_headers",
        "//donner/gpu",
        "@imgui",
    ],
)

donner_cc_library(
    name = "editor_window",
    srcs = ["EditorWindow.cc"],
    hdrs = ["EditorWindow.h"],
    defines = select({
        "//donner/editor:wasm_geode_enabled": ["DONNER_EDITOR_WGPU"],
        "//donner/svg/renderer:renderer_backend_geode": ["DONNER_EDITOR_WGPU"],
        "//conditions:default": [],
    }),
    deps = [
        "//donner/base",
        "//donner/base:memory_attribution",
        "//donner/editor:editor_theme",
        "//donner/editor:imgui_headers",
        "//donner/editor:tracy_wrapper",
        "//donner/editor:whole_app_worker_bridge",
        "//donner/svg/renderer:renderer_interface",
        "@imgui",
    ] + select({
        "@platforms//os:macos": [":editor_metal_layer_macos"],
        "//conditions:default": [],
    }) + select({
        "//donner/editor:wasm_geode_enabled": [
            ":imgui_runtime_renderer",
            ":ui_texture_registration",
            ":ui_texture_registry",
            "//donner/gpu",
            "//donner/gpu/browser:emscripten_browser_bridge",
            "//donner/svg/renderer/geode:geode_device",
            "//donner/svg/renderer/geode:geode_gpu_wait",
            "//third_party/emscripten-glfw",
        ],
        "//donner/svg/renderer:renderer_backend_geode": [
            ":imgui_runtime_renderer",
            ":ui_texture_registration",
            ":ui_texture_registry",
            "//donner/gpu",
            "//donner/gpu/vulkan:vulkan_device",
            "//donner/svg/renderer/geode:geode_device",
            "//donner/svg/renderer/geode:geode_gpu_wait",
            "@glfw",
            "@vulkan_headers",
        ],
        "//conditions:default": [
            "//third_party/glad",
            "@glfw",
        ],
    }),
)

donner_cc_library(
    name = "ui_texture_registration",
    srcs = ["UiTextureRegistration.cc"],
    hdrs = ["UiTextureRegistration.h"],
    deps = [
        ":imgui_runtime_renderer",
        ":ui_texture_registry",
        "//donner/base",
        "//donner/editor:imgui_headers",
        "//donner/gpu",
        "//donner/svg/renderer:renderer_geode",
        "//donner/svg/renderer/geode:geode_device",
        "@imgui",
    ],
)

donner_cc_library(
    name = "imgui_runtime_renderer",
    srcs = ["ImGuiRuntimeRenderer.cc"],
    hdrs = ["ImGuiRuntimeRenderer.h"],
    deps = [
        ":ui_texture_registry",
        "//donner/editor:imgui_headers",
        "//donner/gpu",
        "//donner/gpu/shader:compiled_shader",
        "//donner/gpu/shader:linked_projection",
        "@imgui",
    ] + shader_apis(UI_DRAW_SHADER_FAMILIES) + linked_shader_artifacts(UI_DRAW_SHADER_FAMILIES),
)
