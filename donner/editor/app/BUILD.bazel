"""Headless render-session tooling: the non-GUI session, REPL shell, and binary.

The `:render_session` library is fully UI-free and exhaustively testable; the
binary target layers a stdin/stdout REPL on top.
"""

load("//build_defs:package.bzl", "donner_package")
load("//build_defs:rules.bzl", "donner_cc_library", "renderer_backend_compatible_with")
load(
    "//donner/editor:editor_product_config.bzl",
    donner_cc_binary = "editor_cc_binary",
)

package(default_visibility = ["//donner/editor:__subpackages__"])

donner_cc_library(
    name = "render_session",
    srcs = ["EditorApp.cc"],
    hdrs = ["EditorApp.h"],
    target_compatible_with = renderer_backend_compatible_with([
        "tiny_skia",
        "geode",
    ]),
    visibility = ["//donner/editor:__subpackages__"],
    deps = [
        "//donner/base",
        "//donner/editor:requires_text_true_and_text_full_true",
        "//donner/svg",
        "//donner/svg/parser",
        "//donner/svg/renderer",
        "//donner/svg/renderer:renderer_interface",
    ],
)

donner_cc_library(
    name = "render_session_repl",
    srcs = ["EditorRepl.cc"],
    hdrs = ["EditorRepl.h"],
    target_compatible_with = renderer_backend_compatible_with([
        "tiny_skia",
        "geode",
    ]),
    visibility = ["//donner/editor:__subpackages__"],
    deps = [
        ":render_session",
        "//donner/svg/renderer:renderer_image_io",
        "//donner/svg/renderer:renderer_interface",
        "//donner/svg/renderer:terminal_image_viewer",
    ],
)

donner_cc_binary(
    name = "render_repl",
    srcs = ["donner_editor_main.cc"],
    tags = ["codeql_default"],
    target_compatible_with = renderer_backend_compatible_with([
        "tiny_skia",
        "geode",
    ]),
    visibility = ["//donner/editor:__subpackages__"],
    deps = [
        ":render_session",
        ":render_session_repl",
    ],
)

donner_package()
