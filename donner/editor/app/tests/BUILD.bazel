"""Tests for the headless render session + REPL."""

load("//build_defs:package.bzl", "donner_package")
load("//build_defs:rules.bzl", "renderer_backend_compatible_with")
load(
    "//donner/editor:editor_product_config.bzl",
    donner_cc_test = "editor_cc_test",
)

donner_cc_test(
