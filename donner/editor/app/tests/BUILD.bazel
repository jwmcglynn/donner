"""Tests for the headless render session + REPL."""

load("//build_defs:rules.bzl", "donner_cc_test", "renderer_backend_compatible_with")

donner_cc_test(
    name = "render_session_tests",
    srcs = ["EditorApp_tests.cc"],
    target_compatible_with = renderer_backend_compatible_with([
        "tiny_skia",
        "geode",
    ]),
    deps = [
        "//donner/editor/app:render_session",
        "//donner/editor/app:render_session_repl",
        "@com_google_gtest//:gtest_main",
    ],
)

# Source inputs for the GPU inventory ratchet (//tools/gpu_inventory). The
# manifests are derived from a lexical scan of these files, so they must be
# declared as real Bazel inputs for the check to be a cacheable test with
# correct change detection. See tools/gpu_inventory/README.md.
filegroup(
    name = "gpu_inventory_srcs",
    srcs = glob(
        [
            "**/*.h",
            "**/*.cc",
            "**/*.mm",
            "**/*.wgsl",
            "**/*.patch",
            "**/*.bzl",
            "BUILD.bazel",
        ],
        allow_empty = True,
    ),
    visibility = ["//tools/gpu_inventory:__pkg__"],
)
