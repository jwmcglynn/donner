    srcs = ["EditorApp_tests.cc"],
    target_compatible_with = renderer_backend_compatible_with([
        "tiny_skia",
        "geode",
    ]),
    visibility = ["//donner/editor/tests:__pkg__"],
    deps = [
        "//donner/editor/app:render_session",
        "//donner/editor/app:render_session_repl",
        "@com_google_gtest//:gtest_main",
    ],
)

donner_package()
