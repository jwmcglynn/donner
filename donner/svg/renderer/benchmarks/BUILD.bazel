load("//build_defs:dep_audit.bzl", "configured_dependency_audit_test")
load("@rules_python//python:defs.bzl", "py_test")

"""Renderer benchmarks: backend-independent document-preparation timing, plus per-phase
timing for the Geode WebGPU/Slug backend."""

load("//build_defs:packaged_resources.bzl", "packaged_resource_bundle")
load("//build_defs:rules.bzl", "donner_cc_binary", "donner_cc_library", "donner_cc_test", "donner_multi_transitioned_test")

package(default_visibility = ["//visibility:public"])

donner_cc_library(
    name = "proc_status_parser",
    srcs = ["ProcStatusParser.cc"],
    hdrs = ["ProcStatusParser.h"],
    deps = [],
)

donner_cc_test(
    name = "proc_status_parser_tests",
    size = "small",
    srcs = ["ProcStatusParser_tests.cc"],
    deps = [
        ":proc_status_parser",
        "@com_google_gtest//:gtest_main",
    ],
)

donner_cc_binary(
    name = "shape_prepare_perf_bench",
    testonly = 1,
    srcs = ["ShapePreparePerfBench.cc"],
    data = ["//donner/svg/renderer/testdata"],
    deps = [
        "//donner/base",
        "//donner/base:base_test_utils",
        "//donner/svg",
        "//donner/svg/parser",
        "//donner/svg/renderer",
        "@google_benchmark//:benchmark",
    ],
)

donner_cc_binary(
    name = "renderer_bench",
    srcs = ["RendererBench.cc"],
    data = select({
        "//donner/svg/renderer:text_enabled": [":renderer_bench_resources"],
        "//conditions:default": [],
    }) + [
        "testdata/gradient_grid.svg",
        "//donner/svg/renderer/testdata",
    ],
    target_compatible_with = select({
        "//donner/svg/renderer/geode:geode_enabled": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//donner/base",
        "//donner/base:packaged_resource",
        "//donner/css",
        "//donner/svg",
        "//donner/svg/components/resources:resource_manager_context",
        "//donner/svg/parser",
        "//donner/svg/renderer:renderer_geode",
        "//donner/svg/renderer/geode:geode_device",
    ],
)

donner_cc_binary(
    name = "engine_compare_bench",
    srcs = [
        "AllocationTracker.h",
        "EngineCompareBench.cc",
    ],
    data = select({
        "//donner/svg/renderer:text_enabled": [":engine_compare_bench_resources"],
        "//conditions:default": [],
    }) + ["testdata/simple_setup.svg"],
    target_compatible_with = select({
        "//donner/svg/renderer/geode:geode_enabled": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//donner/base:packaged_resource",
        ":proc_status_parser",
        "//donner/base",
        "//donner/svg",
        "//donner/svg/parser",
        "//donner/svg/renderer:renderer_geode",
        "//donner/svg/renderer:renderer_image_io",
        # In-tree TinySkia CPU backend for the --backend=tiny-skia comparison
        # mode. The benchmark links both backends directly (like the parity
        # test binary), which the geode_excludes_tiny_skia_audit permits:
        # it only forbids a path from :renderer_geode to :renderer_tiny_skia.
        "//donner/svg/renderer:renderer_tiny_skia",
        "//donner/svg/renderer/geode:geode_device",
    ],
)

packaged_resource_bundle(
    name = "renderer_bench_resources",
    output_name = "renderer_bench.assets",
    resources = select({
        "//donner/svg/renderer:text_enabled": ["//third_party/public-sans:public-sans_resource_files"],
        "//conditions:default": [],
    }),
)

packaged_resource_bundle(
    name = "engine_compare_bench_resources",
    output_name = "engine_compare_bench.assets",
    resources = select({
        "//donner/svg/renderer:text_enabled": ["//third_party/public-sans:public-sans_resource_files"],
        "//conditions:default": [],
    }),
)

py_test(
    name = "native_benchmark_resource_delivery_tests_impl",
    size = "medium",
    srcs = ["native_benchmark_resource_delivery_tests.py"],
    data = [
        ":engine_compare_bench",
        ":renderer_bench",
    ],
    main = "native_benchmark_resource_delivery_tests.py",
    tags = ["manual"],
    deps = ["//donner/svg/renderer/tests:native_resource_delivery_fixture"],
)

donner_multi_transitioned_test(
    name = "native_benchmark_resource_delivery_tests",
    size = "medium",
    dep = ":native_benchmark_resource_delivery_tests_impl",
    renderer_backend = "geode",
    text = "true",
    text_full = "false",
)

configured_dependency_audit_test(
    name = "renderer_bench_no_text_resource_audit",
    forbidden = [
        "//donner/svg/renderer/benchmarks:renderer_bench_resources",
        "//third_party/public-sans:public-sans_resource_files",
    ],
    required = ["//donner/svg/renderer/benchmarks:renderer_bench"],
    target = "//donner/svg/renderer/benchmarks:renderer_bench",
    text_configuration = "none",
)

configured_dependency_audit_test(
    name = "engine_compare_bench_no_text_resource_audit",
    forbidden = [
        "//donner/svg/renderer/benchmarks:engine_compare_bench_resources",
        "//third_party/public-sans:public-sans_resource_files",
    ],
    required = ["//donner/svg/renderer/benchmarks:engine_compare_bench"],
    target = "//donner/svg/renderer/benchmarks:engine_compare_bench",
    text_configuration = "none",
)
