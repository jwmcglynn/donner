"""Geode: GPU-native SVG rendering backend.

This backend is gated behind a build flag so default builds do not pull in the
WebGPU runtime at all (the GPU/Dawn dependencies are not in the default graph),
not because of maturity — Geode is the editor's default renderer. WebGPU is provided
on native by a prebuilt `wgpu-native` archive (see
`third_party/bazel/non_bcr_deps.bzl`) and on WASM by emdawnwebgpu (browser
WebGPU bindings).

To enable:

    bazel build --//donner/svg/renderer/geode:enable_geode=true \\
        //donner/svg/renderer/geode/...
"""

load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("@rules_python//python:defs.bzl", "py_test")
load("//build_defs:package.bzl", "donner_package")
load("//build_defs:rules.bzl", "donner_cc_fuzzer", "donner_cc_library", "donner_cc_test", "donner_multi_transitioned_test")

# Build flag controlling whether Geode's WebGPU-backed targets are compiled.
bool_flag(
    name = "enable_geode",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

config_setting(
    name = "geode_enabled",
    flag_values = {":enable_geode": "True"},
    visibility = ["//visibility:public"],
)

# Targets below are only compatible when --//donner/svg/renderer/geode:enable_geode=true.
_GEODE_ONLY = select({
    ":geode_enabled": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

donner_cc_fuzzer(
    name = "geode_svg_geometry_budget_fuzzer",
    srcs = ["tests/GeodeSvgGeometryBudget_fuzzer.cc"],
    corpus = "tests/geode_svg_geometry_budget_corpus",
    routing_manifest = "geode_geometry_fuzzer_routing_manifest",
    tags = [
        "exclusive-if-local",
        "fuzz_geode",
    ],
    deps = [
        ":geode_device",
        "//donner/svg",
        "//donner/svg/renderer:renderer_geode",
    ],
)

py_test(
    name = "geode_geometry_fuzzer_routing_tests",
    srcs = ["tests/GeodeGeometryFuzzerRouting_tests.py"],
    args = [
        "$(rootpath :geode_geometry_fuzzer_routing_manifest)",
        "$(rootpath tests/GeodeSvgGeometryBudget_fuzzer.cc)",
    ],
    data = [
        "tests/GeodeSvgGeometryBudget_fuzzer.cc",
        ":geode_geometry_fuzzer_routing_manifest",
    ],
    main = "tests/GeodeGeometryFuzzerRouting_tests.py",
)

# CPU-side Slug band decomposition. Pure path math — no WebGPU dependency,
# always built regardless of the enable_geode flag. Downstream Geode targets
# (GeoEncoder, RendererGeode) consume the EncodedPath struct this produces
# and upload it to GPU buffers.
donner_cc_library(
    name = "geode_path_encoder",
    srcs = ["GeodePathEncoder.cc"],
    hdrs = ["GeodePathEncoder.h"],
    # //donner/gpu: the GPU vertical slice tests (Metal, Vulkan) encode the
    # frozen-baseline paths with the same banding the production path uses.
    # GeodePathEncoder is pure CPU path math with no GPU dependency.
    visibility = [
        "//donner/gpu:__subpackages__",
        "//donner/svg/renderer:__subpackages__",
    ],
    deps = [
        "//donner/base",
    ],
)

donner_cc_library(
    name = "geode_resource_budget",
    hdrs = ["GeodeResourceBudget.h"],
    visibility = ["//donner/svg/renderer:__subpackages__"],
    deps = ["//donner/svg/components"],
)

# Header-only ECS component for the M2 Geode path-encode cache. See
