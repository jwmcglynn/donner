donner_multi_transitioned_test(
    name = "geode_shaders_tests",
    # Not the short timeout its neighbours use. That one is a hang detector for device creation,
    # which should take seconds on a healthy driver; this suite legitimately runs 30 shader
    # pipelines, and needs 66 s of them on a software rasterizer. Moderate keeps the intent -
    # a hung driver is still killed, in five minutes rather than one - without failing a run
    # where every case passes steadily.
    timeout = "moderate",
    testonly = 1,
    dep = ":geode_shaders_tests_impl",
    opens_gpu_device = True,
    renderer_backend = "geode",
)

