donner_cc_library(
    name = "geode_device",
    # GeodeFilterEngine and GeodePipeline / GeodeImagePipeline are folded
    # into this library so `GeodeDevice` can own them as shared-across-
    # renderers singletons (issue #575). Splitting them back out would
    # reintroduce the circular dep (`geode_device` needs their ctors;
    # they need `GeodeDevice::device()`/`queue()`). The filter engine
    # no longer has a meaningful life independent of a `GeodeDevice`,
    # so the merge is semantic rather than mechanical.
    srcs = [
        "GeodeCheckerboardPipeline.cc",
        "GeodeDevice.cc",
        "GeodeFilterEngine.cc",
        "GeodeImagePipeline.cc",
        "GeodePipeline.cc",
        # TEMPORARY transition adapter (see GeodeWgpuAdapterDevice.h for the
        # removal gates). Folded into geode_device like the pipelines so
        # GeodeDevice can own the adapter alongside the shared pipelines it
        # constructs, without a circular dependency.
        "GeodeWgpuAdapterDevice.cc",
    ],
    hdrs = [
        "GeodeCallbackState.h",
        "GeodeCheckerboardPipeline.h",
        "GeodeDevice.h",
        "GeodeFilterEngine.h",
        "GeodeGpuContext.h",
        "GeodeImagePipeline.h",
        "GeodePipeline.h",
        "GeodeWgpuAdapterDevice.h",
    ],
    # wgpu-native's prebuilt libwgpu_native.dylib ships with its Metal
    # backend already linked, so no per-target framework linkopts are
    # needed on macOS — unlike the previous Dawn cmake() build which
    # required the consumer to link Metal/Foundation/QuartzCore/IOKit/
    # IOSurface/CoreGraphics manually. Linux still needs dl + pthread
    # because wgpu-native's .so references them but doesn't runtime-
    # load them itself.
    linkopts = select({
        "@platforms//os:linux": [
            "-ldl",
            "-lpthread",
        ],
        "//conditions:default": [],
    }),
    target_compatible_with = _GEODE_ONLY,
    visibility = [
        "//donner/editor/gui:__pkg__",
        "//donner/editor/tests:__pkg__",
        # The donner::gpu shader IR validation fixture compiles emitted WGSL
        # through GeodeDevice as a black box, the transition baseline.
        "//donner/gpu:__subpackages__",
        "//donner/svg/renderer:__subpackages__",
        "//examples:__pkg__",
    ],
    deps = [
        ":filter_color_matrix_wgsl",
        ":flood_wgsl",
        ":geode_counters",
        ":geode_gpu_wait",
        ":geode_shaders",
        ":geode_wgpu_util",
        ":offset_wgsl",
        ":snapshot_unpremultiply_wgsl",
        ":subregion_clip_wgsl",
        "//donner/base",
        "//donner/base:asyncify_suspend_probe",
        "//donner/gpu",
        "//donner/gpu/shader:program_bindings",
        "//donner/svg/components/filter:components",
        "//donner/svg/renderer:pixel_format_utils",
        "//third_party/webgpu-cpp:webgpu_cpp",
    ],
)

