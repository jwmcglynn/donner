donner_cc_library(
    name = "geode_device",
    # GeodeFilterEngine and GeodePipeline / GeodeImagePipeline are folded
    # into this library so `GeodeDevice` can own them as shared-across-
    # renderers singletons (issue #575). Splitting them back out would
    # reintroduce the circular dep (`geode_device` needs their ctors;
    # they need `GeodeDevice::device()`/`queue()`). The filter engine
    # no longer has a meaningful life independent of a `GeodeDevice`,
    # so the merge is semantic rather than mechanical.
    srcs = [
        "GeodeCheckerboardPass.cc",
        "GeodeDevice.cc",
        "GeodeFilterEngine.cc",
        "GeodeImagePipeline.cc",
        "GeodePipeline.cc",
        # TEMPORARY transition adapter (see GeodeWgpuAdapterDevice.h for the
        # removal gates). Folded into geode_device like the pipelines so
        # GeodeDevice can own the adapter alongside the shared pipelines it
        # constructs, without a circular dependency.
        "GeodeWgpuAdapterDevice.cc",
    ],
    hdrs = [
        "GeodeCallbackState.h",
        "GeodeDevice.h",
        "GeodeFilterEngine.h",
        "GeodeGpuContext.h",
        "GeodeImagePipeline.h",
        "GeodePipeline.h",
        "GeodeWgpuAdapterDevice.h",
    ],
    # wgpu-native's prebuilt libwgpu_native.dylib ships with its Metal
    # backend already linked, so no per-target framework linkopts are
    # needed on macOS — unlike the previous Dawn cmake() build which
    # required the consumer to link Metal/Foundation/QuartzCore/IOKit/
    # IOSurface/CoreGraphics manually. Linux still needs dl + pthread
    # because wgpu-native's .so references them but doesn't runtime-
    # load them itself.
    linkopts = select({
        "@platforms//os:linux": [
            "-ldl",
            "-lpthread",
        ],
        "//conditions:default": [],
    }),
    target_compatible_with = _GEODE_ONLY,
    visibility = [
        "//donner/editor/gui:__pkg__",
        "//donner/editor/tests:__pkg__",
        # The donner::gpu shader IR validation fixture compiles emitted WGSL
        # through GeodeDevice as a black box, the transition baseline.
        "//donner/gpu:__subpackages__",
        "//donner/svg/renderer:__subpackages__",
        "//examples:__pkg__",
    ],
    deps = [
        ":checkerboard_pipeline",
        ":geode_counters",
        ":geode_gpu_wait",
        ":geode_shaders",
        ":geode_wgpu_util",
        "//donner/base",
        "//donner/base:asyncify_suspend_probe",
        "//donner/gpu",
        "//donner/gpu/shader:color_space_convert_api",
        "//donner/gpu/shader:color_space_convert_artifact",
        "//donner/gpu/shader:component_transfer_api",
        "//donner/gpu/shader:component_transfer_artifact",
        "//donner/gpu/shader:composite_api",
        "//donner/gpu/shader:composite_artifact",
        "//donner/gpu/shader:convolve_matrix_api",
        "//donner/gpu/shader:convolve_matrix_artifact",
        "//donner/gpu/shader:diffuse_lighting_api",
        "//donner/gpu/shader:diffuse_lighting_artifact",
        "//donner/gpu/shader:displacement_map_api",
        "//donner/gpu/shader:displacement_map_artifact",
        "//donner/gpu/shader:drop_shadow_api",
        "//donner/gpu/shader:drop_shadow_artifact",
        "//donner/gpu/shader:filter_blend_api",
        "//donner/gpu/shader:filter_blend_artifact",
        "//donner/gpu/shader:filter_color_matrix_api",
        "//donner/gpu/shader:filter_color_matrix_artifact",
        "//donner/gpu/shader:filter_image_api",
        "//donner/gpu/shader:filter_image_artifact",
        "//donner/gpu/shader:filter_resolve_api",
        "//donner/gpu/shader:filter_resolve_artifact",
        "//donner/gpu/shader:flood_api",
        "//donner/gpu/shader:flood_artifact",
        "//donner/gpu/shader:gaussian_blur_api",
        "//donner/gpu/shader:gaussian_blur_artifact",
        "//donner/gpu/shader:image_blit_api",
        "//donner/gpu/shader:image_blit_artifact",
        "//donner/gpu/shader:lighting_params",
        "//donner/gpu/shader:merge_api",
        "//donner/gpu/shader:merge_artifact",
        "//donner/gpu/shader:morphology_api",
        "//donner/gpu/shader:morphology_artifact",
        "//donner/gpu/shader:offset_api",
        "//donner/gpu/shader:offset_artifact",
        "//donner/gpu/shader:slug_fill_api",
        "//donner/gpu/shader:slug_fill_artifact",
        "//donner/gpu/shader:slug_gradient_api",
        "//donner/gpu/shader:slug_gradient_artifact",
        "//donner/gpu/shader:slug_mask_api",
        "//donner/gpu/shader:slug_mask_artifact",
        "//donner/gpu/shader:snapshot_unpremultiply_api",
        "//donner/gpu/shader:snapshot_unpremultiply_artifact",
        "//donner/gpu/shader:specular_lighting_api",
        "//donner/gpu/shader:specular_lighting_artifact",
        "//donner/gpu/shader:subregion_clip_api",
        "//donner/gpu/shader:subregion_clip_artifact",
        "//donner/gpu/shader:tile_api",
        "//donner/gpu/shader:tile_artifact",
        "//donner/gpu/shader:turbulence_api",
        "//donner/gpu/shader:turbulence_artifact",
        "//donner/svg/components/filter:components",
        "//donner/svg/renderer:pixel_format_utils",
        "//third_party/webgpu-cpp:webgpu_cpp",
    ],
)

