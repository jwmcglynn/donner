donner_multi_transitioned_test(
    name = "geode_device_tests",
    # Tight timeout — device-creation tests should never take more than
    # a few seconds on a healthy driver. If we hit 60s here, the driver
    # is almost certainly hung and should be killed before it wastes
    # more CI time (e.g., Intel Arc + Mesa 25.2.8 Xe-KMD regressions).
    timeout = "short",
    testonly = 1,
    dep = ":geode_device_tests_impl",
    opens_gpu_device = True,
    renderer_backend = "geode",
)

# Embed the WGSL shader source as a C++ resource. The generated header
# exposes `donner::embedded::kSlugFillWgsl` as a `std::span<const unsigned char>`.
# Build-time emission of the snapshot-unpremultiply program.
#
# The shader IR module is the source of truth; its WGSL is produced here rather than at runtime
# so the editor's WebAssembly package links neither the IR nor the emitters for a string that is
# identical on every build. The tool is program-name driven, so a filter family migrating onto
# the IR adds a row to its table and a genrule like this one.
#
# The emitted bytes are the same bytes the program's committed golden pins - the golden test
# compares that same EmitWgsl output - so the artifact embedded here and the artifact reviewed in
# the diff cannot disagree without a test failing.
genrule(
    name = "snapshot_unpremultiply_generated",
    outs = ["generated/snapshot_unpremultiply.wgsl"],
    cmd = "$(location //donner/gpu/shader/tools:emit_program_wgsl) snapshot_unpremultiply " +
          "$(location generated/snapshot_unpremultiply.wgsl)",
    tools = ["//donner/gpu/shader/tools:emit_program_wgsl"],
)

embed_resources(
    name = "snapshot_unpremultiply_wgsl",
    header_output = "embed_resources/SnapshotUnpremultiplyWgsl.h",
    resources = {
        "kSnapshotUnpremultiplyWgsl": "generated/snapshot_unpremultiply.wgsl",
    },
    visibility = ["//donner/svg/renderer:__subpackages__"],
)

# Build-time emission of the flood program, on the same terms as the one above.
genrule(
    name = "flood_generated",
    outs = ["generated/flood.wgsl"],
