load("@aspect_rules_js//js:defs.bzl", "js_test")
load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("@emsdk//emscripten_toolchain:wasm_cc_binary.bzl", "wasm_cc_binary")
load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_python//python:defs.bzl", "py_test")
load("//build_defs:licenses.bzl", "donner_notice_file")
load("//donner/editor/wasm:web_package.bzl", "web_package")
load("//tools/http:serve_http.bzl", "serve_http")
load("//tools/rust_boundary:dependency_audit.bzl", "no_rust_dependency_audit_test")
load(":geode_browser_test_transition.bzl", "geode_browser_config_probe", "geode_browser_test_package")

package(default_visibility = ["//visibility:public"])

bool_flag(
    name = "enable_wasm",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

config_setting(
    name = "wasm_tiny_skia",
    flag_values = {
        ":enable_wasm": "True",
        "//donner/svg/renderer:renderer_backend": "tiny_skia",
    },
)

config_setting(
    name = "wasm_geode",
    flag_values = {
        ":enable_wasm": "True",
        "//donner/svg/renderer:renderer_backend": "geode",
    },
)

# The Geode module renders through the browser backend, its only GPU device in a browser.
config_setting(
    name = "wasm_geode_browser",
    flag_values = {
        ":enable_wasm": "True",
        "//donner/svg/renderer:renderer_backend": "geode",
        "//donner/svg/renderer/geode:browser_backend": "True",
    },
)

_WASM_TINY_SKIA_COMPATIBLE_WITH = select({
    ":wasm_tiny_skia": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

_WASM_GEODE_COMPATIBLE_WITH = select({
    ":wasm_geode_browser": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

# Transport stays static JavaScript; no editor C++ or worker runtime enters these modules.
donner_notice_file(
    name = "fallback_font_notice",
    licenses = ["//third_party/licenses:public-sans"],
    variant = "Standalone renderer fallback font",
)

filegroup(
    name = "fallback_font_notice_text",
    srcs = [":fallback_font_notice"],
    output_group = "notice",
)

_TEXT_RESOURCE_SUPPORT = select({
    "//donner/svg/renderer:text_enabled": [
        ":fallback_font_notice_text",
        "//donner/editor/wasm:catalog-fonts.js",
        "//donner/editor/wasm:packaged-resource-loader.js",
    ],
    "//conditions:default": [],
})

_TEXT_RESOURCE_TREES = select({
    "//donner/svg/renderer:text_enabled": ["//third_party/public-sans:public-sans_resource_files"],
    "//conditions:default": [],
})

# ─── Tiny-Skia (software rasterizer) WASM build ────────────────────────

# Internal cc_binary that Emscripten's wasm_cc_binary transitions to WASM.
cc_binary(
    name = "donner_wasm_bin",
    srcs = [
        "WasmBridgeUtils.h",
        "wasm_bridge.cc",
    ],
    linkopts = [
        "-sMODULARIZE=1",
        "-sEXPORT_ES6=1",
        "-sENVIRONMENT=web",
        "-sALLOW_MEMORY_GROWTH=1",
        # Smaller allocator than the default dlmalloc; safe with USE_PTHREADS=0.
        "-sMALLOC=emmalloc",
        "-sEXPORTED_RUNTIME_METHODS=ccall,cwrap,UTF8ToString,HEAPU8",
        "-sUSE_PTHREADS=0",
        "-sSTACK_SIZE=1048576",
        "--no-entry",
    ] + select({
        "//donner/svg/renderer:text_enabled": ["-sEXPORTED_FUNCTIONS=_donner_init,_donner_render_svg,_donner_render_svg_len,_donner_free_pixels,_donner_get_last_error,_malloc,_free,_donner_prepare_resources"],
        "//conditions:default": ["-sEXPORTED_FUNCTIONS=_donner_init,_donner_render_svg,_donner_render_svg_len,_donner_free_pixels,_donner_get_last_error,_malloc,_free"],
    }),
    tags = ["manual"],
    target_compatible_with = _WASM_TINY_SKIA_COMPATIBLE_WITH,
    deps = [
        "//donner/svg",
        "//donner/svg/parser",
        "//donner/svg/renderer",
    ],
)

# Extracts .js + .wasm artefacts from the Emscripten cc_binary.
wasm_cc_binary(
    name = "donner_wasm",
    cc_target = ":donner_wasm_bin",
    outputs = [
        "donner_wasm_bin.js",
        "donner_wasm_bin.wasm",
    ],
    tags = ["codeql_wasm"],
    target_compatible_with = _WASM_TINY_SKIA_COMPATIBLE_WITH,
)

# Complete software-renderer test page and its optional text assets.
web_package(
    name = "test_page",
    srcs = [
        "renderer-resources.js",
        "test.html",
    ] + _TEXT_RESOURCE_SUPPORT,
    asset_trees = _TEXT_RESOURCE_TREES,
    target_compatible_with = _WASM_TINY_SKIA_COMPATIBLE_WITH,
    wasm_deps = [":donner_wasm"],
)

# Headless render gate for the tiny_skia wasm module. Loads the built module
# under Node, renders a nontrivial SVG through the public C API, and asserts on
# the pixels (see render_test.py). This is the safety gate for JS-glue size
# work (closure minification, filesystem trims). Run against the shipped,
# size-optimized artifact so assertions are compiled out and the module loads
# outside a browser:
#
#   bazel test --config=wasm-size //donner/svg/renderer/wasm:render_test
#
# Node comes from the registered Bazel node runtime toolchain, never the host.
# Marked manual and gated to the tiny_skia wasm config so a plain host-config
# wildcard build does not try to pull in the wasm outputs.
py_test(
    name = "render_test",
    size = "small",
    srcs = ["render_test.py"],
    data = [
        "render_test_driver.mjs",
        ":donner_wasm",
        "@rules_nodejs//nodejs:current_node_runtime",
    ],
    env = {"DONNER_NODE_PATH": "$(NODE_PATH)"},
    tags = ["manual"],
    target_compatible_with = _WASM_TINY_SKIA_COMPATIBLE_WITH,
    toolchains = ["@rules_nodejs//nodejs:current_node_runtime"],
    deps = ["@rules_python//python/runfiles"],
)

# Run with --config=wasm-size --//donner/svg/renderer:text=true.
py_test(
    name = "render_text_test",
    size = "small",
    srcs = ["render_text_test.py"],
    data = [
        "render_text_test_driver.mjs",
        ":test_page",
        "@rules_nodejs//nodejs:current_node_runtime",
    ],
    env = {"DONNER_NODE_PATH": "$(NODE_PATH)"},
    tags = ["manual"],
    target_compatible_with = _WASM_TINY_SKIA_COMPATIBLE_WITH,
    toolchains = ["@rules_nodejs//nodejs:current_node_runtime"],
    deps = ["@rules_python//python/runfiles"],
)

# Read by //tools:ci_runtime_workflow_tests, which pins the size ceilings below.
exports_files(
    ["BUILD.bazel"],
    visibility = ["//tools:__pkg__"],
)

# Size gate for the shipped (`--config=wasm-size`) module and its JavaScript glue, run by
# //tools/ci:wasm_size_tests. Module and JavaScript ceilings are enforced independently.
# Lower ceilings as the module shrinks; increases require an explicit maintainer decision.
py_test(
    name = "wasm_size_tests",
    size = "small",
    srcs = ["//donner/editor/wasm:wasm_package_size_tests.py"],
    args = [
        "--metric-prefix",
        "renderer",
        "--wasm-file",
        "$(rootpath :donner_wasm_bin.wasm)",
        "--js-file",
        "$(rootpath :donner_wasm_bin.js)",
        "--max-wasm-raw-bytes",
        "2210000",
        "--max-wasm-gzip-bytes",
        "872000",
        "--max-js-raw-bytes",
        "5700",
        "--max-js-gzip-bytes",
        "2800",
    ],
    data = [
        ":donner_wasm_bin.js",
        ":donner_wasm_bin.wasm",
    ],
    main = "//donner/editor/wasm:wasm_package_size_tests.py",
    tags = ["manual"],
    target_compatible_with = _WASM_TINY_SKIA_COMPATIBLE_WITH,
)

# ─── Geode (WebGPU) WASM build ─────────────────────────────────────────

# Internal cc_binary for the Geode backend. Uses ASYNCIFY so that the
# synchronous GeodeDevice creation + buffer-map readback can yield to
# the browser's async WebGPU implementation.
cc_binary(
    name = "donner_wasm_geode_bin",
    srcs = [
        "WasmBridgeUtils.h",
        "wasm_bridge_geode.cc",
    ],
    additional_linker_inputs = ["//donner/gpu/browser:library_donner_gpu.js"],
    linkopts = [
        "-sMODULARIZE=1",
        "-sEXPORT_ES6=1",
        "-sENVIRONMENT=web",
        "-sALLOW_MEMORY_GROWTH=1",
        "-sASYNCIFY=1",
        "-sASYNCIFY_STACK_SIZE=131072",
        "-sEXPORTED_RUNTIME_METHODS=ccall,cwrap,UTF8ToString,HEAPU8",
        "-sUSE_PTHREADS=0",
        "-sSTACK_SIZE=1048576",
        "--no-entry",
        "--js-library=$(execpath //donner/gpu/browser:library_donner_gpu.js)",
    ] + select({
        "//donner/svg/renderer:text_enabled": ["-sEXPORTED_FUNCTIONS=_donner_geode_init,_donner_geode_render_svg,_donner_geode_render_svg_len,_donner_free_pixels,_donner_get_last_error,_malloc,_free,_donner_prepare_resources"],
        "//conditions:default": ["-sEXPORTED_FUNCTIONS=_donner_geode_init,_donner_geode_render_svg,_donner_geode_render_svg_len,_donner_free_pixels,_donner_get_last_error,_malloc,_free"],
    }),
    tags = ["manual"],
    target_compatible_with = _WASM_GEODE_COMPATIBLE_WITH,
    deps = [
        "//donner/svg",
        "//donner/svg/parser",
        "//donner/svg/renderer",
    ],
)

# Extracts .js + .wasm artefacts from the Geode Emscripten cc_binary.
wasm_cc_binary(
    name = "donner_wasm_geode",
    cc_target = ":donner_wasm_geode_bin",
    outputs = [
        "donner_wasm_geode_bin.js",
        "donner_wasm_geode_bin.wasm",
    ],
    tags = ["codeql_wasm_geode"],
    target_compatible_with = _WASM_GEODE_COMPATIBLE_WITH,
)

# The standalone Geode module must select Donner's browser runtime in its normal Wasm config.
no_rust_dependency_audit_test(
    name = "geode_browser_default_audit_test",
    size = "small",
    required = [
        "//donner/gpu/browser:browser_device",
        "//donner/gpu/browser:emscripten_browser_bridge",
    ],
    tags = ["manual"],
    target = ":donner_wasm_geode",
)

# Complete Geode test page and its optional text assets.
alias(
    name = "test_page_geode",
    actual = ":geode_browser_test_package",
    target_compatible_with = _WASM_GEODE_COMPATIBLE_WITH,
)

# The standalone browser test page applies its own transition so the host Playwright test can
# build it under the same Browser setting as the normal --config=wasm-geode module.
web_package(
    name = "geode_browser_test_package",
    srcs = [
        "renderer-resources.js",
        "test-geode.html",
    ] + _TEXT_RESOURCE_SUPPORT,
    asset_trees = _TEXT_RESOURCE_TREES,
    tags = ["manual"],
    target_compatible_with = _WASM_GEODE_COMPATIBLE_WITH,
    wasm_deps = [":donner_wasm_geode"],
)

geode_browser_test_package(
    name = "_geode_browser_test_package_for_playwright",
    package = ":geode_browser_test_package",
    visibility = ["//donner/editor/wasm/tests:__pkg__"],
)

# `bazel run :serve_test_geode` starts a local HTTP server at
# http://localhost:8000/test-geode.html with CORS/COOP/COEP headers set so
# the Emscripten WebGPU runtime can use SharedArrayBuffer-backed ASYNCIFY.
# Build artefacts and the test page are served from the same directory.
serve_http(
    name = "serve_test_geode",
    dir = ":test_page_geode",
    tags = ["manual"],
    target_compatible_with = _WASM_GEODE_COMPATIBLE_WITH,
)

# Same, but for the tiny-skia test page (`test.html`).
serve_http(
    name = "serve_test",
    dir = ":test_page",
    tags = ["manual"],
    target_compatible_with = _WASM_TINY_SKIA_COMPATIBLE_WITH,
)

# Observe the real private fixture transition even under smaller or fuller ambient text tiers.
geode_browser_config_probe(
    name = "_ambient_config_probe",
    testonly = True,
)

geode_browser_test_package(
    name = "_basic_text_config_probe",
    testonly = True,
    package = ":_ambient_config_probe",
)

py_test(
    name = "geode_browser_test_transition_test",
    size = "small",
    srcs = ["geode_browser_test_transition_test.py"],
    args = ["$(rootpath :_basic_text_config_probe)"],
    data = [":_basic_text_config_probe"],
)

js_test(
    name = "renderer_resource_bootstrap_test",
    size = "small",
    copy_data_to_bin = False,
    data = [
        "renderer-resources.js",
        "renderer-resources.spec.mjs",
        "//donner/editor/wasm:catalog-fonts.js",
        "//donner/editor/wasm:packaged-resource-loader.js",
    ],
    entry_point = "renderer-resources.spec.mjs",
    env = {"NODE_OPTIONS": ""},
    node_options = ["--test"],
)
