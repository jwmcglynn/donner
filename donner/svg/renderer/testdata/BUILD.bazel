load("//build_defs:package.bzl", "donner_package")

filegroup(
    name = "testdata",
    srcs = glob([
        "*.svg",
        # Time-varying fixtures stay out of the root steady-state Geode corpus.
        "animation/*.svg",
        "golden/*.png",
        # Per-backend goldens (e.g., Geode's Slug output differs from the
        # scanline rasterizer goldens in `golden/`, so it has its own set).
        "golden/*/*.png",
    ]) + [
        "//:logo_svgs",
    ],
    visibility = [
        "//donner:__subpackages__",
    ],
)

donner_package()
