filegroup(
    name = "testdata",
    srcs = glob([
        "*.svg",
        # Time-varying fixtures stay out of the root steady-state Geode corpus.
        "animation/*.svg",
        # Synthetic comparison fixtures are loaded by focused regressions, not corpus scenes.
        "regressions/*.svg",
        "golden/*.png",
        "http_resources/*.png",
        "http_resources/*.svg",
        # Per-backend goldens (e.g., Geode's Slug output differs from the
        # scanline rasterizer goldens in `golden/`, so it has its own set).
        "golden/*/*.png",
    ]) + [
        "//:logo_svgs",
    ],
    visibility = [
        "//donner:__subpackages__",
    ],
)

filegroup(
    name = "animation_fixtures",
    srcs = [
        "animation/de_casteljau.svg",
        "animation/world_lock_jitter.svg",
        "animation/world_lock_swim.svg",
    ],
    visibility = ["//donner/svg/renderer/tests:__pkg__"],
)
