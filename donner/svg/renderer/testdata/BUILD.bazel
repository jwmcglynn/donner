load("//build_defs:rules.bzl", "ci_darwin_targets")
filegroup(
    name = "testdata",
    srcs = glob([
        "*.svg",
        # Time-varying fixtures stay out of the root steady-state Geode corpus.
        "animation/*.svg",
        # Synthetic comparison fixtures are loaded by focused regressions, not corpus scenes.
        "regressions/*.svg",
        "golden/*.png",
        "http_resources/*.png",
        "http_resources/*.svg",
        # Per-backend goldens (e.g., Geode's Slug output differs from the
        # scanline rasterizer goldens in `golden/`, so it has its own set).
        "golden/*/*.png",
    ]) + [
        "http_resources/SOURCES.md",
        "//:logo_svgs",
    ],
    visibility = [
        "//donner:__subpackages__",
    ],
)

filegroup(
    name = "animation_fixtures",
    srcs = [
        "animation/de_casteljau.svg",
        "animation/world_lock_jitter.svg",
        "animation/world_lock_swim.svg",
    ],
    visibility = ["//donner/svg/renderer/tests:__pkg__"],
)

# The goldens and their README, read by the parity report tests to check each registered golden's
# documented SHA-256.
filegroup(
    name = "resvg_golden_documentation",
    srcs = glob([
        "golden/*.png",
        "golden/*/*.png",
    ]) + ["golden/README.md"],
    visibility = ["//tools/resvg_parity:__pkg__"],
)

ci_darwin_targets()
