# Transition wrapper: flips renderer_backend=geode + enable_geode=true so this
# target is reachable from `bazel test //...` without --config=geode.
donner_multi_transitioned_test(
    name = "renderer_geode_golden_tests",
    # Software WebGPU (llvmpipe) rendering is slow in fastbuild; the Lion
    # golden alone can exceed 300 s on aarch64 runners. Cap explicitly at
    # 900 s so a driver hang (e.g., Intel Arc + Mesa 25.2.8 Xe-KMD) gets
    # killed in 15 min instead of rolling up to the default 3600 s.
    size = "large",
    timeout = "long",
    testonly = 1,
    dep = ":renderer_geode_golden_tests_impl",
    opens_gpu_device = True,
    # NO platform pin. A remote-execution platform property is a HARD match
    # requirement: if no worker in the pool advertises it, the action queues
    # forever with no timeout and no diagnostic (the per-test timeout only
    # starts once a test RUNS). A `gpu` property pinned this suite to a worker
    # class the Linux CI pool does not provide, and every self-hosted run since
    # then burned its whole job budget parked in the scheduler queue on this
    # target and its siblings. This suite is designed to run on software WebGPU
    # (Mesa lavapipe / llvmpipe) exactly as the comments in this file describe,
    # and it additionally runs on real GPU hardware on the macOS lanes, where
    # `bazel test //...` selects the platform's native adapter. Do not
    # reintroduce a platform pin without first proving a matching worker class
    # exists AND adding a bounded-queue guard.
    renderer_backend = "geode",
)

