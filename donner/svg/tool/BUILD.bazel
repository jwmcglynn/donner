load("//build_defs:dep_audit.bzl", "configured_dependency_audit_test", "forbidden_transitive_dep_test")
load("//build_defs:packaged_resources.bzl", "packaged_resource_bundle")
load(
    "//build_defs:rules.bzl",
    "donner_cc_binary",
    "donner_cc_fuzzer",
    "donner_cc_library",
    "donner_cc_test",
    "identical_code_folding_linkopts",
)
load("//tools/rust_boundary:dependency_audit.bzl", "no_rust_dependency_audit_test")

alias(
    name = "tool",
    actual = ":donner-cli",
)

alias(
    name = "donner-svg",
    actual = ":donner-cli",
    deprecation = "Use :donner-cli; this alias will be removed at the next breaking version.",
)

donner_cc_library(
    name = "donner_svg_tool_utils",
    srcs = ["DonnerSvgToolUtils.cc"],
    hdrs = ["DonnerSvgToolUtils.h"],
    visibility = ["//visibility:private"],
    deps = [
        "//donner/base",
        "//donner/svg",
        "//donner/svg/renderer:renderer_interface",
    ],
)

packaged_resource_bundle(
    name = "cli_resource_bundle",
    output_name = "donner-assets",
    resources = select({
        "//donner/svg/renderer:text_enabled": ["//third_party/public-sans:public-sans_resource_files"],
        "//conditions:default": [],
    }),
)

donner_cc_binary(
    name = "donner-cli",
    srcs = ["donner_svg_tool.cc"],
    data = select({
        "//donner/svg/renderer:text_enabled": [":cli_resource_bundle"],
        "//conditions:default": [],
    }),
    linkopts = identical_code_folding_linkopts(),
    tags = [
        "codeql_default",
        "codeql_text_full",
    ],
    visibility = ["//tools/ci:__pkg__"],
    deps = [
        ":donner_svg_tool_lib",
        "//donner/base:failure_signal_handler",
    ],
)

no_rust_dependency_audit_test(
    name = "donner_svg_no_rust_dependency_audit_test",
    size = "small",
    required = ["//donner/svg/renderer:renderer_tiny_skia"],
    target = ":donner-cli",
)

donner_cc_library(
    name = "donner_svg_tool_lib",
    srcs = ["DonnerSvgTool.cc"],
    hdrs = ["DonnerSvgTool.h"],
    visibility = ["//visibility:private"],
    deps = [
        ":donner_svg_tool_utils",
        "//donner/base:diagnostic_renderer",
        "//donner/base:packaged_resource",
        "//donner/base/parser",
        "//donner/css:core",
        "//donner/css/parser",
        "//donner/svg",
        "//donner/svg/renderer:gif_encoder",
        # The CLI renders exactly one frame per invocation, so the GPU
        # backend's fixed device and shader setup cost can never amortize;
        # the CPU (tiny-skia) backend is strictly faster for one-shot
        # rendering. Depend on the CPU backend directly instead of the
        # config-selected //donner/svg/renderer dispatcher so the CLI never
        # links the GPU stack, under any build config. Enforced by
        # :donner_svg_excludes_geode_audit below.
        "//donner/svg/renderer:renderer_tiny_skia",
        "//donner/svg/renderer:terminal_image_viewer",
    ],
)

donner_cc_test(
    name = "donner_svg_tool_utils_tests",
    srcs = ["DonnerSvgToolUtils_tests.cc"],
    deps = [
        ":donner_svg_tool_utils",
        "//donner/svg/parser",
        "//donner/svg/renderer:terminal_image_viewer",
        "@com_google_gtest//:gtest_main",
    ],
)

donner_cc_fuzzer(
    name = "donner_svg_tool_utils_fuzzer",
    srcs = ["DonnerSvgToolUtils_fuzzer.cc"],
    corpus = "testdata/donner_svg_tool_utils_corpus",
    deps = [":donner_svg_tool_utils"],
)

donner_cc_test(
    name = "donner_svg_tool_tests",
    srcs = ["DonnerSvgTool_tests.cc"],
    deps = [
        ":donner_svg_tool_lib",
        "//donner/editor/tests:bitmap_golden_compare",
        "//donner/svg/renderer/tests:gif_test_decoder",
        "@com_google_gtest//:gtest_main",
    ],
)

# The one-shot CLI must never link the GPU (Geode) backend: a single
# rendered frame cannot amortize GPU device and shader setup, so the CPU
# backend is the CLI renderer under every build config, including
# --config=geode. somepath() over the unconfigured graph is meaningful
# here because nothing in the CLI's dep list reaches the config-selected
# //donner/svg/renderer dispatcher (see build_defs/dep_audit.bzl).
forbidden_transitive_dep_test(
    name = "donner_svg_excludes_geode_audit",
    size = "small",
    forbidden = "//donner/svg/renderer:renderer_geode",
    tags = [
        "audit",
        "deps",
    ],
    target = "//donner/svg/tool:donner-cli",
)

[
    configured_dependency_audit_test(
        name = "donner_cli_" + tier + "_resources_audit",
        forbidden = [
            "//donner/svg/tool:cli_resource_bundle",
            "//donner/svg/resources:generic_sans_faces_resource_files",
            "//third_party/google_fonts:catalog_resource_files",
            "//third_party/public-sans:public-sans_resource_files",
        ] if tier == "none" else [],
        required = [
            "//donner/svg/tool:donner-cli",
            "//donner/svg/renderer:renderer_tiny_skia",
        ] + ([
            "//donner/svg/tool:cli_resource_bundle",
            "//donner/svg/resources:font_manager",
            "//third_party/public-sans:public-sans_resource_files",
        ] if tier != "none" else []),
        target = ":donner-cli",
        text_configuration = tier,
    )
    for tier in ("none", "basic", "full")
]
