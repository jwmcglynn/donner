# Lightweight font-catalog interface + value types. Depended on by both the core
# FontManager (so it can resolve through an injected provider without pulling in
# any font bytes) and the concrete FontCatalog (editor).
donner_cc_library(
    name = "font_catalog_types",
    hdrs = ["FontCatalogTypes.h"],
    visibility = [
        "//donner/editor:__subpackages__",
        "//donner/svg:__subpackages__",
    ],
    deps = ["//donner/svg/core"],
)

donner_cc_library(
    name = "font_manager",
    srcs = ["FontManager.cc"],
    hdrs = ["FontManager.h"],
    defines = select({
        "//donner/svg/renderer:text_full_enabled": ["DONNER_TEXT_WOFF2_ENABLED"],
        "//conditions:default": [],
    }),
    visibility = [
        "//donner/editor:__subpackages__",
        "//donner/svg:__subpackages__",
        "//tools/mcp-servers/editor-control:__pkg__",
    ],
    deps = [
        ":font_catalog_types",
        ":font_metadata",
        "//donner/base",
        "//donner/base/fonts",
        "//donner/base/fonts:sfnt_utils",
        "//donner/css:core",
        "//third_party/public-sans",
        "@stb//:truetype",
    ] + select({
        "//donner/svg/renderer:text_full_enabled": ["//donner/base/fonts:woff2_parser"],
        "//conditions:default": [],
    }),
)

embed_resources(
    name = "generic_sans_faces",
    header_output = "embed_resources/NotoSansGenericFaces.h",
    resources = {
        "kNotoSansBoldTtf": "//third_party/resvg-test-suite:fonts/NotoSans-Bold.ttf",
        "kNotoSansItalicTtf": "//third_party/resvg-test-suite:fonts/NotoSans-Italic.ttf",
        "kNotoSansRegularTtf": "//third_party/resvg-test-suite:fonts/NotoSans-Regular.ttf",
    },
)

# Concrete font catalog: curated bundled fonts plus platform system fonts. The editor installs
# this provider on FontManager. Wasm reuses the renderer's existing Public Sans fallback face
# for generic sans-serif; the larger native-only Noto faces and compiled catalog stay out of Wasm.
donner_cc_library(
    name = "font_catalog",
    srcs = [
        "CatalogEncodedFontStore.cc",
        "EmbeddedFontProvider.cc",
        "FontCatalog.cc",
        "SystemFontProvider.cc",
    ],
    hdrs = [
        "CatalogEncodedFontStore.h",
        "EmbeddedFontProvider.h",
        "FontCatalog.h",
        "SystemFontProvider.h",
    ],
    linkopts = select({
        "@platforms//os:macos": [
            "-framework",
            "CoreText",
            "-framework",
            "CoreFoundation",
        ],
        "//conditions:default": [],
    }),
    # The embedded font bytes come from dev-only http_file repos; BCR consumers
    # skip this target (and, transitively, the editor targets that consume it).
    target_compatible_with = select({
        "//third_party/google_fonts:google_fonts_enabled": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = [
        "//donner/editor:__subpackages__",
        "//donner/svg:__subpackages__",
        "//tools/mcp-servers/editor-control:__pkg__",
    ],
    deps = [
        ":font_catalog_types",
        "//donner/base",
        "//third_party/google_fonts:google_fonts_catalog_inc",
    ] + select({
        "@platforms//os:emscripten": ["//third_party/public-sans"],
        "//conditions:default": [
            ":generic_sans_faces",
            "//third_party/google_fonts:google_fonts_data",
        ],
    }),
)

