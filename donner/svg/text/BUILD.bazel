load("//build_defs:dep_audit.bzl", "configured_dependency_audit_test")
load("//build_defs:rules.bzl", "donner_cc_fuzzer", "donner_cc_library", "donner_cc_test", "donner_multi_transitioned_test")

donner_cc_library(
    name = "bidi_control",
    hdrs = ["BidiControl.h"],
    visibility = ["//donner/svg:__subpackages__"],
)

donner_cc_library(
    name = "bidi_types",
    hdrs = ["BidiParagraph.h"],
    visibility = ["//donner/svg:__subpackages__"],
    deps = [":bidi_control"],
)

donner_cc_library(
    name = "bidi_paragraph",
    srcs = ["BidiParagraph.cc"],
    visibility = ["//donner/svg:__subpackages__"],
    deps = [
        ":bidi_types",
        "@sheenbidi",
    ],
)

donner_cc_library(
    name = "text_types",
    hdrs = ["TextTypes.h"],
    visibility = ["//donner/svg:__subpackages__"],
    deps = [
        "//donner/svg/resources:font_manager",
    ],
)

donner_cc_library(
    name = "text_backend",
    hdrs = [
        "FontDataUtils.h",
        "TextBackend.h",
    ],
    visibility = ["//donner/svg:__subpackages__"],
    deps = [
        ":text_types",
        "//donner/base/fonts:sfnt_utils",
        "//donner/svg/core",
        "//donner/svg/resources:font_manager",
    ],
