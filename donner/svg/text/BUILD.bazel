    hdrs = ["TextLayoutParams.h"],
    visibility = ["//donner/svg:__subpackages__"],
    deps = [
        "//donner/base",
        "//donner/svg/core",
    ],
)

donner_cc_library(
    name = "text_backend_simple",
    srcs = ["TextBackendSimple.cc"],
    hdrs = ["TextBackendSimple.h"],
    defines = select({
        "//donner/svg/renderer:text_enabled": ["DONNER_TEXT_ENABLED"],
        "//conditions:default": [],
    }),
    visibility = ["//donner/svg:__subpackages__"],
    deps = [
        ":bidi_types",
        ":text_backend",
        "//donner/base",
        "//donner/svg/resources:font_manager",
        "@stb//:truetype",
    ] + select({
        "//donner/svg/renderer:text_enabled": [":bidi_paragraph"],
        "//conditions:default": [],
    }),
)

donner_cc_library(
    name = "text_engine",
    srcs = [
        "GraphemeBreak.cc",
        "TextEngine.cc",
        "TextTransform.cc",
    ],
    hdrs = [
        "FullWidthMapping.h",
        "GraphemeBreak.h",
        "GraphemeProperties.h",
        "TextEngine.h",
        "TextEngineHelpers.h",
        "TextPathWarp.h",
        "TextTransform.h",
    ],
    defines = select({
        "//donner/svg/renderer:text_enabled": ["DONNER_TEXT_ENABLED"],
        "//conditions:default": [],
    }) + select({
        "//donner/svg/renderer:text_full_enabled": ["DONNER_TEXT_FULL"],
        "//conditions:default": [],
    }),
    visibility = [
        "//donner/editor:__subpackages__",
        "//donner/svg:__subpackages__",
    ],
    deps = [
        ":bidi_types",
        ":text_backend",
        ":text_backend_simple",
        ":text_layout_params",
        ":text_types",
        "//donner/base",
        "//donner/base/xml/components",
        "//donner/svg/components:components_core",
        "//donner/svg/components/animation:animation_system",
        "//donner/svg/components/animation:components",
        "//donner/svg/components/animation:value_sampler",
        "//donner/svg/components/layout:layout_system",
        "//donner/svg/components/shape:components",
        "//donner/svg/components/style:components",
        "//donner/svg/components/text:components",
        "//donner/svg/components/text:text_invalidation",
        "//donner/svg/components/text:text_system",
        "//donner/svg/resources:font_manager",
    ] + select({
        "//donner/svg/renderer:text_enabled": [":bidi_paragraph"],
        "//conditions:default": [],
    }) + select({
        "//donner/svg/renderer:text_full_enabled": [":text_backend_full"],
        "//conditions:default": [],
    }),
)

configured_dependency_audit_test(
    name = "basic_text_engine_dependency_audit_test",
    forbidden = [
        "//donner/svg/text:text_backend_full",
        "@harfbuzz//:harfbuzz",
    ],
    required = [
        "//donner/svg/text:text_backend_simple",
        "//donner/svg/text:bidi_paragraph",
        "@sheenbidi//:sheenbidi",
    ],
    target = ":text_engine",
    text_configuration = "basic",
)

# text_backend_full is only pulled in from text_engine via a select() on
# :text_full_enabled. Gate the target itself so its @harfbuzz dep is only
# resolved when text_full is enabled — required for BCR consumers, where
# @harfbuzz is not declared (it lives in the dev-only non_bcr_deps module
# extension).
donner_cc_library(
    name = "text_backend_full",
    srcs = ["TextBackendFull.cc"],
    hdrs = [
        "BitmapGlyphUtils.h",
        "TextBackendFull.h",
    ],
    target_compatible_with = select({
        "//donner/svg/renderer:text_full_enabled": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = ["//donner/svg:__subpackages__"],
    deps = [
        ":text_backend",
        "//donner/base",
        "//donner/svg/resources:font_manager",
        "//third_party:freetype",
        "@harfbuzz",
    ],
)

donner_cc_test(
    name = "font_data_utils_tests",
    srcs = ["tests/FontDataUtils_tests.cc"],
    deps = [
        ":text_backend",
        "@com_google_gtest//:gtest_main",
    ],
)

donner_cc_fuzzer(
    name = "font_data_utils_fuzzer",
    srcs = ["tests/FontDataUtils_fuzzer.cc"],
    corpus = "tests/font_data_utils_corpus",
    deps = [":text_backend"],
)

filegroup(
    name = "bitmap_glyph_test_font",
    srcs = ["tests/font_decoder_corpus/bitmap_emoji_subset.ttf"],
    visibility = ["//donner/svg/renderer/tests:__pkg__"],
)

filegroup(
    name = "font_decoder_fuzzer_corpus",
    srcs = [
        # Single-glyph subset of NotoColorEmoji.ttf; see
        # //third_party/resvg-test-suite/fonts/Noto-LICENSE-OFL.txt.
        "tests/font_decoder_corpus/bitmap_emoji_subset.ttf",
        "tests/font_decoder_corpus/zero_length_sfnt_tables",
        "//donner/base/fonts:testdata/valid-001.woff",
        "//donner/base/fonts:testdata/valid-001.woff2",
        "//third_party/public-sans:PublicSans-Medium.otf",
    ] + glob(["tests/font_decoder_structured_corpus/*"]),
)

donner_cc_fuzzer(
    name = "font_decoder_fuzzer",
    srcs = ["tests/FontDecoder_fuzzer.cc"],
    corpus = ":font_decoder_fuzzer_corpus",
    defines = select({
        "//donner/svg/renderer:text_full_enabled": ["DONNER_TEXT_FULL"],
        "//conditions:default": [],
    }),
    tags = ["fuzz_text_full"],
    deps = [
        ":text_backend",
        "//donner/base",
        "//donner/base:runfiles",
        "//donner/base/fonts",
        "//donner/base/fonts:sfnt_utils",
        "//donner/svg/resources:font_manager",
    ] + select({
        "//donner/svg/renderer:text_full_enabled": [
            ":text_backend_full",
            "//donner/base/fonts:woff2_parser",
        ],
        "//conditions:default": [":text_backend_simple"],
    }),
)

donner_cc_test(
    name = "text_backend_full_bitmap_tests",
    srcs = ["tests/TextBackendFullBitmap_tests.cc"],
    data = ["tests/font_decoder_corpus/bitmap_emoji_subset.ttf"],
    target_compatible_with = select({
        "//donner/svg/renderer:text_full_enabled": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":text_backend_full",
        "//donner/base:base_test_utils",
        "//donner/svg/resources:font_manager",
        "@com_google_gtest//:gtest_main",
    ],
)

# Keep the BCR-incompatible full-text dependency behind the dev-only wrapper gate.
donner_multi_transitioned_test(
    name = "text_backend_full_bitmap_tests_text_full",
    testonly = 1,
    dep = ":text_backend_full_bitmap_tests",
    renderer_backend = "geode",
    tags = ["variant_text_full"],
    target_compatible_with = select({
        "//donner/svg/renderer:resvg_test_suite_enabled": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    text = "true",
    text_full = "true",
)

