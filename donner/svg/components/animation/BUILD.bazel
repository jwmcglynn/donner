load("//build_defs:rules.bzl", "donner_cc_library")

donner_cc_library(
    name = "components",
    hdrs = [
        "AnimateMotionComponent.h",
        "AnimateTransformComponent.h",
        "AnimateValueComponent.h",
        "AnimatedValuesComponent.h",
        "AnimationInterpolation.h",
        "AnimationResourceBudget.h",
        "AnimationStateComponent.h",
        "AnimationTimingComponent.h",
        "ClockValue.h",
        "SetAnimationComponent.h",
    ],
    visibility = [
        "//donner/svg:__subpackages__",
    ],
    deps = [
        "//donner/base",
    ],
)

donner_cc_library(
    name = "animation_system",
    srcs = [
        "AnimationBaseValue.cc",
        "AnimationInterpolation.cc",
        "AnimationMotion.cc",
        "AnimationSystem.cc",
        "AnimationTimeline.cc",
        "AnimationValueMath.cc",
        "AnimationValueSampler.cc",
    ],
    hdrs = [
        "AnimationBaseValue.h",
        "AnimationMotion.h",
        "AnimationNumericAttributes.h",
        "AnimationSystem.h",
        "AnimationTimeline.h",
        "AnimationValueMath.h",
        "AnimationValueSampler.h",
    ],
    visibility = [
        "//donner/svg:__subpackages__",
    ],
    deps = [
        ":components",
        "//donner/base",
        "//donner/base/parser",
        "//donner/base/xml/components",
        "//donner/css/parser",
        "//donner/svg/components:components_core",
        "//donner/svg/components:svg_document_context",
        "//donner/svg/components/filter:components",
        "//donner/svg/components/layout:layout_system",
        "//donner/svg/components/paint:components",
        "//donner/svg/components/resources:resource_manager_context",
        "//donner/svg/components/shadow:components",
        "//donner/svg/components/shape:components",
        "//donner/svg/components/style:components",
        "//donner/svg/components/text:components",
        "//donner/svg/core",
        "//donner/svg/parser:parser_core",
    ],
    # AnimationSystem::advance is referenced by //donner/svg/renderer:rendering_context
    # (RenderingContext.cc). Under gold (linker canary), RenderingContext.o is pulled
    # from its archive after libanimation_system.a has already been scanned, so gold
    # discards AnimationSystem.o and the reference goes undefined. lld tolerates this via
    # iterative archive resolution; gold does not. Force the object in via whole-archive.
    alwayslink = True,
)
