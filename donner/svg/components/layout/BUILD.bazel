load("//build_defs:rules.bzl", "donner_cc_library", "donner_cc_test")

donner_cc_library(
    name = "components",
    hdrs = [
        "SizedElementComponent.h",
        "SymbolComponent.h",
        "TransformComponent.h",
        "ViewBoxComponent.h",
    ],
    visibility = [
        "//donner/svg:__subpackages__",
    ],
    deps = [
        "//donner/svg/properties:property",
    ],
)

donner_cc_library(
    name = "layout_system",
    srcs = [
        "LayoutSystem.cc",
    ],
    hdrs = [
        "LayoutSystem.h",
    ],
    visibility = [
        "//donner/svg:__subpackages__",
        "//donner/svg/components:__subpackages__",
        "//donner/svg/properties:__pkg__",
    ],
    deps = [
        ":components",
        "//donner/base",
        "//donner/svg/components:components_core",
        "//donner/svg/components/paint:components",
        "//donner/svg/components/resources:resource_manager_context",
        "//donner/svg/components/shadow:components",
        "//donner/svg/components/style:components",
        "//donner/svg/components/style:style_system",
        "//donner/svg/properties:property_parsing",
    ],
)

donner_cc_test(
    name = "layout_system_tests",
    srcs = [
        "tests/LayoutSystem_tests.cc",
    ],
    # Variant lanes (doc 0031 M2.3): tiny / text_full / geode
    # wrappers run automatically under `bazel test //...`.
    variants = [
        "tiny",
        "text_full",
        "geode",
    ],
    deps = [
        ":layout_system",
        "//donner/base:base_test_utils",
        "//donner/svg/parser",
        "@com_google_gtest//:gtest_main",
    ],
)

# Source inputs for the GPU inventory ratchet (//tools/gpu_inventory). The
# manifests are derived from a lexical scan of these files, so they must be
# declared as real Bazel inputs for the check to be a cacheable test with
# correct change detection. See tools/gpu_inventory/README.md.
filegroup(
    name = "gpu_inventory_srcs",
    srcs = glob(
        [
            "**/*.h",
            "**/*.cc",
            "**/*.mm",
            "**/*.wgsl",
            "**/*.patch",
            "**/*.bzl",
            "BUILD.bazel",
        ],
        allow_empty = True,
    ),
    visibility = ["//tools/gpu_inventory:__pkg__"],
)
