load("//build_defs:rules.bzl", "donner_cc_test")

donner_cc_test(
    name = "sub_document_cache_tests",
    srcs = [
        "SubDocumentCache_tests.cc",
    ],
    # Variant lanes (doc 0031 M2.3): tiny / text_full / geode
    # wrappers run automatically under `bazel test //...`.
    variants = [
        "tiny",
        "text_full",
        "geode",
    ],
    deps = [
        "//donner/base:base_test_utils",
        "//donner/base/encoding:base64",
        "//donner/svg",
        "//donner/svg/components/resources:resource_manager_context",
        "@com_google_gtest//:gtest_main",
    ],
)

# Source inputs for the GPU inventory ratchet (//tools/gpu_inventory). The
# manifests are derived from a lexical scan of these files, so they must be
# declared as real Bazel inputs for the check to be a cacheable test with
# correct change detection. See tools/gpu_inventory/README.md.
filegroup(
    name = "gpu_inventory_srcs",
    srcs = glob(
        [
            "**/*.h",
            "**/*.cc",
            "**/*.mm",
            "**/*.wgsl",
            "**/*.patch",
            "**/*.bzl",
            "BUILD.bazel",
        ],
        allow_empty = True,
    ),
    visibility = ["//tools/gpu_inventory:__pkg__"],
)
