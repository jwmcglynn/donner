load("//build_defs:rules.bzl", "donner_cc_library")

donner_cc_library(
    name = "components",
    hdrs = [
        "ImageComponent.h",
    ],
    visibility = [
        "//donner/svg/components:__subpackages__",
    ],
    deps = [
        "//donner/base",
        "//donner/svg:svg_document_handle",
        "//donner/svg/properties:property_parsing",
        "//donner/svg/resources:image_resource",
    ],
)

donner_cc_library(
    name = "font_resource",
    hdrs = ["FontResource.h"],
    visibility = ["//donner/svg:__subpackages__"],
    deps = ["//donner/base/fonts"],
)

donner_cc_library(
    name = "resource_manager_context",
    srcs = [
        "ResourceManagerContext.cc",
        "SubDocumentCache.cc",
    ],
    hdrs = [
        "ResourceManagerContext.h",
        "SubDocumentCache.h",
    ],
    visibility = [
        "//donner/svg:__subpackages__",
    ],
    deps = [
        ":components",
        "//donner/css:core",
        "//donner/svg:svg_document_handle",
        "//donner/svg/resources:image_loader",
        "//donner/svg/resources:resource_loader_interface",
        "//donner/svg/resources:url_loader",
    ],
)

# Source inputs for the GPU inventory ratchet (//tools/gpu_inventory). The
# manifests are derived from a lexical scan of these files, so they must be
# declared as real Bazel inputs for the check to be a cacheable test with
# correct change detection. See tools/gpu_inventory/README.md.
filegroup(
    name = "gpu_inventory_srcs",
    srcs = glob(
        [
            "**/*.h",
            "**/*.cc",
            "**/*.mm",
            "**/*.wgsl",
            "**/*.patch",
            "**/*.bzl",
            "BUILD.bazel",
        ],
        allow_empty = True,
    ),
    visibility = ["//tools/gpu_inventory:__pkg__"],
)
