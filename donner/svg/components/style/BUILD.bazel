load("@rules_cc//cc:defs.bzl", "cc_library")
load(
    "//build_defs:rules.bzl",
    "donner_cc_fuzzer",
    "donner_cc_library",
    "donner_cc_test",
    "donner_perf_sensitive_cc_library",
)

cc_library(
    name = "components",
    hdrs = [
        "ComputedStyleComponent.h",
        "DoNotInheritFillOrStrokeTag.h",
        "StyleCascadeMetrics.h",
        "StyleComponent.h",
    ],
    visibility = [
        "//donner/svg:__subpackages__",
        "//donner/svg/components:__subpackages__",
    ],
    deps = [
        "//donner/svg/components:document_resource_family_budget",
        "//donner/svg/properties:property_parsing",
    ],
)

# Per-stylesheet index of candidate rules by the subject compound's id, class, attribute or type.
donner_cc_library(
    name = "rule_index",
    srcs = ["RuleIndex.cc"],
    hdrs = ["RuleIndex.h"],
    visibility = [
        "//donner/svg:__subpackages__",
        "//donner/svg/components:__subpackages__",
    ],
    deps = [
        "//donner/base",
        "//donner/css",
    ],
)

# The keys of an element's ancestors as the cascade walks them, kept in a counting Bloom filter,
# and the element view the rule index and the filter share.
donner_cc_library(
    name = "style_ancestor_filter",
    srcs = ["StyleAncestorFilter.cc"],
    hdrs = [
        "StyleAncestorFilter.h",
        "StyleElementView.h",
    ],
    visibility = [
        "//donner/svg:__subpackages__",
        "//donner/svg/components:__subpackages__",
    ],
    deps = [
        ":rule_index",
        "//donner/base",
        "//donner/base/xml",
        "//donner/svg/components:components_core",
        "//donner/svg/components/shadow:components",
    ],
)

cc_library(
    name = "style_system_headers",
    hdrs = [
        "ExternalUseStyleContext.h",
        "SelectorContent.h",
        "StyleSystem.h",
    ],
    visibility = [
        "//donner/svg:__pkg__",
        "//donner/svg/components/shape:__pkg__",
    ],
    deps = [
        ":components",
        "//donner/base",
        "//donner/css",
        "//donner/svg/components:components_core",
    ],
)

donner_perf_sensitive_cc_library(
    name = "matched_properties_cache",
    srcs = ["MatchedPropertiesCache.cc"],
    hdrs = ["MatchedPropertiesCache.h"],
    visibility = ["//donner/svg:__subpackages__"],
    deps = [
        ":components",
        "//donner/base",
        "//donner/css",
    ],
)

donner_perf_sensitive_cc_library(
    name = "style_system",
    srcs = [
        "PaintAnimationStyle.cc",
        "ScalarAnimationStyle.cc",
        "SelectorContent.cc",
        "StyleSystem.cc",
    ],
    hdrs = [
        "PaintAnimationStyle.h",
        "ScalarAnimationStyle.h",
    ],
    visibility = [
        "//donner/editor:__pkg__",
        "//donner/svg:__subpackages__",
        "//donner/svg/components:__subpackages__",
    ],
    deps = [
        ":components",
        ":matched_properties_cache",
        ":rule_index",
        ":style_ancestor_filter",
        ":style_system_headers",
        "//donner/base",
        "//donner/base/parser",
        "//donner/base/xml",
        "//donner/css",
        "//donner/svg/components:components_core",
        "//donner/svg/components/animation:components",
        "//donner/svg/components/animation:value_sampler",
        "//donner/svg/components/filter:components",
        "//donner/svg/components/paint:components",
        "//donner/svg/components/resources:resource_manager_context",
        "//donner/svg/components/shadow:components",
        "//donner/svg/components/text:components",
    ],
)

donner_cc_test(
    name = "matched_properties_cache_tests",
    srcs = ["tests/MatchedPropertiesCache_tests.cc"],
    deps = [
        ":matched_properties_cache",
        "@com_google_gtest//:gtest_main",
    ],
)

donner_cc_test(
    name = "rule_index_tests",
    srcs = ["tests/RuleIndex_tests.cc"],
    deps = [
        ":rule_index",
        "//donner/base",
        "//donner/css",
        "@com_google_gtest//:gtest_main",
    ],
)

# The cascade over the rule index's candidates must equal the cascade over every rule, and the
# cascade with the ancestor filter the cascade without it, for a stylesheet and an element tree
# built from the input.
donner_cc_fuzzer(
    name = "style_cascade_differential_fuzzer",
    srcs = ["tests/StyleCascadeDifferential_fuzzer.cc"],
    corpus = "tests/style_cascade_differential_corpus",
    deps = [
        ":style_system",
        "//donner/base",
        "//donner/base/xml",
        "//donner/svg",
        "//donner/svg/components",
        "//donner/svg/components/shadow:shadow_tree_system",
        "//donner/svg/parser",
        "//donner/svg/renderer:rendering_context",
    ],
)

donner_cc_test(
    name = "style_ancestor_filter_tests",
    srcs = ["tests/StyleAncestorFilter_tests.cc"],
    deps = [
        ":rule_index",
        ":style_ancestor_filter",
        "//donner/base:base_test_utils",
        "//donner/svg/components/shadow:shadow_tree_system",
        "//donner/svg/parser",
        "@com_google_gtest//:gtest_main",
    ],
)

# Seeded random documents and selectors: the ancestor filter never rejects a rule the cascade
# matches.
donner_cc_test(
    name = "style_ancestor_filter_property_tests",
    srcs = ["tests/StyleAncestorFilterProperty_tests.cc"],
    deps = [
        ":rule_index",
        ":style_ancestor_filter",
        "//donner/base",
        "//donner/base/xml",
        "//donner/css",
        "//donner/svg",
        "//donner/svg/parser",
        "//donner/svg/renderer:rendering_context",
        "@com_google_gtest//:gtest_main",
    ],
)

donner_cc_test(
    name = "style_system_tests",
    srcs = [
        "tests/StyleSystem_tests.cc",
    ],
    # Variant lanes (doc 0031 M2.3): tiny / text_full / geode
    # wrappers run automatically under `bazel test //...`.
    variants = [
        "tiny",
        "text_full",
        "geode",
    ],
    deps = [
        ":style_ancestor_filter",
        ":style_system",
        "//donner/base:base_test_utils",
        "//donner/svg/components/animation:animation_system",
        "//donner/svg/components/animation:components",
        "//donner/svg/components/shadow:shadow_tree_system",
        "//donner/svg/parser",
        "@com_google_gtest//:gtest_main",
    ],
)
