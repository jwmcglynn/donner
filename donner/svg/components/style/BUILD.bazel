load("@rules_cc//cc:defs.bzl", "cc_library")
load("//build_defs:rules.bzl", "donner_cc_test", "donner_perf_sensitive_cc_library")

cc_library(
    name = "components",
    hdrs = [
        "ComputedStyleComponent.h",
        "DoNotInheritFillOrStrokeTag.h",
        "StyleComponent.h",
    ],
    visibility = [
        "//donner/svg:__subpackages__",
        "//donner/svg/components:__subpackages__",
    ],
    deps = [
        "//donner/svg/properties:property_parsing",
    ],
)

donner_perf_sensitive_cc_library(
    name = "style_system",
    srcs = [
        "PaintAnimationStyle.cc",
        "ScalarAnimationStyle.cc",
        "SelectorContent.cc",
        "StyleSystem.cc",
    ],
    hdrs = [
        "ExternalUseStyleContext.h",
        "PaintAnimationStyle.h",
        "ScalarAnimationStyle.h",
        "SelectorContent.h",
        "StyleSystem.h",
    ],
    visibility = [
        "//donner/editor:__pkg__",
        "//donner/svg:__subpackages__",
        "//donner/svg/components:__subpackages__",
    ],
    deps = [
        ":components",
        "//donner/base",
        "//donner/base/parser",
        "//donner/base/xml",
        "//donner/css",
        "//donner/svg/components:components_core",
        "//donner/svg/components/animation:components",
        "//donner/svg/components/animation:value_sampler",
        "//donner/svg/components/filter:components",
        "//donner/svg/components/paint:components",
        "//donner/svg/components/resources:resource_manager_context",
        "//donner/svg/components/shadow:components",
        "//donner/svg/components/text:components",
    ],
)

donner_cc_test(
    name = "style_system_tests",
    srcs = [
        "tests/StyleSystem_tests.cc",
    ],
    # Variant lanes (doc 0031 M2.3): tiny / text_full / geode
    # wrappers run automatically under `bazel test //...`.
    variants = [
        "tiny",
        "text_full",
        "geode",
    ],
    deps = [
        ":style_system",
        "//donner/base:base_test_utils",
        "//donner/svg/components/animation:animation_system",
        "//donner/svg/components/animation:components",
        "//donner/svg/components/shadow:shadow_tree_system",
        "//donner/svg/parser",
        "@com_google_gtest//:gtest_main",
    ],
)
