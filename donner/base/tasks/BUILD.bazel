load("//build_defs:rules.bzl", "donner_cc_binary", "donner_cc_library", "donner_cc_test")

package(default_visibility = ["//donner/base/tasks:__subpackages__"])

donner_cc_library(
    name = "false_sharing",
    hdrs = ["FalseSharing.h"],
)

donner_cc_library(
    name = "work_stealing_deque",
    hdrs = ["WorkStealingDeque.h"],
    deps = [
        ":false_sharing",
        "//donner/base",
    ],
)

donner_cc_library(
    name = "parker",
    hdrs = ["Parker.h"],
    deps = ["//donner/base"],
)

donner_cc_library(
    name = "task_record",
    hdrs = ["TaskRecord.h"],
    deps = [
        ":false_sharing",
        ":parker",
        "//donner/base",
    ],
)

donner_cc_library(
    name = "parker_pool",
    srcs = ["ParkerPool.cc"],
    hdrs = ["ParkerPool.h"],
    deps = [
        ":false_sharing",
        ":parker",
        "//donner/base",
    ],
)

donner_cc_library(
    name = "worker_stack",
    srcs = ["WorkerStack.cc"],
    hdrs = ["WorkerStack.h"],
    deps = ["//donner/base"],
)

donner_cc_library(
    name = "task_scheduler",
    srcs = [
        "TaskScheduler.cc",
        "TaskScope.cc",
    ],
    hdrs = [
        "TaskScheduler.h",
        "TaskScope.h",
    ],
    deps = [
        ":false_sharing",
        ":parker",
        ":parker_pool",
        ":task_record",
        ":work_stealing_deque",
        ":worker_stack",
        "//donner/base",
    ],
)

donner_cc_test(
    name = "deque_tests",
    srcs = ["tests/WorkStealingDeque_tests.cc"],
    deps = [
        ":work_stealing_deque",
        "//donner/base:stall_guard",
        "@com_google_gtest//:gtest_main",
    ],
)

donner_cc_test(
    name = "parker_tests",
    srcs = ["tests/Parker_tests.cc"],
    deps = [
        ":parker",
        "//donner/base:gtest_timeout_main",
        "//donner/base:stall_guard",
        "@com_google_gtest//:gtest",
    ],
)

donner_cc_library(
    name = "scheduler_test_utils",
    testonly = 1,
    hdrs = ["tests/SchedulerTestUtils.h"],
    deps = [
        ":task_scheduler",
        "//donner/base:stall_guard",
    ],
)

donner_cc_test(
    name = "task_scheduler_tests",
    srcs = ["tests/TaskScheduler_tests.cc"],
    deps = [
        ":scheduler_test_utils",
        ":task_scheduler",
        "//donner/base:gtest_timeout_main",
        "//donner/base:stall_guard",
        "@com_google_gtest//:gtest",
    ],
)

donner_cc_test(
    name = "task_scope_tests",
    srcs = ["tests/TaskScope_tests.cc"],
    deps = [
        ":parker_pool",
        ":scheduler_test_utils",
        ":task_scheduler",
        "//donner/base:gtest_timeout_main",
        "//donner/base:stall_guard",
        "@com_google_gtest//:gtest",
    ],
)

donner_cc_test(
    name = "worker_stack_tests",
    srcs = ["tests/WorkerStack_tests.cc"],
    deps = [
        ":scheduler_test_utils",
        ":task_scheduler",
        ":worker_stack",
        "//donner/base:gtest_timeout_main",
        "@com_google_gtest//:gtest",
    ],
)

donner_cc_test(
    name = "parker_pool_tests",
    srcs = ["tests/ParkerPool_tests.cc"],
    deps = [
        ":parker_pool",
        ":scheduler_test_utils",
        "//donner/base:gtest_timeout_main",
        "@com_google_gtest//:gtest",
    ],
)

# The main thread waits on a scope and destroys the scheduler before returning; its parker entry
# is destroyed after main() returns. Meaningful under AddressSanitizer.
donner_cc_test(
    name = "scope_main_thread_exit_test",
    srcs = ["tests/ScopeMainThreadExit.cc"],
    deps = [":task_scheduler"],
)

donner_cc_test(
    name = "task_record_tests",
    srcs = ["tests/TaskRecord_tests.cc"],
    deps = [
        ":task_record",
        "//donner/base:gtest_timeout_main",
        "//donner/base:stall_guard",
        "@com_google_gtest//:gtest",
    ],
)

# Wake latency of a parked thread for word types the standard library waits on natively and through
# its contention table. A performance probe that prints a table; run it with `bazel run -c opt`.
donner_cc_binary(
    name = "parker_wait_bench",
    testonly = 1,
    srcs = ["tests/ParkerWaitBench.cc"],
    tags = ["manual"],
)
