# The main thread waits on a scope and destroys the scheduler before returning; its parker entry
# is destroyed after main() returns. Meaningful under AddressSanitizer.
donner_cc_test(
    name = "scope_main_thread_exit_test",
    srcs = ["tests/ScopeMainThreadExit.cc"],
    deps = [":task_scheduler"],
)

donner_cc_test(
    name = "task_record_tests",
    srcs = ["tests/TaskRecord_tests.cc"],
    deps = [
        ":task_record",
        "//donner/base:gtest_timeout_main",
        "//donner/base:stall_guard",
        "@com_google_gtest//:gtest",
    ],
)

# Wake latency of a parked thread for word types the standard library waits on natively and through
# its contention table. A performance probe that prints a table; run it with `bazel run -c opt`.
donner_cc_binary(
    name = "parker_wait_bench",
    testonly = 1,
    srcs = ["tests/ParkerWaitBench.cc"],
    tags = ["manual"],
)

donner_cc_binary(
    name = "parallel_for_scaling_bench",
    testonly = 1,
    srcs = ["tests/ParallelForScalingBench.cc"],
    tags = [
        "manual",
        "perf",
    ],
    deps = [
        ":scheduler_test_utils",
        ":task_scheduler",
    ],
)

# Ordinary CI compiles the benchmark on its native platforms. Running it is a manual measurement.
filegroup(
    name = "parallel_for_scaling_bench_build",
    testonly = True,
    srcs = [":parallel_for_scaling_bench"],
)
