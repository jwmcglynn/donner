load("//build_defs:rules.bzl", "donner_cc_binary", "donner_cc_library", "donner_cc_test")

package(default_visibility = ["//donner/base/tasks:__subpackages__"])

donner_cc_library(
    name = "work_stealing_deque",
    hdrs = ["WorkStealingDeque.h"],
    deps = ["//donner/base"],
)

donner_cc_library(
    name = "parker",
    hdrs = ["Parker.h"],
    deps = ["//donner/base"],
)

donner_cc_library(
    name = "task_record",
    hdrs = ["TaskRecord.h"],
    deps = [
        ":parker",
        "//donner/base",
    ],
)

donner_cc_library(
    name = "task_scheduler",
    srcs = ["TaskScheduler.cc"],
    hdrs = ["TaskScheduler.h"],
    deps = [
        ":parker",
        ":task_record",
        ":work_stealing_deque",
        "//donner/base",
    ],
)

donner_cc_test(
    name = "deque_tests",
    srcs = ["tests/WorkStealingDeque_tests.cc"],
    deps = [
        ":work_stealing_deque",
        "//donner/base:stall_guard",
        "@com_google_gtest//:gtest_main",
    ],
)

donner_cc_test(
    name = "parker_tests",
    srcs = ["tests/Parker_tests.cc"],
    deps = [
        ":parker",
        "//donner/base:gtest_timeout_main",
        "//donner/base:stall_guard",
        "@com_google_gtest//:gtest",
    ],
)

donner_cc_test(
    name = "task_scheduler_tests",
    srcs = ["tests/TaskScheduler_tests.cc"],
    deps = [
        ":task_scheduler",
        "//donner/base:gtest_timeout_main",
        "//donner/base:stall_guard",
        "@com_google_gtest//:gtest",
    ],
)

donner_cc_test(
    name = "task_record_tests",
    srcs = ["tests/TaskRecord_tests.cc"],
    deps = [
        ":task_record",
        "//donner/base:gtest_timeout_main",
        "//donner/base:stall_guard",
        "@com_google_gtest//:gtest",
    ],
)

# Wake latency of a parked thread for word types the standard library waits on natively and through
# its contention table. A performance probe that prints a table; run it with `bazel run -c opt`.
donner_cc_binary(
    name = "parker_wait_bench",
    testonly = 1,
    srcs = ["tests/ParkerWaitBench.cc"],
    tags = ["manual"],
)
