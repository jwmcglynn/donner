load("//build_defs:rules.bzl", "donner_cc_library", "donner_cc_test")
load("//build_defs:visibility.bzl", "donner_internal_visibility")

donner_cc_library(
    name = "element",
    hdrs = [
        "ElementLike.h",
        "ElementTraversalGenerators.h",
    ],
    visibility = donner_internal_visibility(),
    deps = [
        "//donner/base",
        "//donner/base/xml:xml_qualified_name",
    ],
)

donner_cc_library(
    name = "fake_element",
    testonly = 1,
    hdrs = [
        "tests/FakeElement.h",
    ],
    visibility = donner_internal_visibility() + [
        "//examples:__pkg__",
    ],
    deps = [
        "@com_google_gtest//:gtest",
    ],
)

donner_cc_test(
    name = "element_tests",
    srcs = [
        "tests/ElementTraversalGenerators_tests.cc",
        "tests/FakeElement_tests.cc",
    ],
    deps = [
        ":element",
        ":fake_element",
        "//donner/base:base_test_utils",
        "@com_google_gtest//:gtest_main",
    ],
)

# Source inputs for the GPU inventory ratchet (//tools/gpu_inventory). The
# manifests are derived from a lexical scan of these files, so they must be
# declared as real Bazel inputs for the check to be a cacheable test with
# correct change detection. See tools/gpu_inventory/README.md.
filegroup(
    name = "gpu_inventory_srcs",
    srcs = glob(
        [
            "**/*.h",
            "**/*.cc",
            "**/*.mm",
            "**/*.wgsl",
            "**/*.patch",
            "**/*.bzl",
            "BUILD.bazel",
        ],
        allow_empty = True,
    ),
    visibility = ["//tools/gpu_inventory:__pkg__"],
)
