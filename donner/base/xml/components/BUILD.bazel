load("//build_defs:rules.bzl", "donner_cc_library", "donner_cc_test")

donner_cc_library(
    name = "components",
    srcs = [
        "AttributesComponent.cc",
        "TreeComponent.cc",
    ],
    hdrs = [
        "AttributesComponent.h",
        "EntityDeclarationsContext.h",
        "TreeComponent.h",
        "TreeMutationContext.h",
        "XMLDocumentContext.h",
        "XMLNamespaceContext.h",
        "XMLValueComponent.h",
    ],
    visibility = [
        "//donner/base/xml:__subpackages__",
        "//donner/svg:__subpackages__",
    ],
    deps = [
        "//donner/base",
        "//donner/base/xml:xml_qualified_name",
    ],
)

donner_cc_test(
    name = "components_tests",
    srcs = [
        "tests/AttributesComponent_tests.cc",
        "tests/TreeComponent_tests.cc",
    ],
    deps = [
        ":components",
        "//donner/base:base_test_utils",
        "@com_google_gtest//:gtest_main",
    ],
)

# Source inputs for the GPU inventory ratchet (//tools/gpu_inventory). The
# manifests are derived from a lexical scan of these files, so they must be
# declared as real Bazel inputs for the check to be a cacheable test with
# correct change detection. See tools/gpu_inventory/README.md.
filegroup(
    name = "gpu_inventory_srcs",
    srcs = glob(
        [
            "**/*.h",
            "**/*.cc",
            "**/*.mm",
            "**/*.wgsl",
            "**/*.patch",
            "**/*.bzl",
            "BUILD.bazel",
        ],
        allow_empty = True,
    ),
    visibility = ["//tools/gpu_inventory:__pkg__"],
)
