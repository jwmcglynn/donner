# Preserve upstream notices and patch context byte-for-byte.
third_party/google_fonts/licenses/*.txt -text -whitespace
third_party/woff2_bounded_decode.patch -text -whitespace
third_party/patches/emsdk_declared_java_runtime.patch -text -whitespace

# Keep the local Bazel convenience symlink out of source releases.
/external export-ignore

# The docs site unpacks the coverage report from the checkout; Bazel consumers never read it.
/docs/reports/coverage.zip export-ignore

# Preserve the official harness patch context; git apply checks its payload whitespace.
tools/svg_suite/vdiff/donner-registration.patch -text -whitespace
