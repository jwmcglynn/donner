##
## Platform definitions
##
## Named target platforms for local and remote Bazel builds.

load("//build_defs:package.bzl", "donner_package")

##
## Main library
##
load("//build_defs:rules.bzl", "donner_cc_library")

platform(
    name = "linux_aarch64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
)

platform(
    name = "linux_x86_64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

platform(
    name = "macos_aarch64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:aarch64",
    ],
)

#
# Donner main library, packages together the SVG library and associated renderer.
#
donner_cc_library(
    name = "donner",
    visibility = ["//visibility:public"],
    deps = [
        "//donner/svg/renderer",
    ],
)

##
## Devtools
##

filegroup(
    name = "clang_tidy_config",
    srcs = [".clang-tidy"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "github_action_definitions",
    srcs = glob([
        ".github/actions/*/action.yml",
        ".github/workflows/*.yaml",
        ".github/workflows/*.yml",
    ]),
    visibility = ["//tools:__pkg__"],
)

exports_files(
    [
        "donner_icon.svg",
        "donner_splash.svg",
        "BUILD.bazel",
        "MODULE.bazel",
        ".github/actions/apt-install/action.yml",
        ".github/actions/re-turnstile/action.yml",
        ".github/actions/re-turnstile/admission.py",
        ".github/workflows/cmake.yml",
        ".github/workflows/codeql.yml",
        ".github/workflows/coverage.yml",
        ".github/workflows/editor_wasm.yml",
        ".github/workflows/fuzz.yml",
        ".github/workflows/lint.yml",
        ".github/workflows/main.yml",
        ".github/workflows/sanitizers.yml",
        ".bazelversion",
        ".bazelrc",
        "zoom-out-drag-jump.rnr",
    ],
    visibility = ["//visibility:public"],
)

config_setting(
    name = "debug_build",
    values = {"compilation_mode": "dbg"},
)

config_setting(
    name = "fast_build",
    values = {"compilation_mode": "fastbuild"},
)

config_setting(
    name = "release_build",
    values = {"compilation_mode": "opt"},
)

filegroup(
    name = "docs_files",
    srcs = glob([
        "docs/**/*.md",
        "docs/**/*.svg",
    ]),
    visibility = ["//tools:__pkg__"],
)

# Logo SVGs, which are consumed by the renderer tests.
filegroup(
    name = "logo_svgs",
    srcs = glob([
        "*.svg",
    ]),
    visibility = [
        "//donner:__subpackages__",
    ],
)

donner_package(gpu_inventory_globs = [
    "MODULE.bazel",
    ".bazelrc",
])
