##
## Donner build config
##
## Options:
##
##   --config=latest_llvm       - Build with LLVM toolchain (downloads automatically)
##   --config=lld               - Force the lld linker; workaround for dev boxes whose
##                                 default linker can't link the suite (see docs/building.md).
##   --config=debug             - Build debug with configs set to simplify debugging.
##   --config=binary-size       - Common optimized build and symbols for binary size analysis.
##   --config=linux-binary-size - Binary size analysis with Linux linker size flags.
##   --config=macos-binary-size - Binary size analysis with macOS linker size flags.
##   --config=coverage          - Build with code coverage instrumentation.
##   --config=asan              - Build with address sanitizer.
##   --config=ubsan             - Build with undefined behavior sanitizer.
##   --config=asan-fuzzer       - Build with address sanitizer and fuzzing engine.
##   --config=tsan              - Build with thread sanitizer.
##   --config=clang-tidy        - Build with clang-tidy checks.
##   --config=dev               - Disable renderer backend test transitions.
##   --config=wasm              - Build for WebAssembly via Emscripten.
##

# Opt out of usage reporting by third-party Bazel modules. aspect_tools_telemetry, which
# aspect_rules_js brings into the module graph, posts a usage report from developer machines and
# CI runners each time its repository rule runs. Without a MODULE.bazel.lock in the checkout,
# which is every fresh clone because the lockfile is not committed, it reports on the first
# invocation. DO_NOT_TRACK is the module's documented opt-out, and ASPECT_TOOLS_TELEMETRY=-all
# also turns off every collector; an empty ASPECT_TOOLS_TELEMETRY value turns them all back on.
# Workflows set the same variables, and //tools:supply_chain_policy_tests keeps both in place.
common --repo_env=DO_NOT_TRACK=1
common --repo_env=ASPECT_TOOLS_TELEMETRY=-all

# Enables using platform-specific configs such as build:linux and build:macos in this .bazelrc file
build --enable_platform_specific_config

# Recover within the active build when an action-cache entry references an
# input that has already been evicted from a remote content-addressable store.
# Keep one whole-build retry as a fallback for the experimental rewinding path,
# instead of allowing Bazel's default five retries to consume the CI budget.
build --rewind_lost_inputs
build --experimental_remote_cache_eviction_retries=1

# Reuse identical compile/archive actions across renderer and text configurations.
build --experimental_output_paths=strip
# Add mapping support without replacing other caller execution requirements.
build --incompatible_modify_execution_info_additive
build --modify_execution_info=CppCompile=+supports-path-mapping,CppArchive=+supports-path-mapping,CppModuleMap=+supports-path-mapping
# Emscripten response-file paths are not remapped; pass its arguments directly.
build --features=-compiler_param_file
build --features=-archive_param_file

##
## Build config
##

# rules_python has deprecated implicitly creating empty __init__.py files in
# the runfiles tree for py_binary/py_library/py_test targets (on by default
# today, will flip in a future release). Opt in to the future default
# repo-wide now: every py_binary/py_library/py_test in this repo (the
# generated per-target _lint checks plus tools/* and build_defs/*) builds and
# tests clean under this flag with no explicit __init__.py additions needed,
# since none of these targets do package-relative imports across directory
# boundaries. See https://github.com/bazel-contrib/rules_python/issues/2945.
common --incompatible_default_to_explicit_init_py

# Use rules_python's runfiles-aware launcher in every build configuration.
# Scoping this to latest_llvm made Python execution semantics depend on the
# selected C++ toolchain and left hosted/default lanes on a different launcher.
common --@rules_python//python/config_settings:bootstrap_impl=script

# Force clang to be the default compiler for all Bazel C/C++ actions.
# Propagates CC/CXX so every action (including host tools) uses clang/clang++.
build --action_env=CC=clang
build --action_env=CXX=clang++
build --host_action_env=CC=clang
build --host_action_env=CXX=clang++

# Disable layering check since toolchains_llvm has issues with it.
build --features=-layering_check

# Disable exceptions and rtti
build --copt=-fno-exceptions
build --copt=-fno-rtti

# Keep CI warning output focused on Donner-owned code. These filters are scoped
# to vendored/external sources and the warning classes they currently emit under
# the repo's clang configuration.
build --per_file_copt=external/google_benchmark[+]/.*@-Wno-thread-safety-analysis
build --per_file_copt=external/glfw[+]/.*@-Wno-enum-enum-conversion
build --per_file_copt=external/freetype[+]/.*@-Wno-macro-redefined
build --per_file_copt=external/brotli[+]/.*@-Wno-macro-redefined
build --per_file_copt=external/imgui[+]/.*@-Wno-missing-braces

# Use registered clang toolchain.
build --incompatible_enable_cc_toolchain_resolution

# Enable the resvg-test-suite-dependent internal tests unconditionally for
# local dev and CI. The flag defaults to False in the BUILD file so that
# downstream consumers (who pull Donner via BCR and do NOT read this
# .bazelrc) cleanly skip those tests instead of failing to resolve
# @resvg-test-suite, which lives in the dev-only non_bcr_deps extension.
common --//donner/svg/renderer:resvg_test_suite_available=true

# Same pattern for the curated embedded Google Fonts (Design 0013 W3): the
# gfont_* http_file repos live behind a dev_dependency module extension, so
# BCR consumers cleanly skip the font catalog targets instead of failing to
# resolve them.
common --//third_party/google_fonts:google_fonts_available=true

# Enable the latest LLVM toolchain for Linux exec platforms. macOS exec falls
# through to apple_support's Xcode clang so ObjC targets keep working.
common:latest_llvm --extra_toolchains=@llvm_toolchain_linux_aarch64//:all
common:latest_llvm --extra_toolchains=@llvm_toolchain_linux_x86_64//:all
common:latest_llvm --//build_defs:llvm_latest=1
# toolchains_llvm selects builtin libc++ with a clang driver argument. On
# self-hosted Linux, compile-only actions can report that stdlib-selection
# argument as unused even though the toolchain has already supplied the libc++
# include paths and link inputs. Suppress that driver-only warning in the LLVM
# toolchain config so real compiler diagnostics are not buried in CI logs.
common:latest_llvm --copt=-Qunused-arguments

# Opt-in workaround for dev boxes whose autoconfigured linker (gold, or bfd
# without --start-lib) fails to link the suite. Not the default so it doesn't
# force an lld dependency onto CI images. See #665.
build:lld --linkopt=-fuse-ld=lld
build:lld --host_linkopt=-fuse-ld=lld

# Renderer backend selection
common:tiny-skia --//donner/svg/renderer:renderer_backend=tiny_skia
# Geode (WebGPU + Slug GPU backend). Also toggles enable_geode so that
# wgpu-native is compiled; default bazel builds without --config=geode never
# touch the WebGPU runtime.
common:geode --//donner/svg/renderer:renderer_backend=geode
common:geode --//donner/svg/renderer/geode:enable_geode=true
# A local hardware adapter is process-global. Keep explicit Geode suites
# serial so independent test processes cannot cascade one device loss.
test:geode --local_test_jobs=1
common:dev --//build_defs:disable_backend_test_transition=true
# Disable forced opt compilation of perf-sensitive deps to avoid
# cross-configuration link conflicts.  Use: --config=no-perf-opt
common:no-perf-opt --//build_defs:disable_perf_opt_transition=true

# WASM / Emscripten builds.
# Usage: bazel build --config=wasm //examples:svg_viewer_wasm
# Uses wasm_cc_binary transition so deps are compiled with the emscripten toolchain.
# Raise constexpr step limit for CompileTimeMap (default 1M is too low for large maps).
build:wasm --cxxopt=-fconstexpr-steps=10000000
# Disable perf-opt transition to avoid Emscripten toolchain variant conflicts.
build:wasm --config=no-perf-opt

# Product tiers
common:tiny --//donner/svg/renderer:filters=false --//donner/svg/renderer:text=false
# donner (default) = no extra config needed (filters=true, text=true by default)
# donner-max     = --config=text-full (filters=true, text=true, text_full=true)
# donner-tiny    = --config=tiny (filters=false, text=false)

# Filter effects
common:no-filters --//donner/svg/renderer:filters=false

# Text rendering features:
#   (default)             Basic text (stb_truetype, TTF/OTF/WOFF1)
#   --config=text-full    Full text (FreeType + HarfBuzz + WOFF2)
#   --config=no-text      Disable text rendering entirely
common:no-text --//donner/svg/renderer:text=false
common:text-full --//donner/svg/renderer:text=true --//donner/svg/renderer:text_full=true

# WebAssembly (Emscripten) build. Usage:
#   bazel build --config=wasm //donner/svg/renderer/wasm:donner_wasm
common:wasm --//donner/svg/renderer:renderer_backend=tiny_skia
common:wasm --//donner/svg/renderer/wasm:enable_wasm=true
common:wasm --//donner/svg/renderer:text=false
common:wasm --//donner/svg/renderer:text_full=false
# Disable the perf-opt transition so that all targets use the emscripten
# toolchain without cross-configuration link conflicts.
common:wasm --//build_defs:disable_perf_opt_transition=true

# Size-optimized production wasm. The .wasm + JS glue is a browser download, so
# the shipped/downloaded artifact should be built for size. This layers size
# optimization on --config=wasm: -c opt compiles every translation unit
# optimized, and -Oz (compile + link) minimizes code size and drives
# Emscripten's whole-module wasm-opt pass. --config=wasm alone stays
# unoptimized for fast iteration. Usage:
#   bazel build --config=wasm-size //donner/svg/renderer/wasm:donner_wasm
common:wasm-size --config=wasm
build:wasm-size -c opt
build:wasm-size --copt=-Oz
build:wasm-size --linkopt=-Oz
# JS-glue minification: closure shrinks the Emscripten glue ~10x, and
# -sFILESYSTEM=0 drops the unused virtual filesystem runtime. Both are
# JS-glue-only trims validated by the headless render gate
# (//donner/svg/renderer/wasm:render_test). Gated to wasm-size so the plain
# --config=wasm dev build stays fast and un-minified.
build:wasm-size --linkopt=--closure=1
build:wasm-size --linkopt=-sFILESYSTEM=0

# Full editor WASM build. Uses Geode/WebGPU by default because the editor
# presentation and performance work target Geode. Usage:
#   bazel build --config=editor-wasm //donner/editor/wasm:wasm
common:editor-wasm --config=wasm-geode
common:editor-wasm --//donner/editor/wasm:enable_wasm=true
common:editor-wasm --//donner/svg/renderer:text=true
common:editor-wasm --//donner/svg/renderer:text_full=true
build:editor-wasm --copt=-pthread
build:editor-wasm --copt=-Oz
build:editor-wasm --linkopt=-pthread
build:editor-wasm --linkopt=-Oz
build:editor-wasm -c opt

# Geode (WebGPU) WASM build. Usage:
#   bazel build --config=wasm-geode //donner/svg/renderer/wasm:donner_wasm_geode
# Inherits --config=wasm (Emscripten toolchain + text disables + perf-opt
# transition disable) and switches the renderer backend to Geode on the Donner
# GPU runtime's browser backend. Requires ASYNCIFY because device requests and
# buffer mapping wait for the browser.
common:wasm-geode --config=wasm
common:wasm-geode --//donner/svg/renderer:renderer_backend=geode
common:wasm-geode --//donner/svg/renderer/geode:enable_geode=true
common:wasm-geode --//donner/svg/renderer/geode:browser_backend=true
build:wasm-geode --cxxopt=-fconstexpr-steps=10000000

# Backwards-compatible alias for the old explicit editor Geode config. Usage:
#   bazel build --config=editor-wasm-geode //donner/editor/wasm:wasm
common:editor-wasm-geode --config=editor-wasm

# C++20. The host option matters as soon as anything is built for the exec platform - a build-time
# code generator, say - because that compile does not pick up --cxxopt, and this is one codebase
# at one standard whichever platform a given binary is built for.
build:c++20 --cxxopt=-std=c++20 --host_cxxopt=-std=c++20

# Opt-in host libstdc++ selection for integrations that require its ABI.
# Normal Linux builds let the selected toolchain choose matching headers and runtime.
build:host_libstdc++ --host_cxxopt=-std=c++20 --host_cxxopt=-stdlib=libstdc++ --host_linkopt=-lstdc++

build:linux --copt=-fno-modules

# Fixes symbols when debugging on mac.
build:macos --features=oso_prefix_is_pwd
# Donner uses C++20 libc++ APIs gated by Apple SDK availability, including
# std::filesystem and std::format floating-point formatting.
build:macos --macos_minimum_os=13.3

# macOS CI lanes that share one remote cache. Every macOS CI job passes
# --config=ci-macos (through BAZEL_MACOS_BUILD_FLAGS in main.yml) so that the
# GitHub-hosted and the self-hosted macOS runners compute identical action
# keys. Without a fixed PATH, Bazel copies the client's PATH into every action
# environment, and it differs per runner (runner home directories, image tool
# paths and the Bazelisk download directory, which Bazelisk prepends), so no
# compile action matched across runners. The value keeps every directory either
# lane relied on before this was pinned. The selected Xcode is pinned
# separately, in tools/ci_macos_xcode.txt, because its version and build are
# part of every Apple toolchain action key. Runner-only settings (remote cache
# endpoint, timeouts, --jobs) stay out of this config because they do not
# affect action keys. //tools:macos_cache_key_parity_tests enforces this.
build:ci-macos --action_env=PATH=/opt/homebrew/opt/llvm@19/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
build:ci-macos --host_action_env=PATH=/opt/homebrew/opt/llvm@19/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin

# apple_support's clang wrapper expects DEVELOPER_DIR. The local Darwin
# sandbox sets it implicitly; remote execution does not. SDKROOT must NOT be
# pinned here: the apple toolchain supplies its own (versioned) SDKROOT per
# action, and a second value from action_env crashes analysis/spawn setup
# with a duplicate-key error once the installed Xcode ships versioned SDK
# directories (first seen with Xcode 26.5).
build:re --action_env=DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer
build:re --host_action_env=DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer
# A remote-execution sandbox can SIGKILL Tracy's static client startup before
# gtest main runs (the test exits 9 with no gtest output). Keep editor
# profiling enabled by default, but build the no-op wrapper for any action
# that runs on Bazel RE. Two distinct paths route through remote execution
# and BOTH need this: local RE via `--config=re`, and self-hosted CI, whose
# runner-level system bazelrc routes `--config=ci` through RE (NOT
# `--config=re`, so this must be repeated on the ci config below).
#
# The `re` config here holds only the generic, host-independent settings.
# The remote executor/cache endpoints, TLS credentials and any per-host
# priority belong in an untracked rc file: a user `~/.bazelrc`, or the
# optional `%workspace%/.bazelrc.user` imported at the end of this file.
common:re --//build_defs:enable_tracy=false
common:ci --//build_defs:enable_tracy=false

# Reduces binary size on mac
build:macos-binary-size --config=binary-size
build:macos-binary-size --linkopt=-exported_symbols_list --linkopt=/dev/null
build:macos-binary-size --copt=-gline-tables-only
build:macos-binary-size --linkopt=-dead_strip

# The registered LLVM toolchains select their C++ standard library themselves
# (`builtin-libc++` for Linux), and Apple clang uses the SDK libc++ by default.
# Do not inject `-stdlib=libc++` through CXXFLAGS/LDFLAGS here: self-hosted
# Linux toolchain setup propagates those environment flags into compile actions
# and clang reports them as unused for every source file.
build --config=c++20

# Debug builds
build:debug -c dbg --copt=-O0 --copt=-g --copt=-fdebug-compilation-dir=. --linkopt=-g --strip=never --apple_generate_dsym --spawn_strategy=standalone
# Standalone execution cannot run path-mapped actions.
build:debug --experimental_output_paths=off

# Compile-time deep dive (see tools/time_trace_report.py). Clang writes a
# <object>.json trace next to each .o. Those are undeclared outputs, so
# sandboxing and remote execution would
# discard them — force standalone local execution and disable the remote
# cache/executor for this config. Usage:
#   bazel build --config=time-trace //donner/svg/...
#   python3 tools/time_trace_report.py
build:time-trace --copt=-ftime-trace
build:time-trace --experimental_output_paths=off
build:time-trace --strategy=CppCompile=standalone --spawn_strategy=standalone
build:time-trace --remote_executor= --remote_cache= --noremote_upload_local_results

# Opt-in native inputs retain paired line tables. Use native_delivery for a fresh stripped
# copy before signing/hashing; attribution presets are separate from release policy.
build:native-release -c opt --copt=-gline-tables-only --strip=never
build:native-release --copt=-fdebug-compilation-dir=. --copt=-ffile-compilation-dir=.
build:native-release --//build_defs:enable_tracy=false
build:native-release-macos --config=native-release --apple_generate_dsym
build:native-release-linux --config=native-release --linkopt=-Wl,--build-id=sha1

# Binary-size builds: optimized for size while preserving debug attribution.
build:binary-size -c opt --copt=-Os --copt=-g --strip=never
build:binary-size --copt=-ffunction-sections --copt=-fdata-sections
# Keep LTO off for size reports: bloaty's compile-unit attribution depends on
# debug info that ThinLTO leaves pointing at transient .thinlto.o files.

build:linux-binary-size --config=binary-size
build:linux-binary-size --linkopt=-Wl,--gc-sections

# ThinLTO layer for the size-optimized native build. ThinLTO shrinks the
# stripped binaries ~8% by folding and inlining across translation units, but
# its debug info points at transient .thinlto.o object files that dsymutil and
# bloaty cannot open, so it is kept OFF the attribution build:binary-size above
# and offered as a separate shipped-size config. tools/binary_size.sh reports
# both: the non-LTO build (with per-compile-unit attribution) and this LTO
# build (headline shipped size, no attribution). Usage:
#   bazel build --config=macos-binary-size-lto //donner/svg/tool:donner-svg.stripped
build:binary-size-lto --config=binary-size
build:binary-size-lto --copt=-flto=thin --linkopt=-flto=thin
build:macos-binary-size-lto --config=macos-binary-size
build:macos-binary-size-lto --copt=-flto=thin --linkopt=-flto=thin
build:linux-binary-size-lto --config=linux-binary-size
build:linux-binary-size-lto --copt=-flto=thin --linkopt=-flto=thin

# Declared on `build`, not `test`. Bazel keys its analysis cache on the whole
# option set, so an option that exists on one command and not the other makes
# every build/test alternation discard the cache and re-analyse the graph
# ("Build option --test_env has changed, discarding analysis cache"). CI runs
# `bazel build <targets>` and then `bazel test <targets>`, so with these on
# `test` the second invocation threw away the first one's analysis and re-walked
# all ~17k actions. `--test_env` is accepted on `build` and applies to the test
# actions exactly the same way.
build --test_env=LLM
build --test_env=DONNER_RENDERER_TEST_VERBOSE

# Coverage builds
coverage --config=coverage
coverage --combined_report=lcov
coverage --instrumentation_filter="-test_utils$,//donner[:/]"
coverage --test_tag_filters=-fuzz_target,-lint,-manual,-perf,-ci-remote-gpu
# Continue past build/analysis failures so coverage is collected from all tests
# that can run.
coverage --keep_going
# Explicit labels passed to tools/coverage.sh can name targets incompatible with
# the host platform. Skip those exactly as package-pattern coverage does.
coverage --skip_incompatible_explicit_targets

coverage:macos --test_env=LLVM_COV=/Library/Developer/CommandLineTools/usr/bin/llvm-cov
coverage:macos --test_env=LLVM_PROFDATA=/Library/Developer/CommandLineTools/usr/bin/llvm-profdata

build:coverage --cxxopt=-DNDEBUG
build:coverage --experimental_generate_llvm_lcov
build:coverage --features=llvm_coverage_map_format
build:coverage --copt=-ffile-compilation-dir=.
build:coverage --action_env=BAZEL_USE_LLVM_NATIVE_COVERAGE=1
# Split coverage postprocessing runs the merge in a separate spawn. Keep
# coverage outputs writable so Bazel's Linux C++ coverage script can write
# COVERAGE_DIR/gcov and _cc_coverage.dat there. See bazelbuild/bazel#28310.
build:coverage --experimental_writable_outputs
# Bazel's test runner copies GCOV into COVERAGE_GCOV_PATH. For LLVM lcov
# collection that path is used as llvm-profdata to merge profraw files.
build:coverage --action_env=GCOV=llvm-profdata
build:coverage --action_env=BAZEL_LLVM_COV=llvm-cov
build:coverage --action_env=BAZEL_LLVM_PROFDATA=llvm-profdata

test:coverage --collect_code_coverage
# Coverage test results ARE cacheable: a cache-hit test's coverage.dat is part
# of its cached result, and --experimental_fetch_all_coverage_outputs makes
# Bazel download it so the combined lcov report stays complete (validated
# 2026-07-02: two consecutive runs, second fully cached, byte-identical
# _coverage_report.dat). Split postprocessing keeps coverage merge outputs out
# of the cached test tree, avoiding absolute GCOV symlinks in _coverage/gcov.
# The previous `--nocache_test_results` (2024-04, pre-remote-cache) forced every
# coverage run to re-execute every test in scope, which dominated CI coverage
# wall time.
test:coverage --experimental_fetch_all_coverage_outputs
test:coverage --experimental_split_coverage_postprocessing

# Basic ASAN/UBSAN that works for gcc
build:asan --config=latest_llvm
# Select sanitizer-aware toolchain defaults as well as the instrumentation flags below.
# Apple toolchains omit their conflicting _FORTIFY_SOURCE definition when this feature is on.
build:asan --features=asan
build:asan --linkopt=-ldl
build:asan --copt=-fsanitize=address,undefined
build:asan --linkopt=-fsanitize=address,undefined
build:asan --copt=-fno-omit-frame-pointer
build:asan --copt=-fsanitize-address-use-after-scope
build:asan --test_env=ASAN_SYMBOLIZER_PATH
# LeakSanitizer scans loaded modules' globals for root pointers and symbolizes stacks against
# loaded modules, so a driver library the Vulkan loader unloads during teardown takes both with
# it: memory its globals still owned is reported as an unreachable leak, and every frame prints
# as `<unknown module>`, which no suppression template can name. The Vulkan loader exposes this
# switch for exactly that reason; it keeps ICDs and layers mapped so the reports stay
# attributable. Test-only, and a no-op on hosts without a Vulkan loader.
build:asan --test_env=VK_LOADER_DISABLE_DYNAMIC_LIBRARY_UNLOADING=1
# These require libubsan, which is not linked properly by bazel, so disable.
# See https://github.com/google/oss-fuzz/issues/713
build:asan --copt=-fno-sanitize=vptr,function
build:asan --linkopt=-fno-sanitize=vptr,function
build:asan --strip=never

# Undefined behavior sanitizer builds
build:ubsan --config=latest_llvm
build:ubsan --linkopt=-ldl
build:ubsan --copt=-fsanitize=undefined
build:ubsan --linkopt=-fsanitize=undefined
build:ubsan --copt=-fno-omit-frame-pointer
build:ubsan --test_env=UBSAN_OPTIONS=print_stacktrace=1:halt_on_error=1
build:ubsan --copt=-fno-sanitize=vptr,function
build:ubsan --linkopt=-fno-sanitize=vptr,function
build:ubsan --strip=never

# Sanitizer lanes, one per phase of the Sanitizers workflows (.github/workflows/sanitizers.yml and
# sanitizers-pr.yml). Reproduce a phase locally with `bazel test --config=<lane>` and its targets.
#
# ASan and UBSan over the //donner tests. The workflow also drops each lane's exclusion suite
# (//tools/ci:asan_exclusions, //tools/ci:ubsan_exclusions): allocation-tracker binaries replace
# the sanitizer allocator, the WebAssembly package check only reads that package, and under ASan
# the GL replay suite's far-zoom case exceeds its per-case watchdog. The scheduled Fuzz workflow
# owns fuzz_target tests. Tag filters replace the default filter rather than adding to it, so they
# repeat its ci-remote-gpu exclusion: those remote-lane wrappers rerun the executable and tests of
# a local twin these lanes already select. Only the selected tests and their dependencies build;
# non-test targets never execute here, so building them under a sanitizer adds no signal.
test:asan-lane --config=asan
test:asan-lane --test_output=errors
test:asan-lane --build_tests_only
test:asan-lane --test_tag_filters=-fuzz_target,-ci-remote-gpu
test:asan-lane --build_tag_filters=-fuzz_target,-ci-remote-gpu
# The ASan tests that run without leak detection: native Geode tests hold raw non-owning
# webgpu.hpp handles in their harnesses, so //donner/svg/renderer/geode/... and
# //tools/ci:asan_no_leak_tests keep ASan's memory-safety checks without its leak check.
test:asan-lane-no-leaks --config=asan
test:asan-lane-no-leaks --test_output=errors
test:asan-lane-no-leaks --test_env=ASAN_OPTIONS=detect_leaks=0
test:asan-lane-no-leaks --build_tests_only
test:asan-lane-no-leaks --test_tag_filters=-fuzz_target,-ci-remote-gpu
test:asan-lane-no-leaks --build_tag_filters=-fuzz_target,-ci-remote-gpu
test:ubsan-lane --config=ubsan
test:ubsan-lane --test_output=errors
test:ubsan-lane --build_tests_only
test:ubsan-lane --test_tag_filters=-fuzz_target,-ci-remote-gpu
test:ubsan-lane --build_tag_filters=-fuzz_target,-ci-remote-gpu
# Untrusted-input fuzzer corpora replayed deterministically under UBSan, per build variant (the
# Fuzz workflow owns exploratory mutation).
test:ubsan-corpus --config=ubsan
test:ubsan-corpus --test_output=errors
test:ubsan-corpus --test_tag_filters=fuzz_ubsan
test:ubsan-corpus --build_tag_filters=fuzz_ubsan
test:ubsan-corpus-text-full --config=ubsan
test:ubsan-corpus-text-full --config=text-full
test:ubsan-corpus-text-full --test_output=errors
test:ubsan-corpus-text-full --test_tag_filters=fuzz_ubsan_text_full
test:ubsan-corpus-text-full --build_tag_filters=fuzz_ubsan_text_full
test:ubsan-corpus-geode --config=ubsan
test:ubsan-corpus-geode --config=geode
test:ubsan-corpus-geode --test_output=errors
test:ubsan-corpus-geode --test_tag_filters=fuzz_ubsan_geode
test:ubsan-corpus-geode --build_tag_filters=fuzz_ubsan_geode
# The pull-request Geode ASan lane: //tools/ci:asan_geode_pr.
test:asan-geode-pr --config=asan
test:asan-geode-pr --config=geode
test:asan-geode-pr --test_output=errors

# Thread sanitizer builds
build:tsan --config=latest_llvm
build:tsan --linkopt=-ldl
build:tsan --copt=-fsanitize=thread
build:tsan --linkopt=-fsanitize=thread
build:tsan --copt=-fno-omit-frame-pointer
build:tsan --strip=never
build:tsan --test_env=TSAN_OPTIONS=halt_on_error=1:second_deadlock_stack=1

# Long-budget fuzzing. Raises the `{fuzzer}_soak` targets' libFuzzer time
# budget above the short local default. Used by the nightly Fuzz workflow,
# which pairs it with --config=asan-fuzzer so a discovered input is diagnosable.
common:fuzz-soak --//build_defs:fuzz_soak=true

# Fuzzing builds
build:asan-fuzzer --config=asan
# Keep assertions and sanitizer coverage while bounding synthetic resource-limit seed work.
build:asan-fuzzer --copt=-O1
build:asan-fuzzer --copt=-fsanitize=fuzzer-no-link
build:asan-fuzzer --define=FUZZING_ENGINE=libfuzzer
build:asan-fuzzer --copt=-fno-omit-frame-pointer
build:asan-fuzzer --copt=-DFUZZING_BUILD_MODE_UNSAFE_FOR_PRODUCTION
build:asan-fuzzer --test_env=UBSAN_OPTIONS=print_stacktrace=1

# Nightly fuzz lanes, one per phase of the Fuzz workflow (.github/workflows/fuzz.yml). Each runs
# the long-budget soaks under the ASan fuzzer build; reproduce a phase locally with
# `bazel test --config=<lane> //...` (or the soak target for fuzz-lane-production-soak).
#
# A soak is time-bounded exploration whose result depends on what this run's mutation finds, so
# its result must never come from a cache. Bazel 8 treats `--nocache_test_results` as "execute
# unconditionally": it skips the local action cache and marks the test spawn `no-cache`, which
# also skips the disk cache and remote cache lookups and sets `skip_cache_lookup` for remote
# execution. Build actions stay cached. The lanes' deterministic corpus replays also re-run,
# which keeps "every result in a phase executed" a check with no exceptions. Every lane below
# inherits this from fuzz-lane-base; //tools:security_workflow_policy_tests rejects a fuzz lane
# that does not.
test:fuzz-lane-base --config=asan-fuzzer
test:fuzz-lane-base --config=fuzz-soak
test:fuzz-lane-base --test_output=errors
test:fuzz-lane-base --nocache_test_results
# Default-build fuzzers.
test:fuzz-lane --config=fuzz-lane-base
test:fuzz-lane --test_tag_filters=fuzz_target
test:fuzz-lane --build_tag_filters=fuzz_target
# Text-full fuzzers.
test:fuzz-lane-text-full --config=fuzz-lane-base
test:fuzz-lane-text-full --config=text-full
test:fuzz-lane-text-full --test_tag_filters=fuzz_text_full
test:fuzz-lane-text-full --build_tag_filters=fuzz_text_full
# Geode render fuzzers (Linux).
test:fuzz-lane-geode --config=geode
test:fuzz-lane-geode --config=fuzz-lane-base
test:fuzz-lane-geode --test_tag_filters=fuzz_geode
test:fuzz-lane-geode --build_tag_filters=fuzz_geode
# The image loader at its production decode budget: //tools/ci:image_loader_production_soak.
test:fuzz-lane-production-soak --config=fuzz-lane-base

# Required for bazel_clang_tidy to operate as expected
build:clang-tidy --aspects @bazel_clang_tidy//clang_tidy:clang_tidy.bzl%clang_tidy_aspect
build:clang-tidy --output_groups=report

# Optionally override the .clang-tidy config file target
build:clang-tidy --@bazel_clang_tidy//:clang_tidy_config=//:clang_tidy_config

# Check C++ formatting with the pinned clang-format in every donner build: each donner_cc_*
# target's `{name}_format` validation (//tools/format). Modules that depend on donner do not read
# this file, so the check stays off for them.
common --//tools/format:check

##
## Test config
##

# Outputs test failures from failing tests instead just linking to test.log.
test --test_output=errors
# CI-only remote wrappers have a `no-local` execution requirement and mirror
# an ordinary locally isolated target. Exclude them unless a remote lane
# explicitly selects them in place of that target.
test --test_tag_filters=-ci-remote-gpu

# CI-specific optimizations — use `--config=ci` in GitHub Actions workflows.
# NOTE: do NOT set --jobs / --local_test_jobs here. Trusted self-hosted Linux
# runners route `--config=ci` through Bazel RE and cap concurrency in their
# system bazelrc. Setting HOST_CPUS here is read *after* the system bazelrc and
# would override that cap, oversubscribing the RE workers and (on cancel)
# leaking scheduler worker slots, the cause of a past CI hang.
build:ci --verbose_failures
build:ci --repository_cache=~/.cache/bazel-repo
# Bazel-diff's `affected targets` list can include targets whose
# `target_compatible_with` rules exclude the current host (the canonical
# case: `//donner/editor/wasm:*` flagged on linux/macos hosts). Without
# this flag bazel fails fast with "Target X is incompatible and cannot
# be built, but was explicitly requested." With it, those targets are
# silently skipped — which is the right behavior for a target-determinator-
# generated list, since the host platform is the constraint, not the PR.
# Avoids needing the `ci:full-test` PR label as a workaround.
build:ci --skip_incompatible_explicit_targets

# The remote cache is an optimization, so losing it must never fail a command
# that otherwise succeeded. With path conversion on (Bazel's default), a local
# build event file is written through the remote-cache uploader, which names
# each referenced file by a bytestream:// URI: it queries the cache for every
# file and uploads the test and build logs. If the cache becomes unreachable
# mid-run, Bazel exits 38 ("Unable to write all BEP events to file") after every
# test passed, and the same exit replaces a failing test's exit 3. Plain file://
# paths keep the local event file independent of the cache. The CI readers of
# these files use test status, counts and timings, never the file URIs.
common:ci --nobuild_event_json_file_path_conversion
common:ci --nobuild_event_binary_file_path_conversion
common:ci --nobuild_event_text_file_path_conversion

# Remote-execution queue priority convention: CI actions run at priority 0, the
# floor of the server-supported range (0-2147483647; the backend rejects
# negative values), while interactive development clients set higher values in
# their user bazelrc, so an interactive build always wins queue position over
# queued CI work. The remote scheduler orders its queue by REAPI
# ExecutionPolicy.priority; a HIGHER integer is scheduled sooner (priority is
# the primary sort key, insert order the tiebreaker). The explicit
# `--remote_execution_priority=0` for CI lives in the CI runner's system bazelrc `build:ci` stanza, next to
# the remote-executor endpoint it applies to; it is deliberately NOT repeated
# here, because the same option expanding from `--config=ci` in two rc files
# fires a duplicate-expansion warning on every CI invocation. This is queue
# ordering only, not preemption: actions already running hold their slot
# until done.

# Keep runner-sensitive wall-clock perf tests OFF the PR gate — they belong on
# the nightly `perf.yml` (which runs them via an explicit `--test_tag_filters=perf`
# that overrides this). Opt-in tests use `manual`, while wall-clock targets also
# use `perf`. Filtering both tags protects affected-target lists and full `//...`
# fallbacks even when a runner bazelrc changes wildcard expansion or config
# precedence. See CLAUDE.md ("wall-clock budgets move to nightly perf targets").
# `fuzz_soak` marks the time-budgeted `{fuzzer}_soak` mutation targets, which run
# only in the Fuzz workflow; the `{fuzzer}` corpus replay stays on the PR gate.
test:ci --test_tag_filters=-manual,-perf,-ci-remote-gpu,-fuzz_soak

# Main's GitHub-hosted macOS CI job runs on a 3 CPU, 7168 MiB virtual machine, where Bazel's
# defaults are --jobs=HOST_CPUS and a HOST_RAM*.67 memory budget, with --local_test_jobs following
# the CPU budget. `hosted-macos` states those scheduling values for a faster host. They change no
# action key.
build:hosted-macos --jobs=3
build:hosted-macos --local_resources=cpu=3
build:hosted-macos --local_resources=memory=4802

# Browser cases quarantined on main's hosted macOS job only (#1691, #1702): their GPU work can miss
# its budget on that runner. Only the jobs that reproduce that job's test environment pass it;
# every other lane and local runs keep running them.
test:hosted-macos-quarantine --test_env=DONNER_HOSTED_MACOS_QUARANTINE=1

# Main's hosted macOS job: its virtual GPU cannot compile shader-validated Metal pipelines, so the
# Metal device tests run there with API validation only (docs/metal_validation.md). It changes
# only those tests' environment, not any build action. Every other lane keeps shader validation.
test:hosted-macos-unvalidated --//build_defs:metal_shader_validation=off

# Runs tests at roughly main's hosted macOS speed on a faster self-hosted host: the hosted
# scheduling values and a launcher that holds each test to roughly the hosted runner's CPU
# capacity (//tools/ci:hosted_parity_throttle). `hosted-parity` adds the hosted-only quarantine,
# for tests that read it. Trusted pull requests run them in the macos-hosted-parity CI job.
# Not reproduced: the hosted runner's GPU, memory limit, disk and runner faults; the throttle
# only stretches CPU time, by a factor calibrated on macOS.
test:hosted-parity-runtime --config=hosted-macos
test:hosted-parity-runtime --run_under=//tools/ci:hosted_parity_throttle
test:hosted-parity --config=hosted-parity-runtime
test:hosted-parity --config=hosted-macos-quarantine

# The runner-sensitive subset: tests tagged `hosted_parity` (timing, frame, readiness and
# display-scale tests and host-tool probes), with main's hosted macOS tag filters.
# `bazel test --config=hosted-parity-subset //...` runs what the CI lane runs.
test:hosted-parity-subset --config=hosted-parity
test:hosted-parity-subset --build_tests_only
test:hosted-parity-subset --test_tag_filters=hosted_parity,-manual,-perf,-requires_metal_toolchain,-ci-remote-gpu,-launches-browser,-fuzz_soak

# Allow `bazel run` on sharded test targets (sharding only applies to `bazel test`).
run --test_sharding_strategy=disabled

# Cloud execution for the hosted Linux CI job. It changes only where actions run:
# the job selects its toolchain with --config=latest_llvm on every run, with or
# without the cloud credential. Tests run on the client for GPU/display access.
build:buildbuddy-re --extra_execution_platforms=//tools/ci:buildbuddy_linux_x86_64
build:buildbuddy-re --platforms=//tools/ci:buildbuddy_linux_x86_64
build:buildbuddy-re --spawn_strategy=remote
# This metadata action reads the real Git checkout.
build:buildbuddy-re --strategy_regexp="^Executing genrule //donner/editor:editor_build_info_txt$=local"
build:buildbuddy-re --strategy=TestRunner=local
build:buildbuddy-re --noremote_local_fallback
build:buildbuddy-re --remote_timeout=600s
build:buildbuddy-re --jobs=50

# CI lanes on the BuildBuddy remote cache (the GitHub-hosted lanes and the
# self-hosted macOS lane) may write a remote-cache fragment here via the
# .github/actions/buildbuddy-cache composite action when that run receives a
# BuildBuddy key (see "Continuous integration remote cache" in docs/building.md).
# try-import is a silent no-op when the file is absent (the default, and on the
# self-hosted Linux lane, which never runs that action), so builds are
# byte-for-byte unchanged unless a key is configured.
try-import %workspace%/.buildbuddy.bazelrc

# Optional per-developer overrides, such as remote-execution endpoints and TLS
# credentials for `--config=re`. The file is git-ignored and absent by default,
# so try-import is a silent no-op. Keep it last so it can override the above.
try-import %workspace%/.bazelrc.user
