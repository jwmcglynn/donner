# Fixtures for the closure walk behind release notices. Each input reaches third-party code only
# through an edge the walk must follow; the last links a library by linker option alone, which
# must be reported.
embed_resources(
    name = "closure_notice_fixture_asset_input",
    header_output = "closure_notice_fixture/Asset.h",
    resources = {"kClosureNoticeFixture": "//third_party/public-sans:PublicSans-Medium.otf"},
    tags = ["manual"],
    visibility = ["//visibility:private"],
)

cc_library(
    name = "closure_notice_fixture_compiler_input_input",
    additional_compiler_inputs = ["//third_party/public-sans:PublicSans-Medium.otf"],
    tags = ["manual"],
)

# `third_party/stb` has no BUILD file, so its files belong to the `//third_party` package.
cc_library(
    name = "closure_notice_fixture_root_package_file_input",
    data = ["//third_party:stb/LICENSE"],
    tags = ["manual"],
)

cc_library(
    name = "closure_notice_fixture_linkopt_input",
    linkopts = ["-lz"],
    tags = ["manual"],
)

_CLOSURE_NOTICE_FIXTURES = {
    "asset": (
        "public-sans",
        ["--require=public-sans"],
    ),
    "compiler_input": (
        "public-sans",
        ["--require=public-sans"],
    ),
    "linkopt": (
        "public-sans",
        ["--expect-failure=-lz"],
    ),
    "root_package_file": (
        "stb",
        ["--require=stb"],
    ),
}

[donner_closure_notice_file(
    name = "closure_notice_fixture_" + fixture,
    available_licenses = ["//third_party/licenses:" + license],
    tags = ["manual"],
    target = ":closure_notice_fixture_%s_input" % fixture,
    variant = "closure walk fixture: " + fixture,
) for fixture, (license, _) in _CLOSURE_NOTICE_FIXTURES.items()]

