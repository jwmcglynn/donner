load("@rules_python//python:defs.bzl", "py_binary", "py_test")

# GPU runtime inventory manifests and no-Rust-dependency verifier (design 0053).
#
# Manifest freshness is `manifest_freshness_tests` below: an ordinary bazel test
# whose scan inputs are declared as runfiles via the per-package
# `gpu_inventory_srcs` filegroups. It used to be a Lint-workflow step, on the
# premise that a sandboxed test cannot see the source tree - true, but a test
# does not need the source tree, it needs its inputs declared, which also gets
# it caching and correct change detection.
#
# `check_no_rust_dependencies.py` still runs as a Lint step: it is report-only
# by design (0053 phase 6 makes it blocking) and it inspects the vendored
# `third_party/tiny-skia-cpp` subtree, which .bazelignore hides from Bazel.

filegroup(
    name = "manifests",
    srcs = glob(["manifests/*.json"]),
)

py_binary(
    name = "generate_gpu_manifests",
    srcs = ["generate_gpu_manifests.py"],
    visibility = ["//visibility:public"],
)

py_binary(
    name = "check_no_rust_dependencies",
    srcs = ["check_no_rust_dependencies.py"],
    visibility = ["//visibility:public"],
)

py_test(
    name = "generate_gpu_manifests_tests",
    size = "small",
    srcs = [
        "generate_gpu_manifests.py",
        "generate_gpu_manifests_tests.py",
    ],
)

py_test(
    name = "check_no_rust_dependencies_tests",
    size = "small",
    srcs = [
        "check_no_rust_dependencies.py",
        "check_no_rust_dependencies_tests.py",
    ],
)

py_test(
    name = "manifests_integrity_tests",
    size = "small",
    srcs = ["manifests_integrity_tests.py"],
    data = [
        "rust_allowlist.json",
        ":manifests",
    ],
    deps = ["@rules_python//python/runfiles"],
)

# Freshness gate for the checked-in manifests, replacing the Lint workflow's
# `generate_gpu_manifests.py --check` step. Runs under plain `bazel test //...`.
#
# `data` is the scan universe, declared as real inputs. That is the whole point:
# a test that walked the source tree would have undeclared inputs, so Bazel
# could neither cache it nor tell change-based target selection which edits
# matter. Each `gpu_inventory_srcs` filegroup covers one package; a package that
# gains GPU code but not a filegroup is caught by
# `test_every_inventoried_file_is_a_declared_input`, not silently under-scanned.
py_test(
    name = "manifest_freshness_tests",
    size = "small",
    srcs = [
        "generate_gpu_manifests.py",
        "manifest_freshness_tests.py",
    ],
    data = [
        "rust_allowlist.json",
        ":manifests",
        "//:gpu_inventory_srcs",
