load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

# The lexical verifier scans tracked files outside Bazel, including the vendored
# subtree excluded by .bazelignore. CI runs it with --blocking default.
# Configured product closures are checked by ordinary Bazel dependency audits.
py_library(
    name = "rust_scopes",
    srcs = ["rust_scopes.py"],
    imports = ["."],
    visibility = ["//visibility:public"],
)

py_binary(
    name = "check_no_rust_dependencies",
    srcs = ["check_no_rust_dependencies.py"],
    visibility = ["//visibility:public"],
    deps = [":rust_scopes"],
)

py_test(
    name = "check_no_rust_dependencies_tests",
    size = "small",
    srcs = [
        "check_no_rust_dependencies.py",
        "check_no_rust_dependencies_tests.py",
    ],
    deps = [":rust_scopes"],
)
