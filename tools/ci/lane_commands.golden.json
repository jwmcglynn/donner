 "linux buildbuddy_verify": {
  "actions": [
   {
    "actions": [
     {
      "action": "bazel",
      "argv": "bazelisk build --config=ci --config=latest_llvm --config=buildbuddy-re --remote_accept_cached=false --disk_cache= '--per_file_copt=^donner/base/AsyncifySuspendProbe[.]cc$@-DBUILDBUDDY_RE_PROBE_${GITHUB_RUN_ID}_${GITHUB_RUN_ATTEMPT}' '--execution_log_json_file=${RUNNER_TEMP}/buildbuddy-execution.json' //tools/ci:buildbuddy_compile_probe",
      "expanded": "bazelisk build --//build_defs:enable_tracy=false --//build_defs:release_source_commit=0000000000000000000000000000000000000000 --nobuild_event_json_file_path_conversion --nobuild_event_binary_file_path_conversion --nobuild_event_text_file_path_conversion --verbose_failures '--repository_cache=~/.cache/bazel-repo' --skip_incompatible_explicit_targets --extra_toolchains=@llvm_toolchain_linux_aarch64//:all --extra_toolchains=@llvm_toolchain_linux_x86_64//:all --//build_defs:llvm_latest=1 --copt=-Qunused-arguments --extra_execution_platforms=//tools/ci:buildbuddy_linux_x86_64 --platforms=//tools/ci:buildbuddy_linux_x86_64 --spawn_strategy=remote '--strategy_regexp=^Executing genrule //donner/editor:editor_build_info_txt$=local' --strategy=TestRunner=local --noremote_local_fallback --remote_timeout=600s --jobs=50 --remote_accept_cached=false --disk_cache= '--per_file_copt=^donner/base/AsyncifySuspendProbe[.]cc$@-DBUILDBUDDY_RE_PROBE_${GITHUB_RUN_ID}_${GITHUB_RUN_ATTEMPT}' '--execution_log_json_file=${RUNNER_TEMP}/buildbuddy-execution.json' //tools/ci:buildbuddy_compile_probe"
     },
     {
      "action": "run",
      "argv": "jq -s -e 'any(.[]; .mnemonic == \"CppCompile\" and .runner == \"remote\" and .cacheHit != true and (.commandArgs | index(\"-DBUILDBUDDY_RE_PROBE_${GITHUB_RUN_ID}_${GITHUB_RUN_ATTEMPT}\")) != null)' '${RUNNER_TEMP}/buildbuddy-execution.json'"
     }
    ],
    "scenarios": [
     "main-push",
     "trusted-pr",
     "trusted-pr-native-only",
     "trusted-pr-fallback"
    ]
   },
   {
    "actions": [
     {
      "action": "bazel",
      "argv": "bazelisk build --config=ci --config=latest_llvm --remote_accept_cached=false --disk_cache= '--per_file_copt=^donner/base/AsyncifySuspendProbe[.]cc$@-DBUILDBUDDY_RE_PROBE_${GITHUB_RUN_ID}_${GITHUB_RUN_ATTEMPT}' '--execution_log_json_file=${RUNNER_TEMP}/buildbuddy-execution.json' //tools/ci:buildbuddy_compile_probe",
