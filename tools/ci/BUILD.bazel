# Linked-size budgets for the shipped native products, each about 3% over the size measured in the
# shipped configuration. The nightly Perf workflow builds and enforces them on its macOS arm64 and
# Linux x86_64 runners; no pull-request lane builds these products in the shipped configuration.
py_test(
    name = "native_linked_size_budget_test",
    size = "small",
    srcs = ["native_linked_size.py"],
    args = [
        "--product=donner_svg=$(rootpath :shipped_donner_svg)",
        "--product=editor=$(rootpath :shipped_editor)",
        "--product=svg_to_png=$(rootpath :shipped_svg_to_png)",
    ] + select({
        ":macos_arm64": [
            "--budget=donner_svg=4014000",
            "--budget=editor=13289000",
            "--budget=svg_to_png=4665000",
        ],
        ":linux_x86_64": [
            "--budget=donner_svg=4738000",
            "--budget=editor=14824000",
            "--budget=svg_to_png=5419000",
        ],
        "//conditions:default": [],
    }),
    data = [
        ":shipped_donner_svg",
        ":shipped_editor",
        ":shipped_svg_to_png",
    ],
    main = "native_linked_size.py",
    tags = [
        "manual",
        "perf",
        "perf_linux",
    ],
    target_compatible_with = select({
        ":macos_arm64": [],
        ":linux_x86_64": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

platform(
    name = "buildbuddy_linux_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    exec_properties = {
        "OSFamily": "Linux",
        "Arch": "amd64",
        "container-image": "docker://gcr.io/flame-public/rbe-ubuntu22-04@sha256:19a6ae9d1f58f24020b2d672919e8e4ea859e1389497dc2ddcb28bb9818becf8",
    },
    visibility = ["//visibility:public"],
)

# Remote macOS execution from a client on any host OS (`--config=remote-macos` in .bazelrc). The
# executor pool is selected only by these generic properties; its endpoint and credentials stay in
# the caller's untracked rc file. See "Remote macOS execution" in docs/building.md.
platform(
    name = "remote_macos_aarch64",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:macos",
    ],
    exec_properties = {
        "OSFamily": "darwin",
        "ISA": "aarch64",
        "container-image": "none",
    },
    visibility = ["//visibility:public"],
)

# The same executor class with a GPU. `--config=remote-macos-gpu` makes it the target platform and
# runs tests on it, so only test actions ask for a GPU; a test whose rule returns
# testing.ExecutionInfo runs on the base execution platform instead (see .bazelrc).
platform(
    name = "remote_macos_aarch64_gpu",
    exec_properties = {
        "gpu": "present",
    },
    parents = [":remote_macos_aarch64"],
    visibility = ["//visibility:public"],
)

# The Xcode the remote executor must have installed, because a client that is not a Mac discovers
# none. Each version comes from tools/ci_macos_xcode.txt (see remote_macos_xcode.bzl). The targets
# are manual: only --xcode_version_config reaches them, and wildcard builds on another Xcode skip
# them.
remote_macos_xcode_config(
    name = "remote_macos_xcodes",
    visibility = ["//visibility:public"],
)

alias(
    name = "buildbuddy_compile_probe",
