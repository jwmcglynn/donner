    name = "shipped_donner_svg",
    testonly = True,
    product = "//donner/svg/tool:donner-svg",
    tags = ["manual"],
)

config_setting(
    name = "macos_arm64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:aarch64",
    ],
)

config_setting(
    name = "linux_x86_64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

# Linked-size budgets for the shipped native products, each about 3% over the size measured in the
# shipped configuration. The nightly Perf workflow builds and enforces them on its macOS arm64 and
# Linux x86_64 runners; no pull-request lane builds these products in the shipped configuration.
py_test(
    name = "native_linked_size_budget_test",
    size = "small",
    srcs = ["native_linked_size.py"],
    args = [
        "--product=donner_svg=$(rootpath :shipped_donner_svg)",
        "--product=editor=$(rootpath :shipped_editor)",
        "--product=svg_to_png=$(rootpath :shipped_svg_to_png)",
    ] + select({
        ":macos_arm64": [
            "--budget=donner_svg=4014000",
            "--budget=editor=13289000",
            "--budget=svg_to_png=4665000",
        ],
        ":linux_x86_64": [
            "--budget=donner_svg=4738000",
            "--budget=editor=14824000",
            "--budget=svg_to_png=5419000",
        ],
        "//conditions:default": [],
    }),
    data = [
        ":shipped_donner_svg",
        ":shipped_editor",
        ":shipped_svg_to_png",
    ],
    main = "native_linked_size.py",
    tags = [
        "manual",
        "perf",
        "perf_linux",
    ],
    target_compatible_with = select({
        ":macos_arm64": [],
        ":linux_x86_64": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

