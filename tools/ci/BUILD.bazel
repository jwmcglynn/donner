# The shipped native products, built optimized with Geode and without the Tracy profiler client.
shipped_product(
    name = "shipped_editor",
    testonly = True,
    product = "//donner/editor:editor_binary",
    tags = ["manual"],
)

shipped_product(
    name = "shipped_svg_to_png",
    testonly = True,
    product = "//examples:svg_to_png",
    tags = ["manual"],
)

config_setting(
    name = "macos_arm64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:aarch64",
    ],
)

config_setting(
    name = "linux_x86_64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

# Linked-size budgets for the shipped native products, each about 10% over the size the nightly
# Perf workflow measured for that product on that platform in the shipped configuration. That
# workflow builds and enforces them on its macOS arm64 and Linux x86_64 runners; no pull-request
# lane builds these products in the shipped configuration.
py_test(
    name = "native_linked_size_budget_test",
    size = "small",
    srcs = ["native_linked_size.py"],
    args = [
        "--product=editor=$(rootpath :shipped_editor)",
        "--product=svg_to_png=$(rootpath :shipped_svg_to_png)",
    ] + select({
        ":macos_arm64": [
            "--budget=editor=13465000",
            "--budget=svg_to_png=4238000",
        ],
        ":linux_x86_64": [
            "--budget=editor=15594000",
            "--budget=svg_to_png=5369000",
        ],
        "//conditions:default": [],
    }),
    data = [
        ":shipped_editor",
        ":shipped_svg_to_png",
    ],
    main = "native_linked_size.py",
    tags = [
        "manual",
        "perf",
        "perf_linux",
    ],
    target_compatible_with = select({
        ":macos_arm64": [],
        ":linux_x86_64": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)
