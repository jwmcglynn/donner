# Prints the identity of the compiler that built it. Built in the same invocation and configuration
# as `release_svg`, so the release CLI provenance names the compiler Bazel's resolved C++ toolchain
# actually used, not whichever `c++` happens to be on the runner's PATH.
cc_binary(
    name = "release_compiler_identity",
    srcs = ["release_compiler_identity.cc"],
    tags = ["manual"],
)

# The license NOTICE released beside `release_svg`, built in the same invocation so it describes the
# same configured closure, and the test that it attributes every third-party component there.
