# The editor Wasm PR lane links both browser bridge variants before browser tests run.
filegroup(
    name = "browser_bridge_link_probes",
    srcs = [
        "//donner/gpu/browser:browser_bridge_link_probe",
        "//donner/gpu/browser:browser_bridge_pthreads_link_probe",
    ],
    tags = ["manual"],
)

test_suite(
    name = "asan_geode_pr",
    tags = ["manual"],
    tests = ["//donner/svg/renderer/tests:resvg_test_suite_geode"],
)

test_suite(
    name = "sanitizer_allocator_exclusions",
    tags = ["manual"],
    tests = [
        "//donner/benchmarks:svg_parse_allocation_tests",
        "//donner/gpu:gpu_allocation_tests",
        "//donner/gpu/metal/tests:metal_buffer_bounds_tests",
    ],
)

test_suite(
    name = "asan_no_leak_tests",
    tags = ["manual"],
    tests = [
        "//donner/svg/renderer/tests:renderer_geode_golden_tests",
        "//donner/svg/renderer/tests:renderer_geode_tests",
    ],
)

test_suite(
    name = "asan_exclusions",
    tags = ["manual"],
    tests = [
        ":asan_no_leak_tests",
        ":sanitizer_allocator_exclusions",
        "//donner/editor/tests:gl_rnr_replay_tests",
    ],
)

filegroup(
    name = "linker_canary",
    testonly = True,
    srcs = [
        "//donner/svg/renderer/tests:filter_graph_executor_tests",
        "//donner/svg/tool:donner-svg",
    ],
    tags = ["manual"],
)

alias(
    name = "release_svg",
    actual = "//donner/svg/tool:donner-svg",
    tags = ["manual"],
)

alias(
    name = "editor_wasm_package",
    actual = "//donner/editor/wasm:wasm_web_package",
    tags = ["manual"],
)

py_test(
    name = "test_with_exclusions_tests",
    size = "small",
    srcs = ["test_with_exclusions_tests.py"],
    data = ["test_with_exclusions.py"],
    deps = ["@rules_python//python/runfiles"],
)
