[Unit]
Description=Donner continuous fuzzing trigger
# Only run if the repo exists
ConditionPathIsDirectory=%h/Projects/donner/.git

[Service]
Type=oneshot
Environment=FUZZ_SANDBOX=1
ExecStart=%h/Projects/donner/tools/fuzzing/trigger_fuzz.sh
WorkingDirectory=%h/Projects/donner

# Resource limits
TimeoutStartSec=7200
MemoryMax=16G

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=donner-fuzz

# A user unit already runs as its owner; User= attempts a forbidden group reset.

[Install]
WantedBy=default.target
