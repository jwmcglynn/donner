+QImage Render::renderViaDonner(const RenderData &data)
+{
+    if (data.testSuite != TestSuite::Own) {
+        throw QString("Donner requires the pinned resvg corpus and its reference PNGs.");
+    }
+    if (!QFileInfo(data.convPath).isAbsolute() || !QFileInfo(data.convPath).isExecutable()) {
+        throw QString("Set an absolute executable path to DonnerSvgSuiteRenderer.");
+    }
+
+    const QFileInfo input(data.imgPath);
+    const QString reference = input.absolutePath() + "/" + input.completeBaseName() + ".png";
+    const QSize size = QImageReader(reference).size();
+    if (size.isEmpty()) {
+        throw QString("Missing or invalid reference PNG: %1").arg(reference);
+    }
+    const QString root = QDir(QString(SRCDIR) + "/../..").absolutePath();
+    QTemporaryDir temporary;
+    if (!temporary.isValid()) {
+        throw QString("Cannot create Donner output directory.");
+    }
+    const QString output = temporary.filePath("donner.png");
+    const QString log = Process::run(data.convPath, {
+        "--input", input.absoluteFilePath(), "--output", output,
+        "--root", root, "--fonts", root + "/fonts",
+        "--width", QString::number(size.width()),
+        "--height", QString::number(size.height()),
+    }, true);
+    if (!log.isEmpty()) {
+        qDebug().noquote() << "donner:" << log;
+    }
+    QImage image = loadImage(output).convertToFormat(QImage::Format_ARGB32);
+    if (image.size() != size) {
+        throw QString("Donner output dimensions differ from the reference PNG.");
+    }
+    // Preview scaling happens after rendering. Automated comparisons use the
+    // C++ suite at canonical dimensions, never this UI image or its diff.
+    return image.scaled(QSize(data.viewSize, data.viewSize),
+                        Qt::KeepAspectRatio, Qt::SmoothTransformation);
+}
