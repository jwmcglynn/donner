@@ -0,0 +1,7 @@
+# Compile the authored checks, Donner adapter and status-based CSV parser without exceptions.
+no_exceptions.input = NO_EXCEPTION_SOURCES
+no_exceptions.output = ${QMAKE_FILE_BASE}.o
+no_exceptions.commands = $(CXX) $(CXXFLAGS) $(INCPATH) -fno-exceptions -c ${QMAKE_FILE_IN} -o ${QMAKE_FILE_OUT}
+no_exceptions.variable_out = OBJECTS
+no_exceptions.dependency_type = TYPE_C
+QMAKE_EXTRA_COMPILERS += no_exceptions
diff --git a/tools/vdiff/src/donner.cpp b/tools/vdiff/src/donner.cpp
new file mode 100644
--- /dev/null
+++ b/tools/vdiff/src/donner.cpp
@@ -0,0 +1,86 @@
+#include <QDebug>
+#include <QDir>
+#include <QFileInfo>
+#include <QImageReader>
+#include <QPainter>
+#include <QProcess>
+#include <QTemporaryDir>
+
+#include "render.h"
+
+namespace {
+RenderResult failure(const RenderData &data, const QString &error)
+{
+    QImage image(data.viewSize, data.viewSize, QImage::Format_ARGB32);
+    image.fill(Qt::white);
+    QPainter painter(&image);
+    QFont font = painter.font();
+    font.setPointSize(12);
+    painter.setFont(font);
+    painter.drawText(QRect(0, 0, data.viewSize, data.viewSize),
+                     Qt::AlignLeft | Qt::AlignTop | Qt::TextWordWrap, error);
+    painter.end();
+    return {data.type, image, error};
+}
+
+QString runDonner(const QString &executable, const QStringList &arguments)
+{
+    QProcess process;
+    process.setProcessChannelMode(QProcess::MergedChannels);
+    process.start(executable, arguments);
+    if (!process.waitForStarted()) {
+        return QString("Donner process failed to start.");
+    }
+    if (!process.waitForFinished(120000)) {
+        process.kill();
+        process.waitForFinished();
+        return QString("Donner process exceeded its timeout.");
+    }
+    const QByteArray diagnostics = process.readAll();
+    if (!diagnostics.isEmpty()) {
+        qDebug().noquote() << "donner:" << diagnostics;
+    }
+    if (process.exitStatus() != QProcess::NormalExit || process.exitCode() != 0) {
+        return QString("Donner process failed (exit %1).").arg(process.exitCode());
+    }
+    return {};
+}
+} // namespace
+
+RenderResult Render::renderViaDonner(const RenderData &data)
+{
+    if (data.testSuite != TestSuite::Own) {
+        return failure(data, "Donner requires the pinned resvg corpus and its reference PNGs.");
+    }
+    if (!QFileInfo(data.convPath).isAbsolute() || !QFileInfo(data.convPath).isExecutable()) {
+        return failure(data, "Set an absolute executable path to DonnerSvgSuiteRenderer.");
+    }
+    const QFileInfo input(data.imgPath);
+    const QString reference = input.absolutePath() + "/" + input.completeBaseName() + ".png";
+    const QSize size = QImageReader(reference).size();
+    if (size.isEmpty()) {
+        return failure(data, "Missing or invalid reference PNG.");
+    }
+    QTemporaryDir temporary;
+    if (!temporary.isValid()) {
+        return failure(data, "Cannot create Donner output directory.");
+    }
+    const QString root = QDir(QString(SRCDIR) + "/../..").absolutePath();
+    const QString output = temporary.filePath("donner.png");
+    const QString error = runDonner(data.convPath, {
+        "--input", input.absoluteFilePath(), "--output", output,
+        "--root", root, "--fonts", root + "/fonts",
+        "--width", QString::number(size.width()), "--height", QString::number(size.height())
+    });
+    if (!error.isEmpty()) {
+        return failure(data, error);
+    }
+    const QImage image(output);
+    if (image.isNull() || image.size() != size) {
+        return failure(data, "Donner output is missing, invalid or has unexpected dimensions.");
+    }
+    return {data.type,
+            image.convertToFormat(QImage::Format_ARGB32).scaled(
+                QSize(data.viewSize, data.viewSize), Qt::KeepAspectRatio, Qt::SmoothTransformation),
+            QString()};
+}
