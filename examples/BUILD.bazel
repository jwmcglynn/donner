)

# Builds the embed example in the ordinary `bazel test //...` run, so the embedding guide's
# snippets compile in pull-request CI and not only in `--config=geode` builds.
sh_test(
    name = "geode_embed_builds_impl",
    srcs = ["geode_embed_builds_test.sh"],
    data = [":geode_embed"],
    tags = ["manual"],
)

donner_multi_transitioned_test(
    name = "geode_embed_builds_test",
    dep = ":geode_embed_builds_impl",
    renderer_backend = "geode",
)

no_rust_dependency_audit_test(
    name = "geode_embed_no_rust_dependency_audit_impl",
    required = [
        "//donner/svg/renderer:renderer_geode",
        "//donner/svg/renderer/geode:geode_device",
    ],
    tags = ["manual"],
    target = ":geode_embed",
)

donner_multi_transitioned_test(
    name = "geode_embed_no_rust_dependency_audit_test",
    dep = ":geode_embed_no_rust_dependency_audit_impl",
