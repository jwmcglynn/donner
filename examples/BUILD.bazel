config_setting(
    name = "native_macos",
    constraint_values = ["@platforms//os:macos"],
)

config_setting(
    name = "native_linux",
    constraint_values = ["@platforms//os:linux"],
)

selects.config_setting_group(
    name = "native_platform",
    match_any = [
        ":native_macos",
        ":native_linux",
    ],
)

selects.config_setting_group(
    name = "native_text_enabled",
    match_all = [
        ":native_platform",
        "//donner/svg/renderer:text_enabled",
    ],
)

# These examples render supplied SVGs or their own text; shape-only and DOM demos need no fonts.
_NATIVE_TEXT_EXAMPLES = [
    "svg_to_png",
    "svg_text_interaction",
    "svg_viewer",
    "geode_embed",
]

[
    packaged_resource_bundle(
        name = name + "_resources",
        output_name = name + ".assets",
        resources = select({
            ":native_text_enabled": ["//third_party/public-sans:public-sans_resource_files"],
            "//conditions:default": [],
        }),
    )
    for name in _NATIVE_TEXT_EXAMPLES
]

donner_cc_binary(
    name = "custom_css_parser",
    testonly = 1,
    srcs = ["custom_css_parser.cc"],
    deps = [
        "@donner//donner/base/element:fake_element",
        "@donner//donner/css",
    ],
)

donner_cc_binary(
    name = "svg_to_png",
    srcs = ["svg_to_png.cc"],
    data = select({
        ":native_text_enabled": [":svg_to_png_resources"],
        "//conditions:default": [],
    }),
    defines = select({
        ":native_text_enabled": ["DONNER_EXAMPLE_NATIVE_TEXT"],
        "//conditions:default": [],
    }),
    linkopts = identical_code_folding_linkopts(),
    tags = [
        "codeql_default",
        "codeql_text_full",
    ],
    # The shipped-configuration size budget measures this tool as the GPU command-line product.
    visibility = ["//tools/ci:__pkg__"],
    deps = select({
        ":native_text_enabled": ["//donner/base:packaged_resource"],
        "//conditions:default": [],
    }) + [
        "//donner/base",
        "@donner",
    ],
)

donner_cc_binary(
    name = "svg_quickstart",
    srcs = ["svg_quickstart.cc"],
    deps = [
        "//donner/base",
        "@donner",
    ],
)

donner_cc_binary(
    name = "svg_animation",
    srcs = ["svg_animation.cc"],
    deps = [
        "//donner/base",
        "@donner",
    ],
)

# Runs the animation example, which exits non-zero when event dispatch or the lifecycle boundaries
