# --- SVG viewer (macOS/Linux only; pulls in the editor TextEditor widget) ---
donner_cc_binary(
    name = "svg_viewer",
    srcs = ["svg_viewer.cc"],
    data = select({
        ":native_text_enabled": [":svg_viewer_resources"],
        "//conditions:default": [],
    }),
    defines = select({
        ":native_text_enabled": ["DONNER_EXAMPLE_NATIVE_TEXT"],
        "//conditions:default": [],
    }),
    tags = ["codeql_default"],
    target_compatible_with = select({
        "@platforms//os:macos": [],
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = select({
        ":native_text_enabled": ["//donner/base:packaged_resource"],
        "//conditions:default": [],
    }) + [
        "//:donner",
        "//donner/base",
        # The viewer is intentionally minimal: donner core for the DOM,
        # parser, hit-test, and renderer; glad/glfw/imgui for the ImGui
        # shell; and exactly one library from //donner/editor — the
        # TextEditor widget. The full editor binary with EditorApp,
        # SelectTool, OverlayRenderer, and the command queue lives at
        # //donner/editor:editor.
        "//donner/editor:text_editor",
        "//third_party/glad",
        "@glfw",
        "@imgui",
    ],
)

# --- Geode embedded-mode demo (linux/macos, --config=geode only) ---
#
# Minimal GLFW host app that selects a native root against its window surface
# and renders an SVG into each acquired runtime texture. Gated behind the
# `geode_enabled` flag (see //donner/svg/renderer/geode:BUILD.bazel).
objc_library(
    name = "geode_embed_surface_macos",
    srcs = ["geode_embed_surface_macos.mm"],
    hdrs = ["geode_embed_surface.h"],
    sdk_frameworks = [
        "Cocoa",
        "QuartzCore",
    ],
    target_compatible_with = select({
        "@platforms//os:macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }) + select({
        "//donner/svg/renderer/geode:geode_enabled": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//donner/svg/renderer/geode:geode_device",
        "@glfw",
    ],
)

cc_library(
    name = "geode_embed_surface_linux",
    srcs = ["geode_embed_surface_linux.cc"],
    hdrs = ["geode_embed_surface.h"],
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }) + select({
        "//donner/svg/renderer/geode:geode_enabled": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//donner/gpu/vulkan:vulkan_device",
        "//donner/svg/renderer/geode:geode_device",
        "@glfw",
    ],
)

cc_library(
    name = "geode_embed_surface",
    hdrs = ["geode_embed_surface.h"],
    target_compatible_with = select({
        "@platforms//os:macos": [],
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }) + select({
        "//donner/svg/renderer/geode:geode_enabled": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = select({
        "@platforms//os:macos": [":geode_embed_surface_macos"],
        "@platforms//os:linux": [":geode_embed_surface_linux"],
        "//conditions:default": [],
    }),
)

donner_cc_binary(
    name = "geode_embed",
    srcs = ["geode_embed.cc"],
    data = select({
        ":native_text_enabled": [":geode_embed_resources"],
        "//conditions:default": [],
    }),
    defines = select({
        ":native_text_enabled": ["DONNER_EXAMPLE_NATIVE_TEXT"],
        "//conditions:default": [],
    }),
    tags = ["codeql_geode"],
    target_compatible_with = select({
        "@platforms//os:macos": [],
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }) + select({
        "//donner/svg/renderer/geode:geode_enabled": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = select({
        ":native_text_enabled": ["//donner/base:packaged_resource"],
        "//conditions:default": [],
    }) + [
        ":geode_embed_surface",
        "//:donner",
        "//donner/base",
        "//donner/svg/renderer:renderer_geode",
        "//donner/svg/renderer/geode:geode_device",
        "@glfw",
    ],
)

