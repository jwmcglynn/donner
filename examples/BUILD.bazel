load("@bazel_skylib//lib:selects.bzl", "selects")
load("@bazel_skylib//rules:native_binary.bzl", "native_test")
load("@emsdk//emscripten_toolchain:wasm_rules.bzl", "wasm_cc_binary")
load("@rules_python//python:defs.bzl", "py_test")
load("//build_defs:dep_audit.bzl", "configured_dependency_audit_test")
load("//build_defs:packaged_resources.bzl", "packaged_resource_bundle")
load("//build_defs:rules.bzl", "donner_cc_binary", "donner_multi_transitioned_test", "identical_code_folding_linkopts")
