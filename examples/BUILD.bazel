# Configured audits include data/resource edges, so a no-text product cannot carry font payloads.
[
    configured_dependency_audit_test(
        name = name + "_" + tier + "_resources_test",
        forbidden = [
            "//examples:" + name + "_resources",
            "//third_party/public-sans:public-sans_resource_files",
        ] if tier == "none" else [],
        required = ["//examples:" + name] + ([
            "//examples:" + name + "_resources",
            "//third_party/public-sans:public-sans_resource_files",
        ] if tier == "basic" else []),
        target = "//examples:" + name,
        text_configuration = tier,
    )
    for name in [
        "svg_to_png",
        "svg_text_interaction",
        "svg_viewer",
    ]
    for tier in [
        "none",
        "basic",
    ]
]

