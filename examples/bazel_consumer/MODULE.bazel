module(name = "donner_bazel_consumer")

bazel_dep(name = "donner", version = "0.8.0")

# Register the Apple toolchain before rules_cc selects its generic host toolchain.
bazel_dep(name = "apple_support", version = "2.10.1")
bazel_dep(name = "rules_cc", version = "0.2.27")

bazel_dep(name = "googletest", version = "1.18.0.bcr.1", dev_dependency = True, repo_name = "com_google_gtest")
bazel_dep(name = "pixelmatch-cpp17", version = "2.0.0", dev_dependency = True)

# GoogleTest 1.18 requires abseil-cpp 20260526.0, which declares no compatibility_level, while
# protobuf and rules_java (pulled in by rules_cc and bazel_tools) request compatibility level 1
# releases. Bazel 8 resolves the whole graph to abseil-cpp 20260526.0; Bazel 7 rejects the level
# mismatch. Selecting that same release keeps both Bazel versions on one abseil-cpp. Overrides
# apply only in the root module, so this never reaches modules that depend on donner.
single_version_override(
    module_name = "abseil-cpp",
    version = "20260526.0",
)
