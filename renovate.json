{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "schedule": [
    "on the 1st through 7th day of the month"
  ],
  "labels": [
    "bot"
  ],
  "packageRules": [
    {
      "matchDepNames": [
        "com_google_absl"
      ],
      "digest": {
        "enabled": false
      }
    },
    {
      "matchDepNames": [
        "imgui"
      ],
      "digest": {
        "enabled": false
      }
    },
    {
      "description": "ESLint matches the release CodeFactor uses; see docs/updating_dependencies.md.",
      "matchPackageNames": [
        "eslint",
        "@eslint/js",
        "globals"
      ],
      "matchFileNames": [
        "donner/editor/wasm/tests/package.json"
      ],
      "enabled": false
    },
    {
      "matchDepNames": [
        "skia"
      ],
      "schedule": [
        "at 10:00 on the 1st day of the month"
      ]
    }
  ],
  "ignorePaths": [
    "**/third_party/**"
  ]
}
