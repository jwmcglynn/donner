load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")

# Code-size binaries: identical source and flags, one backend each. Build with --config=codesize
# (see .bazelrc) through tools/measure_code_size.sh, which strips them and records the results.
# `code_size_baseline` links only the null recorder, so each delta is the backend's own cost:
# its adapter plus every library it pulls in.
[cc_binary(
    name = "code_size_" + backend,
    srcs = ["MinimalMain.cc"],
    deps = [
        target,
        "//harness",
        "@donner//donner/svg",
    ],
) for backend, target in [
    ("baseline", "//backends/donner:null"),
    ("tiny_skia", "//backends/donner:tiny_skia"),
    ("geode", "//backends/donner:geode"),
]]

cc_library(
    name = "minimal_main_test_source",
    textual_hdrs = ["MinimalMain.cc"],
    deps = [
        "//harness",
        "@donner//donner/svg",
    ],
)

cc_test(
    name = "minimal_main_tests",
    size = "small",
    srcs = ["MinimalMain_tests.cc"],
    deps = [
        ":minimal_main_test_source",
        "//harness",
        "@com_google_gtest//:gtest_main",
        "@donner//donner/svg",
    ],
)
