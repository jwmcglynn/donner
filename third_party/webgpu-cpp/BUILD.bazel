"""Pinned WebGPU-C++ wrapper for the Linux-only resvg pixel reference."""

load("//build_defs:package.bzl", "donner_package")

package(default_visibility = ["//visibility:private"])

cc_library(
    name = "webgpu_cpp",
    testonly = True,
    hdrs = ["webgpu.hpp"],
    include_prefix = "webgpu",
    # The header includes <webgpu/webgpu.h> and <webgpu/wgpu.h> directly, so
    # the wgpu-native `cc_library` must be exported as part of this target's
    # public headers, not just a link-time dep.
    strip_include_prefix = ".",
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        ":wgpu_native_linux",
        ":wgpu_native_lsan_suppressions",
    ],
)

# The Linux resvg comparison target names its native implementation dependency directly. Narrow
# visibility prevents other packages from adopting the test-only reference target.
cc_library(
    name = "wgpu_native_reference_runtime",
    testonly = True,
    target_compatible_with = ["@platforms//os:linux"],
    visibility = [
        "//donner/svg/renderer/geode:__pkg__",
        "//donner/svg/renderer/tests:__pkg__",
    ],
    deps = [":webgpu_cpp"],
)

# LeakSanitizer only runs on Linux, and the suppression is only meaningful for a binary that links
# the prebuilt wgpu-native library, so it rides along with the wrapper every such binary depends
# on. `alwayslink` is required: nothing references the symbol, and the sanitizer runtime's own weak
# definition wins unless this object is force-linked into the executable.
cc_library(
    name = "wgpu_native_lsan_suppressions",
    testonly = True,
    srcs = ["wgpu_native_lsan_suppressions.cc"],
    linkstatic = True,
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    alwayslink = True,
)

# Emscripten WebGPU target. The browser provides the standard webgpu.h
# functions via the vendored emdawnwebgpu package (Dawn's Emscripten
# bindings in //third_party/emdawnwebgpu). This target supplies:
#   1. A stub wgpu.h declaring wgpu-native extension types/functions so
#      webgpu.hpp compiles.
#   2. wgpu_native_stubs.cc implementing those extension functions (mostly
#      no-ops; wgpuDevicePoll yields via emscripten_sleep for ASYNCIFY).
#   3. The Dawn webgpu.h + compiled webgpu.cpp glue via emdawnwebgpu deps.
cc_library(
    name = "wgpu_emscripten",
    srcs = ["emscripten_stub/wgpu_native_stubs.cc"],
    hdrs = glob(["emscripten_stub/webgpu/*.h"]),
    strip_include_prefix = "emscripten_stub",
    # This target is only meaningful under Emscripten. Its `webgpu_impl`
    # dep `#include`s `<emscripten/emscripten.h>` directly, so letting
    # `bazel build //...` pick it up on native targets is pure noise.
    target_compatible_with = select({
        "@platforms//cpu:wasm32": [],
        "@platforms//cpu:wasm64": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//third_party/emdawnwebgpu:webgpu_header",
        "//third_party/emdawnwebgpu:webgpu_impl",
    ],
)

# Select the pinned Linux archive only for the test-only resvg comparison.
alias(
    name = "wgpu_native_linux",
    testonly = True,
    actual = select({
        "@platforms//cpu:aarch64": "@wgpu_native_linux_aarch64//:wgpu_native",
        "@platforms//cpu:x86_64": "@wgpu_native_linux_x86_64//:wgpu_native",
    }),
    target_compatible_with = ["@platforms//os:linux"],
)

donner_package(gpu_inventory_globs = [
    "BUILD.bazel",
    "**/*.bzl",
])
