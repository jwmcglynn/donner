load("@rules_cc//cc:defs.bzl", "cc_test")
load("//build_defs:rules.bzl", "donner_perf_sensitive_cc_library")

exports_files(
    # buildifier: keep sorted
    [
        "BUILD.cmark-gfm",
        "BUILD.css-parsing-tests",
        "BUILD.stb",
        # //tools:supply_chain_policy_tests reads every repository rule file
        # that MODULE.bazel declares.
        "bazel/local.bzl",
        # tools/cmake/gen_cmakelists.py reads this at runtime to discover the
        # versions of deps that are hidden from BCR consumers behind a
        # dev_dependency module extension.
        "bazel/non_bcr_deps.bzl",
        "woff2_bounded_decode.patch",
    ],
)

# A file under a third_party directory with no BUILD file of its own belongs to this package. The
# release notice fixture `//tools:closure_notice_fixture_root_package_file_tests` checks that the
# closure walk still attributes such a file to its directory's component.
exports_files(
    ["stb/LICENSE"],
    visibility = ["//tools:__pkg__"],
)

# Perf-sensitive wrappers for external deps that are shared between the Skia
# rendering pipeline (built in opt via _force_opt_transition) and the rest of
# the project.  By routing ALL usages through these wrappers the dep is always
# in the same (opt) configuration, eliminating cross-configuration link
# conflicts.

donner_perf_sensitive_cc_library(
    name = "zlib",
    visibility = ["//visibility:public"],
    deps = ["@zlib"],
)

donner_perf_sensitive_cc_library(
    name = "freetype",
    visibility = ["//visibility:public"],
    deps = ["@freetype"],
)

# Compile the colocated convolution suite against the same SIMD-pinned libraries used by Donner.
# The standalone vendored workspace names its test dependency differently.
cc_test(
    name = "tiny_skia_convolve_native_tests",
    srcs = ["@tiny-skia-cpp//src/tiny_skia/filter/tests:ConvolveMatrixTest.cpp"],
    copts = ["-ffp-contract=off"],
    deps = [
        "@com_google_gtest//:gtest_main",
        "@tiny-skia-cpp//src:tiny_skia_filter_native",
    ],
)

cc_test(
    name = "tiny_skia_convolve_scalar_tests",
    srcs = ["@tiny-skia-cpp//src/tiny_skia/filter/tests:ConvolveMatrixTest.cpp"],
    copts = ["-ffp-contract=off"],
    deps = [
        "@com_google_gtest//:gtest_main",
        "@tiny-skia-cpp//src:tiny_skia_filter_scalar",
    ],
)
