load("//build_defs:packaged_resources.bzl", "packaged_resources")

packaged_resources(
    name = "public-sans",
    group = "fallback-font",
    header_output = "embed_resources/PublicSansFont.h",
    resources = {
        "kPublicSansMediumOtf": "PublicSans-Medium.otf",
    },
    visibility = [
        "//donner:__subpackages__",
    ],
)

exports_files(
    ["PublicSans-Medium.otf"],
    visibility = [
        "//donner/svg/text:__pkg__",
        "//tools:__pkg__",
    ],
)

exports_files(
    ["LICENSE.md"],
    visibility = ["//third_party/licenses:__pkg__"],
)

filegroup(
    name = "embedded_header",
    srcs = [":public-sans_resource_gen"],
    visibility = ["//tools:__pkg__"],
)
