static inline bool
ComplexLanguageTags (const char   *lang_str,
          const char   *limit,
          unsigned int *count ,
          uint32_t     *tags )
{
  if (limit - lang_str >= 7)
  {
    const char *p = std::strchr(lang_str, '-');
    if (!p || p >= limit || limit - p < 5) goto out;
    if (SubtagMatches (p, limit, "-fonnapa", 8))
    {

      tags[0] = PackTag("APPH");
      *count = 1;
      return true;
    }
    if (SubtagMatches (p, limit, "-polyton", 8))
    {

      tags[0] = PackTag("PGR ");
      *count = 1;
      return true;
    }
    if (SubtagMatches (p, limit, "-arevmda", 8))
    {

      tags[0] = PackTag("HYE ");
      *count = 1;
      return true;
    }
    if (SubtagMatches (p, limit, "-provenc", 8))
    {

      tags[0] = PackTag("PRO ");
      *count = 1;
      return true;
    }
    if (SubtagMatches (p, limit, "-fonipa", 7))
    {

      tags[0] = PackTag("IPPH");
      *count = 1;
      return true;
    }
    if (SubtagMatches (p, limit, "-fonupa", 7))
    {

      tags[0] = PackTag("UPPH");
      *count = 1;
      return true;
    }
    if (SubtagMatches (p, limit, "-geok", 5))
    {

