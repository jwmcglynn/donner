--- a/emscripten_toolchain/env.sh
+++ b/emscripten_toolchain/env.sh
@@ -10,3 +10,13 @@
 # the execroot-relative lib dir first.
 PYTHON_LIB_DIR=$ROOT_DIR/$(dirname $(dirname $BAZEL_PYTHON_RELPATH))/lib
 export DYLD_LIBRARY_PATH="$PYTHON_LIB_DIR${DYLD_LIBRARY_PATH:+:$DYLD_LIBRARY_PATH}"
+
+# The Closure npm wrapper invokes `java` from PATH. Use the declared execution
+# runtime instead of depending on a machine-wide Java installation.
+if [[ -n "${BAZEL_JAVA_RELPATH:-}" ]]; then
+  case "$BAZEL_JAVA_RELPATH" in
+    /*) JAVA_EXECUTABLE="$BAZEL_JAVA_RELPATH" ;;
+    *) JAVA_EXECUTABLE="$ROOT_DIR/$BAZEL_JAVA_RELPATH" ;;
+  esac
+  export PATH="$(dirname "$JAVA_EXECUTABLE"):$PATH"
+fi
