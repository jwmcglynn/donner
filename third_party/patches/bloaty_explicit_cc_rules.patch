Load the C++ binary and protobuf rules explicitly and declare their providers
as direct module dependencies. Keep the pinned Bloaty sources unchanged.

diff --git a/BUILD.bazel b/BUILD.bazel
--- a/BUILD.bazel
+++ b/BUILD.bazel
@@ -1 +1,3 @@
+load("@protobuf//bazel:cc_proto_library.bzl", "cc_proto_library")
+load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
 load("@rules_proto//proto:defs.bzl", "proto_library")
diff --git a/MODULE.bazel b/MODULE.bazel
--- a/MODULE.bazel
+++ b/MODULE.bazel
@@ -3,3 +3,5 @@
+bazel_dep(name = "protobuf", version = "33.6")
+bazel_dep(name = "rules_cc", version = "0.0.17")
 bazel_dep(name = "rules_proto", version = "6.0.2")
 bazel_dep(name = "abseil-cpp", repo_name = "com_google_absl", version = "20240722.0")
 bazel_dep(name = "re2", version = "2024-07-02")
