diff --git a/npm/private/npm_package_extract.mjs b/npm/private/npm_package_extract.mjs
new file mode 100644
--- /dev/null
+++ b/npm/private/npm_package_extract.mjs
@@ -0,0 +1,26 @@
+import { spawnSync } from "node:child_process";
+import { chmodSync, lstatSync, readdirSync } from "node:fs";
+import { join, resolve } from "node:path";
+import { pathToFileURL } from "node:url";
+
+// Some npm archives give directories file-like modes (for example 0666).
+// Restore read/traverse access before the declared tree is uploaded, without
+// changing package bytes, executable bits or following archive symlinks.
+export function normalizePermissions(path) {
+  const stat = lstatSync(path);
+  if (stat.isSymbolicLink()) return;
+  if (stat.isDirectory()) {
+    chmodSync(path, (stat.mode & 0o777) | 0o555);
+    for (const entry of readdirSync(path)) normalizePermissions(join(path, entry));
+  } else if (stat.isFile()) {
+    chmodSync(path, (stat.mode & 0o777) | 0o444);
+  }
+}
+
+if (process.argv[1] && pathToFileURL(resolve(process.argv[1])).href === import.meta.url) {
+  const [tar, output, ...args] = process.argv.slice(2);
+  const result = spawnSync(tar, args, { stdio: "inherit" });
+  if (result.error) console.error(result.error.message);
+  if (result.status !== 0) process.exit(result.status ?? 1);
+  normalizePermissions(output);
+}
