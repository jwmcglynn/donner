"""Overlay BUILD file applied only to pinned Linux resvg-reference archives.

Each archive unzips to:

    include/webgpu/webgpu.h        -- standard WebGPU C header
    include/webgpu/wgpu.h          -- wgpu-native extensions
    lib/libwgpu_native.so          -- Linux dynamic library
    lib/libwgpu_native.a           -- static library (unused)
    wgpu-native-meta/webgpu.yml    -- API schema (unused at runtime)

The file is test-only and Linux-compatible. The resvg reference wrapper selects
the matching CPU archive; a missing shared library fails analysis.
"""

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "wgpu_native",
    testonly = True,
    srcs = ["lib/libwgpu_native.so"],
    hdrs = [
        "include/webgpu/webgpu.h",
        "include/webgpu/wgpu.h",
    ],
    includes = ["include"],
    target_compatible_with = ["@platforms//os:linux"],
    # wgpu-native's dynamic library already contains everything it needs (no
    # external deps), so no linkopts are required on the consumer side beyond
    # linking the library itself. Linux glibc + pthread + dl are the only
    # external dependencies; the linker picks them up through the default
    # shared-library linkage.
)
