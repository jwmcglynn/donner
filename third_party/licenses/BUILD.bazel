license(
    name = "vulkan_headers",
    package_name = "Vulkan-Headers",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
        "@rules_license//licenses/spdx:MIT",
    ],
    license_text = "vulkan-headers.LICENSE.txt",
    package_url = "https://github.com/KhronosGroup/Vulkan-Headers",
    package_version = "1.4.349",
)

# The native editor reaches exactly the Noto Sans font files in this vendored component.
# The release closure keys components by source location rather than the renderer's font wrapper.
license(
    name = "resvg-test-suite",
    package_name = "Noto Sans",
    license_kinds = ["@rules_license//licenses/spdx:OFL-1.1"],
    license_text = "noto-sans.LICENSE.txt",
    package_url = "https://github.com/notofonts/latin-greek-cyrillic",
    package_version = "2.000",
)

# Canonical per-variant license lists. These match the build-report
# variants in `tools/generate_build_report.py` so a Python script can
# correlate cquery results with the aggregated manifest.

DEFAULT_LICENSES = [
    ":sheenbidi",
    ":entt",
    ":public-sans",
    ":stb",
    ":tiny-skia-cpp",
    "@libpng//:license",
    "@zlib//:license",
]

TEXT_FULL_LICENSES = DEFAULT_LICENSES + [
    ":brotli",
    ":freetype",
    ":harfbuzz",
    ":woff2",
]

SKIA_TEXT_FULL_LICENSES = []  # Removed: full-Skia backend no longer exists.

ALL_KNOWN_LICENSES = [
    ":sheenbidi",
    ":entt",
    ":stb",
    ":tiny-skia-cpp",
    ":brotli",
    ":freetype",
    ":harfbuzz",
    ":woff2",
    ":imgui",
    ":glfw",
    ":tracy",
    ":emscripten-glfw",
    ":roboto",
    ":fira-code",
    ":public-sans",
    ":bootstrap-icons",
    ":google_fonts",
    ":generic_sans_faces",
    ":glad",
    ":vulkan_headers",
    "@libpng//:license",
    "@zlib//:license",
]

GEODE_EDITOR_LICENSES = [
    license
    for license in ALL_KNOWN_LICENSES
    if license != ":tiny-skia-cpp"
]

donner_notice_file(
    name = "notice_default",
    licenses = DEFAULT_LICENSES,
    variant = "Default (tiny-skia)",
)

filegroup(
    name = "notice_default_txt",
    srcs = [":notice_default"],
    output_group = "notice",
)

donner_notice_file(
    name = "notice_text_full",
    licenses = TEXT_FULL_LICENSES,
    variant = "tiny-skia + text-full",
)

donner_notice_file(
    name = "notice_skia_text_full",
    licenses = SKIA_TEXT_FULL_LICENSES,
    variant = "skia + text-full",
)

donner_notice_file_auto(
    name = "notice_editor",
    available_licenses = select({
        "//donner/editor/wasm:wasm_enabled": GEODE_EDITOR_LICENSES,
        "//conditions:default": ALL_KNOWN_LICENSES,
    }),
    target = select({
        "//donner/editor/wasm:wasm_enabled": "//donner/editor/wasm:notice_inputs",
        "//conditions:default": "//donner/editor:editor_notice_inputs",
    }),
    variant = "editor (auto-detected from current build)",
)

_EMPTY_LINK_HOOK = ("An empty C++ link hook (default malloc or extra link libraries); a build " +
                    "that fills it reaches the replacement, which is checked in its own right.")

_DONNER_TOOLCHAIN_SHIM = "Donner's own toolchain compatibility shim, under Donner's license."

# The NOTICE that ships beside each released `donner-cli` binary. It attributes exactly the
# third-party components in the configured closure of `//tools/ci:release_svg`, and BCR Preflight
# builds it (as `//tools/ci:release_svg_notice`) in the same invocation and configuration as the
# binary. `//tools:cli_notice_coverage_tests` fails when that closure reaches a component with
# neither a catalog entry above nor an exemption below.
donner_closure_notice_file(
    name = "notice_cli",
    available_licenses = ALL_KNOWN_LICENSES,
    # Each exemption is one label the closure was observed to reach; any other label of the same
    # component still needs a catalog entry.
    exempt_labels = {
        label: _EMPTY_LINK_HOOK
        for label in [
            "@bazel_tools//tools/cpp:empty_lib",
            "@bazel_tools//tools/cpp:link_extra_lib",
            "@bazel_tools//tools/cpp:malloc",
            "@rules_cc//:empty_lib",
            "@rules_cc//:link_extra_lib",
        ]
    } | {
        # Linked with --config=latest_llvm (and so --config=re): libc_compat on Linux and
        # libcxx_macos_compat on macOS.
        label: _DONNER_TOOLCHAIN_SHIM
        for label in [
            "//third_party/libc_compat:libc_compat",
            "//third_party/libc_compat:libc_compat.c",
            "//third_party/libc_compat:libcxx_macos_compat",
            "//third_party/libc_compat:libcxx_macos_compat.cc",
        ]
    },
    exempt_linkopts = {
        # Requested by libpng under --config=text-full.
        "-lm": "The platform C math library, dynamically linked from the system and not shipped.",
    },
    target = "//tools/ci:release_svg",
    variant = "donner-cli command-line tool (configured closure of //tools/ci:release_svg)",
)

filegroup(
    name = "notice_cli_txt",
    srcs = [":notice_cli"],
    output_group = "notice",
)

donner_closure_notice_file(
    name = "notice_release_editor",
    available_licenses = ALL_KNOWN_LICENSES + [":resvg-test-suite"],
    # Each exemption is one label the closure was observed to reach; any other label of the same
    # component still needs a catalog entry.
    exempt_labels = {
        label: _EMPTY_LINK_HOOK
        for label in [
            "@bazel_tools//tools/cpp:empty_lib",
            "@bazel_tools//tools/cpp:link_extra_lib",
            "@bazel_tools//tools/cpp:malloc",
            "@rules_cc//:empty_lib",
            "@rules_cc//:link_extra_lib",
        ]
    } | {
        # Linked with --config=latest_llvm (and so --config=re): libc_compat on Linux and
        # libcxx_macos_compat on macOS.
        label: _DONNER_TOOLCHAIN_SHIM
        for label in [
            "//third_party/libc_compat:libc_compat",
            "//third_party/libc_compat:libc_compat.c",
            "//third_party/libc_compat:libcxx_macos_compat",
            "//third_party/libc_compat:libcxx_macos_compat.cc",
        ]
    } | {
        "//third_party/licenses:notice_editor": "Generated attribution text; the original components are independently covered by this closure.",
    },
    exempt_linkopts = {
        # Requested by libpng under --config=text-full.
        "-lm": "The platform C math library, dynamically linked from the system and not shipped.",
        "-Wl,-rpath,@executable_path/../Frameworks": "A search path for the bundled libraries, not an additional linked component.",
        "CoreFoundation": "The operating system framework is dynamically linked and not redistributed.",
        "CoreText": "The operating system framework is dynamically linked and not redistributed.",
    },
    target = "//donner/editor:editor_binary",
    variant = "Donner native editor (configured editor binary closure)",
)

filegroup(
    name = "notice_release_editor_txt",
    srcs = [":notice_release_editor"],
    output_group = "notice",
)
