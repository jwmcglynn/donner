    package_name = "glad",
    license_kinds = [
        "@rules_license//licenses/spdx:MIT",
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
    license_text = "glad.LICENSE.txt",
    package_url = "https://github.com/Dav1dde/glad",
    package_version = "0.1.36",
