+// Per-decode allocator: no global operator new/delete replacement and no shared mutable state.
+class BrotliAllocationBudget {
+ public:
+  explicit BrotliAllocationBudget(size_t limit) : limit_(limit) {}
+  ~BrotliAllocationBudget() { assert(live_ == 0); }
+
+  static void* Allocate(void* opaque, size_t size) {
+    BrotliAllocationBudget* budget = static_cast<BrotliAllocationBudget*>(opaque);
+    if (size > std::numeric_limits<size_t>::max() - sizeof(Header)) return nullptr;
+    const size_t charge = sizeof(Header) + size;
+    if (charge > budget->limit_ - budget->live_) return nullptr;
+    Header* header = static_cast<Header*>(malloc(charge));
+    if (!header) return nullptr;
+    header->charge = charge;
+    budget->live_ += charge;
+    return header + 1;
+  }
+
+  static void Free(void* opaque, void* pointer) {
+    if (!pointer) return;
+    BrotliAllocationBudget* budget = static_cast<BrotliAllocationBudget*>(opaque);
+    Header* header = static_cast<Header*>(pointer) - 1;
+    assert(header->charge <= budget->live_);
+    budget->live_ -= header->charge;
+    free(header);
+  }
+
+ private:
+  // malloc's alignment is preserved after the header, including on Wasm and 32-bit platforms.
+  struct alignas(std::max_align_t) Header { size_t charge; };
+  size_t limit_;
+  size_t live_ = 0;
+};
