"""Tests for src/tiny_skia/filter modules."""

load("//:bazel/simd_test.bzl", "tiny_skia_dual_mode_cc_test")

package(default_visibility = ["//visibility:public"])

tiny_skia_dual_mode_cc_test(
    name = "tiny_skia_filter_tests",
    srcs = [
        "ColorSpaceTest.cpp",
        "FilterGraphColorSpaceTest.cpp",
        "FilterSimdParityTest.cpp",
        "SimdVecTest.cpp",
    ],
    # -ffp-contract=off matches the library so the reference expressions in the
    # tests are not folded into fused multiply-adds behind the assertions.
    copts = [
        "-std=c++20",
        "-ffp-contract=off",
    ],
    deps = [
        "//src/tiny_skia/filter",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)
