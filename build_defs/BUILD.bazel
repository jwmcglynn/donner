load("@bazel_skylib//rules:common_settings.bzl", "bool_flag", "string_flag")
load("@rules_python//python:defs.bzl", "py_test")
load("//build_defs:banned_deps.bzl", "banned_deps_test")
load("//build_defs:package.bzl", "donner_package")

exports_files(
    [
        "check_banned_patterns.py",
    ],
    visibility = ["//visibility:public"],
)

py_test(
    name = "check_banned_patterns_tests",
    size = "small",
    srcs = [
        "check_banned_patterns.py",
        "check_banned_patterns_tests.py",
    ],
)

py_test(
    name = "geode_test_scheduling_tests",
    size = "small",
    srcs = [
        "geode_test_scheduling_tests.py",
    ],
    data = [
        ":rules.bzl",
        "//:.bazelrc",
    ],
)

string_flag(
    name = "llvm_latest",
    build_setting_default = "0",
)

bool_flag(
    name = "disable_backend_test_transition",
    build_setting_default = False,
)

# When true, perf-sensitive libraries will NOT force their
# deps to opt mode.  Useful when the forced transition causes link conflicts
# (e.g. zlib appearing in both opt and fastbuild configurations).
# Set with --//build_defs:disable_perf_opt_transition=true
bool_flag(
    name = "disable_perf_opt_transition",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

bool_flag(
    name = "enable_tracy",
    build_setting_default = True,
    visibility = ["//visibility:public"],
)

# Length of the libFuzzer time budget on the generated `{fuzzer}_soak` tests.
#
# Off by default, which is what `bazel test //...` and the PR gate get: each
# fuzzer replays its whole checked-in corpus (the actual regression guard) plus
# a short mutation burst. Measured from a full CI run, the 88 fuzz-timer targets
# were 576 of the suite's 2297 test CPU-seconds - 25% of everything - and almost
# all of it was wall-clock the flag below now controls.
#
# The Fuzz workflow sets this to true so exploratory mutation gets a LONGER
# budget than the old fixed one, in a build that can actually find things (that
# lane runs `--config=asan-fuzzer`; the PR sweep does not, so its mutation time
# was searching without sanitizers). Set with
# `--//build_defs:fuzz_soak=true`, or `--config=fuzz-soak`.
bool_flag(
    name = "fuzz_soak",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

config_setting(
    name = "fuzz_soak_enabled",
    flag_values = {
        ":fuzz_soak": "True",
    },
    visibility = ["//visibility:public"],
)

banned_deps_test(
    name = "check_banned_deps_test",
    size = "small",
    allowed = [
        "//third_party:zlib",
        "//third_party:freetype",
    ],
    banned = [
        "@zlib",
        "@freetype",
    ],
    # genquery requires concrete labels, not target patterns. These top-level
    # targets cover the main dependency tree.
    scope = [
        "//:donner",
        "//donner/svg/tool:donner-svg",
        "//examples:svg_to_png",
        "//third_party:zlib",
        "//third_party:freetype",
    ],
)

config_setting(
    name = "fuzzers_enabled",
    flag_values = {
        ":llvm_latest": "1",
    },
)

config_setting(
    name = "llvm_latest_macos",
    constraint_values = [
        "@platforms//os:macos",
    ],
    flag_values = {
        ":llvm_latest": "1",
    },
)

config_setting(
    name = "llvm_latest_linux",
    constraint_values = [
        "@platforms//os:linux",
    ],
    flag_values = {
        ":llvm_latest": "1",
    },
)

donner_package(gpu_inventory_globs = [
    "**/*.bzl",
    "BUILD.bazel",
])
